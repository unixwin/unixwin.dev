---
/**
 * LangSwitch — 中 / EN 双按钮语言切换。
 *
 * Props:
 *   lang       'zh' | 'en'   当前页语言（高亮为 accent，渲染为非交互 span）
 *   otherPath  string        另一语言页路径；点击另一按钮时写入
 *                            sessionStorage.niu-lang-override 后跳转
 *
 * 事件用 document 委托（Astro 打包去重；同页多实例只跑一份）。
 */
interface Props {
  lang: 'zh' | 'en';
  otherPath: string;
}

const { lang, otherPath } = Astro.props;
---

<span class="lang-switch" role="group" aria-label="Language / 语言">
  {
    lang === 'zh' ? (
      <span class="ls-btn is-current" aria-current="true" title="中文">
        中
      </span>
    ) : (
      <button class="ls-btn" type="button" data-lang-go={otherPath} data-lang-set="zh" title="中文">
        中
      </button>
    )
  }
  {
    lang === 'en' ? (
      <span class="ls-btn is-current" aria-current="true" title="English">
        EN
      </span>
    ) : (
      <button class="ls-btn" type="button" data-lang-go={otherPath} data-lang-set="en" title="English">
        EN
      </button>
    )
  }
</span>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.1rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  .ls-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.9rem;
    padding: 0.12rem 0.35rem;
    border: none;
    border-radius: calc(var(--radius) - 3px);
    background: transparent;
    color: var(--muted);
    font-family: inherit;
    font-size: inherit;
    cursor: pointer;
  }

  button.ls-btn:hover {
    color: var(--text);
    background: var(--bg-elev);
  }

  button.ls-btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }

  /* 当前语言：accent 高亮 */
  .ls-btn.is-current {
    background: var(--accent);
    color: var(--bg);
    font-weight: 700;
    cursor: default;
  }
</style>

<script>
  // 委托点击：写 niu-lang-override（本会话不再自动跳转）后跳另一语言页
  document.addEventListener('click', (event) => {
    const el = event.target instanceof Element ? event.target.closest<HTMLElement>('[data-lang-go]') : null;
    if (!el) return;
    const href = el.getAttribute('data-lang-go');
    const lang = el.getAttribute('data-lang-set') ?? '';
    if (!href) return;
    try {
      sessionStorage.setItem('niu-lang-override', lang);
    } catch {
      /* sessionStorage 不可用则直接跳转 */
    }
    window.location.assign(href);
  });
</script>
