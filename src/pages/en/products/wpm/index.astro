<DocsLayout
  title="wpm — the package manager built into WinuxCmd"
  description="wpm: a C++ package manager built into winuxcmd.exe — zero runtime dependencies, 281-package index with sha256 integrity, flat/shim layouts and mirror sources."
  path="/en/products/wpm/"
  lang="en"
  enPath="/products/wpm/"
