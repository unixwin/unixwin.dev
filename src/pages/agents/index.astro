---
/**
 * /agents/ — AI Agent 接入目录（卡片式）。
 * 数据源：src/data/agents.json（事实来源 = niubash docs/src/agents.md）。
 * 分组：ready（终端系开箱可换）/ vscode（VSCode 家族，独立分组）/
 *       partial（有变通）/ blocked（上游暂不支持）/ unverified（尚未核验）；
 *       另有 roadmap 调研管道区（agents.json roadmap 数组，未核验候选）。
 * 图标全部本地化在 /assets/agents/（来源与许可见 THIRD_PARTY_NOTICES.md）。
 */
import BaseLayout from '../../components/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Badge from '../../components/Badge.astro';
import CopyButton from '../../components/CopyButton.astro';
import agentsData from '../../data/agents.json';

// hero 数字从数据派生，不写死：收录数 = agents 数组长度；开箱即用数 = status === 'ready'
const allAgents = agentsData.agents as any[];
const readyCount = allAgents.filter((a) => a.status === 'ready').length;

// 调研管道（roadmap 数组，agents.json _meta.roadmap 说明口径）：未核验候选，不计入收录数
const roadmap = (agentsData.roadmap ?? []) as any[];
const roadmapTop10 = roadmap.filter((r) => r.tier === 'top10');
const roadmapTierGroups = [
  { key: 'watch', title: '其它 CLI 与产品', desc: '终端系之外的候选产品' },
  { key: 'framework', title: '框架与引擎', desc: '接线点在用户代码，无单一核验面' },
  { key: 'ide', title: 'IDE 与编辑器扩展', desc: '命令多经宿主编辑器终端' },
  { key: 'cn', title: '国内产品', desc: '含独立 IDE 与编辑器插件' },
] as const;
const outlookLabel: Record<string, string> = {
  'ready-candidate': '可接',
  'needs-config': '待配置',
  'likely-blocked': '恐受阻',
  unverifiable: '难核验',
};
// 徽章色口径：ready-candidate=accent、needs-config=info、likely-blocked=muted、unverifiable=muted
const outlookTone = (o: string) => (o === 'ready-candidate' ? 'accent' : o === 'needs-config' ? 'info' : 'muted');

const groups = [
  { key: 'ready', title: '开箱可换（终端系）', tone: 'accent', desc: '当前版本按下面方法即可让 agent 用上 niubash' },
  { key: 'vscode', title: 'VSCode 家族', tone: 'info', desc: '同一份共享探针，九家各一条：VS Code 及其血统 fork / 扩展——修一处全家生效' },
  { key: 'partial', title: '有变通', tone: 'warn', desc: '部分场景可行，等待上游完善' },
  { key: 'blocked', title: '暂不支持', tone: 'muted', desc: '上游机制未开放，已跟进 issue' },
  { key: 'unverified', title: '尚未核验', tone: 'muted', desc: '无逐台实测或读码条目——按通用指南接线，欢迎回填实测' },
] as const;

const statusLabel: Record<string, string> = { ready: '可用', partial: '部分', blocked: '暂不可', unverified: '待核验' };
const statusTone = (s: string) => (s === 'ready' ? 'accent' : s === 'partial' ? 'warn' : 'muted');
---

<BaseLayout
  title="AI Agent 接入目录：Claude Code、Codex、Cursor、VSCode 家族、opencode、Zed × niubash"
  description="把 Claude Code、Codex、Cursor、VSCode 家族（Copilot、Windsurf、Trae、Cline、Roo Code、Kilo Code、Continue）、opencode、Zed、Goose 等 AI agent 的默认 shell 换成 niubash——Windows 原生的 bash 实现，一步脚本，附验证与回滚。"
  keywords="niubash,claude code shell,codex shell,cursor shell,vs code shell,opencode shell,zed shell,ai agent shell windows,bash for windows,git bash alternative"
  theme="day"
  path="/agents/"
>
  <SiteHeader />

  <main class="container">
    <section class="hero">
      <h1>把你的 AI Agent<br /><span class="hl">换到 niubash 上</span></h1>
      <p class="sub">
        前期主战场是 Windows：agent 每条命令都跑在真 bash 语法上，输出确定、git 快 3–7 倍。
        目录按终端系 / VSCode 家族 / 有变通 / 暂不支持 / 尚未核验分组；
        有换壳脚本的卡片点进去都有<strong>可复制的脚本</strong>、验证命令与回滚方法。
      </p>
      <div class="hero-cta">
        <a class="cta-main" href="/agents/universal/">让 AI 接入 niubash →</a>
        <p class="cta-note">
          已收录 <strong>{allAgents.length}</strong> 家 AI agent——<strong>{readyCount}</strong> 家开箱即用
          <span class="cta-extra"> · 另有 <a href="#roadmap">{roadmap.length} 家</a>在调研管道</span>
        </p>
      </div>
    </section>

    <section class="quick-cards" aria-label="快速直达">
      <a class="quick-card" href="#ready">
        <h2>① 我用 Claude Code / Codex / Cursor…</h2>
        <p>去目录挑你的 agent——开箱可换与 VSCode 家族都有换壳脚本、验证命令与回滚方法。</p>
        <span class="qc-go">去目录挑 →</span>
      </a>
      <a class="quick-card" href="/agents/universal/">
        <h2>② 我的 agent 不在列表</h2>
        <p>通用接线指南：四种探测机制 + 三步决策流，任何 agent 都能接上 niubash。</p>
        <span class="qc-go">看通用指南 →</span>
      </a>
      <a class="quick-card" href="/ai/">
        <h2>③ 让 agent 自己装</h2>
        <p>AI 门户：把一键安装提示词粘给你的 agent，它自己完成安装与接线。</p>
        <span class="qc-go">打开 AI 门户 →</span>
      </a>
    </section>

    {groups.map((g) => {
      const list = (agentsData.agents as any[]).filter((a) => a.group === g.key);
      if (!list.length) return null;
      return (
        <section class="group" id={g.key}>
          <div class="group-head">
            <h2>{g.title}</h2>
            <Badge tone={g.tone}>{list.length}</Badge>
            <span class="group-desc">{g.desc}</span>
          </div>
          <div class="card-grid">
            {list.map((a) => (
              <a class="agent-card" href={`/agents/${a.slug}/`}>
                <div class="card-top">
                  <span class="card-id">
                    <img class="card-icon" src={a.icon} alt="" width="20" height="20" loading="lazy" />
                    <span class="card-name">{a.name}</span>
                  </span>
                  <Badge tone={statusTone(a.status)}>
                    {statusLabel[a.status] ?? a.status}
                  </Badge>
                </div>
                <div class="card-variants">
                  {((a.variants as string[]) ?? []).map((v) => <span class="variant-chip">{v}</span>)}
                </div>
                <p class="card-line">{a.oneLiner}</p>
                <div class="card-foot">
                  <Badge tone="info">{a.mechanism}</Badge>
                  {a.script ? <span class="has-script">一键脚本 ✓</span> : <span class="no-script">说明</span>}
                  <span class="go">查看 →</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      );
    })}

    {/* 调研管道：未核验候选（roadmap 数组），置于「尚未核验」分组之后、原理区之前 */}
    {roadmap.length > 0 && (
      <section class="group roadmap" id="roadmap">
        <div class="group-head">
          <h2>调研中 · Research pipeline</h2>
          <Badge tone="warn">{roadmap.length}</Badge>
          <span class="group-desc">生态调研出的候选名单，尚未核验——核验一台、收录一台</span>
        </div>
        <p class="rm-scope">
          已收录 <strong>{allAgents.length}</strong> 家（<strong>{readyCount}</strong> 开箱即用）；另有{' '}
          <strong>{roadmap.length}</strong> 个候选在调研管道——优先接入 CLI/TUI 且执行本地 shell 的。
        </p>
        <div class="top10">
          <Badge tone="accent">Top 10 · 优先接入</Badge>
          <ul class="top10-list">
            {roadmapTop10.map((r) => (
              <li>
                <a href={r.source} target="_blank" rel="noopener noreferrer">{r.name}</a>
                {r.stars && <span class="rm-stars">{r.stars}★</span>}
              </li>
            ))}
          </ul>
        </div>
        {roadmapTierGroups.map((g) => {
          const list = roadmap.filter((r) => r.tier === g.key);
          if (!list.length) return null;
          return (
            <div class="rm-tier">
              <h3>
                {g.title} <Badge tone="muted">{list.length}</Badge>
                <span class="rm-tier-desc">{g.desc}</span>
              </h3>
              <div class="table-wrap">
                <table class="rm-table">
                  <thead>
                    <tr><th>名称</th><th>形态</th><th>厂商</th><th>展望</th><th>一句话</th></tr>
                  </thead>
                  <tbody>
                    {list.map((r) => (
                      <tr>
                        <td class="rm-name">
                          <a href={r.source} target="_blank" rel="noopener noreferrer">{r.name} ↗</a>
                          {r.stars && <span class="rm-stars">{r.stars}★</span>}
                        </td>
                        <td class="rm-form">{r.form}</td>
                        <td class="rm-vendor">{r.vendor}</td>
                        <td><Badge tone={outlookTone(r.outlook)}>{outlookLabel[r.outlook] ?? r.outlook}</Badge></td>
                        <td class="rm-note">{r.note}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          );
        })}
        <p class="rm-legend">
          展望口径：<strong>可接</strong>=机制明确（可配 shell / 取 $SHELL），待实测定级 ·
          <strong>待配置</strong>=大概率可配置，待读码/实测 ·
          <strong>恐受阻</strong>=机制性受阻（云端执行 / 沙箱 / 写死 shell）·
          <strong>难核验</strong>=闭源或无稳定可核验面；
          出处见各条外链，名单出自 {agentsData._meta.roadmap.surveyDate} 生态调研。
        </p>
      </section>
    )}

    <details class="principle">
      <summary>原理：它怎么选 shell（$SHELL 通则 + uname 签名表）</summary>
      <p class="principle-plain">{agentsData.universal.worksAlways}</p>
      <div class="verify">
        <span class="v-label">验证任何 agent 现在用的是哪个 shell：</span>
        <code>{agentsData.universal.verifyCmd}</code>
        <CopyButton copy={agentsData.universal.verifyCmd} label="复制" />
      </div>
      <p class="principle-plain">
        签名表用人话读：让 agent 跑上面的验证命令，拿输出逐行对照——看到
        <code>MSYS_NT</code> 就是已经在 niu 里（成功）；<code>MINGW64</code> 是掉进了 Git Bash；
        <code>Linux</code> 是掉进了 WSL；命令不存在、<code>$SHELL</code> 为空是还停在 PowerShell/cmd。
      </p>
      <table class="v-table">
        <tbody>
          {agentsData.universal.verifyTable.map((r) => (
            <tr>
              <td><code>{r.sign}</code></td>
              <td>
                {r.means}
                {r.sign.includes('MSYS_NT') && (
                  <span class="row-note">
                    MSYS_NT 是我们有意伪装的兼容人格（uname 报 MSYS 让老脚本以为在 MSYS 里），
                    并非真的 MSYS 运行时——niu 内部没有 MSYS。
                  </span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </details>

    <section class="unverified">
      <p>
        状态口径：<strong>可用</strong>=当前版本可配置生效 · <strong>部分</strong>=有变通/部分场景 ·
        <strong>暂不可</strong>=上游机制未开放 · <strong>待核验</strong>=无实测/读码条目；
        读码核实（非实测）的条目在详情页 notes 里写明来源。
      </p>
      <p class="src">
        本页事实来源：<a href="https://unixwin.github.io/niubash/agents.html" target="_blank" rel="noopener noreferrer">Coding agents on Windows, and the shell they run</a>（niubash 仓库 docs/src/agents.md）；
        图标来源与许可见仓库 <a href="https://github.com/unixwin/unixwin.dev#readme" target="_blank" rel="noopener noreferrer">THIRD_PARTY_NOTICES.md</a>
      </p>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hero { padding: 3rem 0 1.4rem; }
  .hero h1 { font-size: clamp(1.9rem, 5vw, 2.8rem); margin: 0; line-height: 1.25; }
  .hl { background: linear-gradient(90deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .sub { color: var(--muted); max-width: 46rem; margin: 0.8rem 0 0; line-height: 1.75; }
  .sub strong { color: var(--text); }

  /* hero 级 CTA：大按钮 + 实数副文案（数字由 agents.json 派生：收录数 / ready 数） */
  .hero-cta { display: flex; align-items: center; gap: 1.1rem; flex-wrap: wrap; margin: 1.3rem 0 0; }
  .cta-main {
    display: inline-flex; align-items: center; min-height: 48px;
    background: var(--btn-bg); color: var(--btn-fg); border: 1px solid var(--btn-bg);
    border-radius: var(--radius); padding: 0.7rem 1.5rem;
    font-family: var(--font-mono); font-size: 0.98rem; font-weight: 600; letter-spacing: 0.02em;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .cta-main:hover {
    background: var(--btn-hover); border-color: var(--btn-hover);
    transform: translateY(-1px); text-decoration: none;
  }
  .cta-note { margin: 0; color: var(--muted); font-size: 0.92rem; }
  .cta-note strong { color: var(--text); font-family: var(--font-mono); font-variant-numeric: tabular-nums; }

  /* 首屏三张直入卡：目录 / 通用指南 / AI 门户 */
  .quick-cards {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 1rem; margin: 1.9rem 0 0.4rem;
  }
  .quick-card {
    display: flex; flex-direction: column; gap: 0.45rem;
    background: var(--bg-elev); border: 1px solid var(--border); border-left: 3px solid var(--accent);
    border-radius: var(--radius); padding: 1.05rem 1.15rem; color: var(--text); text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .quick-card:hover { border-color: var(--accent); transform: translateY(-2px); text-decoration: none; }
  .quick-card h2 { margin: 0; font-size: 1.02rem; }
  .quick-card p { margin: 0; color: var(--muted); font-size: 0.88rem; line-height: 1.65; flex: 1; }
  .qc-go { color: var(--link); font-size: 0.85rem; }

  /* 通则与签名表：整体降权到页面底部，默认收起 */
  .principle {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    padding: 0.95rem 1.25rem;
    margin: 2.4rem 0 1rem;
  }
  .principle summary { cursor: pointer; color: var(--accent); font-weight: 700; }
  .principle[open] summary { margin-bottom: 0.7rem; }
  .principle-plain { margin: 0.55rem 0; color: var(--muted); line-height: 1.75; font-size: 0.9rem; }
  .principle-plain code, .verify code {
    background: var(--bg-code); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 0.05rem 0.35rem; font-size: 0.85rem;
  }
  .verify { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin: 0.8rem 0 0; }
  .verify code { padding: 0.3rem 0.7rem; font-size: 0.88rem; }
  .v-label { color: var(--muted); font-size: 0.88rem; }
  .v-table { width: 100%; border-collapse: collapse; margin-top: 0.8rem; font-size: 0.85rem; }
  .v-table td { border-top: 1px solid var(--border); padding: 0.35rem 0.5rem; color: var(--muted); }
  .v-table td:first-child { color: var(--text); white-space: nowrap; }
  .row-note { display: block; margin-top: 0.3rem; font-size: 0.8rem; color: var(--text); line-height: 1.65; }

  .group { margin: 2.2rem 0; }
  .group-head { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; margin-bottom: 1rem; }
  .group-head h2 { margin: 0; font-size: 1.25rem; }
  .group-desc { color: var(--muted); font-size: 0.88rem; }

  .card-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1rem; }
  .agent-card {
    display: flex; flex-direction: column; gap: 0.55rem;
    background: var(--bg-elev); border: 1px solid var(--border); border-radius: var(--radius);
    padding: 1.05rem 1.15rem; color: var(--text); text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .agent-card:hover { border-color: var(--accent); transform: translateY(-2px); text-decoration: none; }
  .card-top { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .card-id { display: flex; align-items: center; gap: 0.55rem; min-width: 0; }
  /* 图标 20px 圆角，垫白底——品牌深色 logo 在暗色主题下也保持可读 */
  .card-icon {
    flex: none;
    width: 20px; height: 20px; object-fit: contain;
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 2px;
  }
  .card-name { font-weight: 700; font-size: 1.02rem; }
  /* 产品形态徽章（IDE / CLI / Editor extension…），来自 agents.json 的 variants */
  .card-variants { display: flex; align-items: center; gap: 0.35rem; flex-wrap: wrap; }
  .variant-chip {
    font-size: 0.72rem; font-family: var(--font-mono);
    color: var(--muted); background: var(--bg-code);
    border: 1px solid var(--border); border-radius: 999px;
    padding: 0.05rem 0.5rem;
  }
  .card-line { margin: 0; color: var(--muted); font-size: 0.88rem; line-height: 1.6; flex: 1; }
  .card-foot { display: flex; align-items: center; gap: 0.55rem; flex-wrap: wrap; font-size: 0.8rem; }
  .has-script { color: var(--accent); font-weight: 600; }
  .no-script { color: var(--muted); }
  .go { margin-left: auto; color: var(--link); }

  .unverified { margin: 2.4rem 0 1rem; color: var(--muted); font-size: 0.88rem; }
  .unverified p { margin: 0.3rem 0; line-height: 1.7; }
  .unverified strong { color: var(--text); }
  .src a { color: var(--link); }

  /* 调研管道（roadmap）：Top10 横排 + 其余按 tier 紧凑表格 */
  .rm-scope { margin: 0 0 1rem; color: var(--muted); font-size: 0.92rem; line-height: 1.7; }
  .rm-scope strong { color: var(--text); font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .top10 {
    display: flex; align-items: center; gap: 0.7rem; flex-wrap: wrap;
    background: var(--bg-elev); border: 1px solid var(--border); border-left: 3px solid var(--accent);
    border-radius: var(--radius); padding: 0.75rem 1rem; margin: 0 0 1.3rem;
  }
  .top10-list { display: flex; align-items: center; gap: 0.35rem 1.1rem; flex-wrap: wrap; margin: 0; padding: 0; list-style: none; }
  .top10-list li { display: inline-flex; align-items: baseline; gap: 0.3rem; font-weight: 600; font-size: 0.92rem; }
  .top10-list a { color: var(--text); text-decoration: none; }
  .top10-list a:hover { color: var(--link); text-decoration: underline; }
  .rm-stars { color: var(--muted); font-family: var(--font-mono); font-size: 0.72rem; font-weight: 400; }
  .rm-tier { margin: 0 0 1.3rem; }
  .rm-tier h3 { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; margin: 0 0 0.55rem; font-size: 0.98rem; }
  .rm-tier-desc { color: var(--muted); font-size: 0.8rem; font-weight: 400; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--border); border-radius: var(--radius); }
  .rm-table { width: 100%; border-collapse: collapse; min-width: 680px; font-size: 0.85rem; }
  .rm-table th {
    text-align: left; font-size: 0.74rem; letter-spacing: 0.05em; color: var(--muted);
    background: var(--bg-elev); padding: 0.45rem 0.7rem; border-bottom: 1px solid var(--border);
    white-space: nowrap;
  }
  .rm-table td { border-top: 1px solid var(--border); padding: 0.45rem 0.7rem; vertical-align: top; color: var(--muted); line-height: 1.6; }
  .rm-table tbody tr:first-child td { border-top: 0; }
  .rm-name { white-space: nowrap; }
  .rm-name a { color: var(--text); font-weight: 600; text-decoration: none; }
  .rm-name a:hover { color: var(--link); text-decoration: underline; }
  .rm-name .rm-stars { margin-left: 0.3rem; }
  .rm-form, .rm-vendor { white-space: nowrap; font-family: var(--font-mono); font-size: 0.78rem; }
  .rm-note { min-width: 18rem; }
  .rm-legend { margin: 0.4rem 0 0; color: var(--muted); font-size: 0.82rem; line-height: 1.7; }
  .rm-legend strong { color: var(--text); }

  .cta-extra { color: var(--muted); font-size: 0.82rem; }
  .cta-extra a { color: var(--link); }
</style>
