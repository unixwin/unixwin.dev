---
/**
 * /benchmarks/ — 基准页。原则：有数据才写；每个数字带来源；混合收益单列。
 * 数据源：src/data/benchmarks.json（fork 专项 = 2026-10-18 复测）。
 */
import BaseLayout from '../../components/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import ThemeSwitcher from '../../components/ThemeSwitcher.astro';
import Badge from '../../components/Badge.astro';
import bench from '../../data/benchmarks.json';

const forkRows = bench.forkSuite.rows as any[];
const forkOnly = forkRows.filter((r) => r.tag === 'fork');
const inlineRows = forkRows.filter((r) => r.tag === 'inline');
const p = bench.forkSuite.provenance as any;

// 纯 CSS 横条：以 bash 耗时满格，按比例缩放
const barWidth = (ms: number, max: number) => `${Math.max(2, Math.round((ms / max) * 100))}%`;
const maxMs = Math.max(...forkRows.map((r) => r.bashMs));
---

<BaseLayout
  title="基准：niubash vs Git Bash / GNU bash"
  description="实测数据：git 启动 3–7x、prompt git 段 4–10x 快于 Git Bash；命令替换 / 子壳等 fork 类负载 13–62x 快于 GNU bash（2026-10-18 复测）。每个数字附来源与复测方法。"
  theme="terminal"
  path="/benchmarks/"
>
  <SiteHeader />

  <main class="container">
    <section class="hero">
      <h1>数字说话<span class="cursor">▊</span></h1>
      <div class="badges">
        <Badge tone="accent">git 启动 3–7x vs Git Bash</Badge>
        <Badge tone="accent">prompt git 段 4–10x（对方每条 3–5 次 fork）</Badge>
        <Badge tone="accent">命令替换 / 子壳 13–62x vs GNU bash</Badge>
        <Badge tone="info">冷启动 ~170ms · 单文件 3.79MB</Badge>
      </div>
      <p class="sub">每个数字都有来源（下方表格逐条标注），未实测的宣称不上这页。</p>
    </section>

    <section class="sec">
      <h2>启动与延迟（vs Git Bash / WSL）</h2>
      <div class="tbl-wrap">
        <table>
          <thead><tr><th>指标</th><th>niubash</th><th>对照</th><th>倍数</th><th>来源</th></tr></thead>
          <tbody>
            {(bench.latency as any[]).map((r) => (
              <tr>
                <td>{r.metric}</td>
                <td class="us">{r.us}</td>
                <td>{r.them}</td>
                <td>{r.badge ? <Badge tone="accent">{r.badge}</Badge> : '—'}</td>
                <td class="src">{r.source}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="sec">
      <h2>fork / 子壳专项 <span class="vs">rubash 引擎 vs GNU bash 5.3.20</span></h2>
      <p class="sec-desc">
        无 fork 三层执行模型（进程内 ShellState::clone 子壳）的直接收益——
        {p.date} 复测，rubash {p.rubash} / niu {p.niu}，基线 {p.baseline}，
        方法：{p.method}。
      </p>
      <div class="tbl-wrap">
        <table>
          <thead><tr><th>负载</th><th style="width:26%">GNU bash → rubash</th><th>bash</th><th>rubash</th><th>niu</th><th>倍数</th></tr></thead>
          <tbody>
            {forkOnly.map((r) => (
              <tr>
                <td>{r.workload}</td>
                <td>
                  <span class="bar bar-bash" style={`width:${barWidth(r.bashMs, maxMs)}`}></span>
                  <span class="bar bar-rub" style={`width:${barWidth(r.rubashMs, maxMs)}`}></span>
                </td>
                <td class="num">{r.bashMs.toLocaleString()} ms</td>
                <td class="num us">{r.rubashMs.toLocaleString()} ms</td>
                <td class="num">{r.niuMs.toLocaleString()} ms</td>
                <td><Badge tone={parseFloat(r.ratioVsBash) >= 10 ? 'accent' : 'muted'}>{r.ratioVsBash}</Badge></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <ul class="analysis">
        {(bench.forkSuite.analysis as string[]).filter((s, i) => i < 2 || s.includes('持平') || s.includes('real_ext')).map((a) => <li>{a}</li>)}
      </ul>
    </section>

    <section class="sec">
      <h2>含内联 coreutils 收益的负载 <span class="vs">单列，不计入 fork 战绩</span></h2>
      <p class="sec-desc">mkdir / touch / cat / sed / grep / wc 等常用命令在进程内执行、不产生子进程，下列倍数是「fork 节省 + 内联」的混合收益，诚实起见与上面的纯 fork 数字分开列。</p>
      <div class="tbl-wrap">
        <table>
          <thead><tr><th>负载</th><th>bash</th><th>rubash</th><th>niu</th><th>倍数</th></tr></thead>
          <tbody>
            {inlineRows.map((r) => (
              <tr>
                <td>{r.workload}</td>
                <td class="num">{r.bashMs.toLocaleString()} ms</td>
                <td class="num us">{r.rubashMs.toLocaleString()} ms</td>
                <td class="num">{r.niuMs.toLocaleString()} ms</td>
                <td><Badge tone="info">{r.ratioVsBash}</Badge></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="sec methodology">
      <h2>方法论与来源</h2>
      <ul>
        <li>fork 专项：{p.date} 复测，产物 <code>{p.artifacts}</code>（待入库本仓库 data/bench/）</li>
        <li>启动/延迟：niubash 仓库 README「Receipts」、CHANGELOG 实测票据、docs/src/why-niubash.md</li>
        <li>对照版本以各来源文档标注为准；数字随版本更新，本页由 <code>src/data/benchmarks.json</code> 驱动</li>
        <li>原则：未实测不写；输赢都展示（外部进程循环 ≈1.01x 持平即是真实 exec 成本）</li>
      </ul>
    </section>
  </main>

  <SiteFooter />
  <ThemeSwitcher current="terminal" />
</BaseLayout>

<style>
  .hero { padding: 3rem 0 1.2rem; }
  .hero h1 { font-size: clamp(2rem, 5.5vw, 3rem); margin: 0 0 1rem; }
  .badges { display: flex; gap: 0.55rem; flex-wrap: wrap; }
  .sub { color: var(--muted); margin: 0.9rem 0 0; }
  .cursor { color: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .sec { margin: 2.4rem 0; }
  .sec h2 { font-size: 1.2rem; margin: 0 0 0.5rem; }
  .vs { color: var(--muted); font-size: 0.85rem; font-weight: 400; margin-left: 0.5rem; }
  .sec-desc { color: var(--muted); font-size: 0.9rem; line-height: 1.7; margin: 0 0 0.9rem; }

  .tbl-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  th { text-align: left; color: var(--muted); font-weight: 600; border-bottom: 2px solid var(--border); padding: 0.5rem 0.6rem; white-space: nowrap; }
  td { border-bottom: 1px solid var(--border); padding: 0.55rem 0.6rem; vertical-align: middle; }
  td.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  td.us { color: var(--accent); font-weight: 600; }
  td.src { color: var(--muted); font-size: 0.8rem; max-width: 16rem; }

  .bar { display: block; height: 0.55rem; border-radius: 2px; margin: 2px 0; }
  .bar-bash { background: var(--muted); opacity: 0.55; }
  .bar-rub { background: var(--accent); }

  .analysis { margin: 1rem 0 0; padding-left: 1.2rem; color: var(--muted); line-height: 1.85; font-size: 0.9rem; }
  .methodology ul { padding-left: 1.2rem; color: var(--muted); line-height: 1.85; font-size: 0.9rem; }
  .methodology code { color: var(--accent-2); }
</style>
