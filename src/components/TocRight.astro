---
/**
 * TocRight — 文档区右栏 "On this page" 目录（Mintlify 风格）。
 *
 * - 条目由客户端从当前页 main 内的 h2/h3 生成（querySelectorAll('main h2, main h3')），
 *   h3 缩进一级；id 现场生成（CJK 安全 slug，冲突自增）。
 * - IntersectionObserver 跟踪滚动，当前节链接高亮（accent + 左条）。
 * - 点击平滑滚动（吸顶 SiteHeader 由 DocsLayout 的 scroll-margin-top 避开）；
 *   prefers-reduced-motion: reduce 时退化为瞬时滚动（'instant'，覆盖全局 smooth）。
 * - 无 JS / 无标题：整个 <nav> 保持 hidden，右栏呈现为空（docs 页 ≤1240px 本就隐藏右栏）。
 */
---

<nav class="toc" aria-label="本页目录" hidden data-toc>
  <p class="toc-title">On this page</p>
  <ul class="toc-list"></ul>
</nav>

<script>
  function initToc(): void {
    const nav = document.querySelector<HTMLElement>('[data-toc]');
    if (!nav) return;

    const headings = Array.from(
      document.querySelectorAll<HTMLElement>('main h2, main h3'),
    ).filter(
      // 可见、且不在导航卡片/页脚里的标题才算目录项（卡片首页的卡片标题、
      // 页尾「深入阅读」不进 TOC）；条目不足 2 个时整栏保持隐藏。
      (h) => h.offsetParent !== null && !h.closest('nav, footer, a'),
    );
    if (headings.length < 2) return;

    const list = nav.querySelector('ul');
    if (!list) return;

    const used = new Set<string>();
    const links: HTMLAnchorElement[] = [];

    headings.forEach((h, i) => {
      if (!h.id) {
        let slug =
          (h.textContent || '')
            .toLowerCase()
            .trim()
            .replace(/[^\p{L}\p{N}\s-]/gu, '')
            .replace(/\s+/g, '-')
            .slice(0, 48);
        if (!slug) slug = 'sec';
        while (used.has(slug)) slug = `${slug}-${i}`;
        used.add(slug);
        h.id = slug;
      }
      const li = document.createElement('li');
      li.className = h.tagName === 'H3' ? 'toc-item is-h3' : 'toc-item';
      const a = document.createElement('a');
      a.href = `#${h.id}`;
      a.textContent = h.textContent || `§${i}`;
      a.addEventListener('click', (ev) => {
        ev.preventDefault();
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        h.scrollIntoView({ behavior: reduce ? 'instant' : 'smooth', block: 'start' });
        history.pushState(null, '', `#${h.id}`);
        setActive(h.id);
      });
      li.appendChild(a);
      list.appendChild(li);
      links.push(a);
    });

    nav.hidden = false;

    function setActive(id: string | null): void {
      for (const a of links) {
        const on = a.getAttribute('href') === `#${id}`;
        a.classList.toggle('is-active', on);
        if (on) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      }
    }

    // 当前节 = 视口内位置最高的那个标题（顶部留出吸顶头高度）。
    function currentId(): string | null {
      let cur: HTMLElement | null = null;
      for (const h of headings) {
        if (h.getBoundingClientRect().top <= 96) cur = h;
        else break;
      }
      return cur ? cur.id : headings[0]?.id ?? null;
    }

    let ticking = false;
    function onScroll(): void {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        setActive(currentId());
        ticking = false;
      });
    }

    // IntersectionObserver 作为主触发器（标题进出观测带即重算），
    // scroll 兜底（观测带外的大段滚动）。
    const io = new IntersectionObserver(onScroll, {
      rootMargin: '0px 0px -66% 0px',
      threshold: 0,
    });
    headings.forEach((h) => io.observe(h));
    window.addEventListener('scroll', onScroll, { passive: true });
    setActive(currentId());
  }

  initToc();
</script>

<style is:global>
  /*
   * 条目由客户端 JS 创建（createElement），拿不到 Astro scoped 的
   * data-astro-cid 属性，因此本组件样式必须 is:global；所有选择器
   * 一律以 .toc 前缀收口，防全局泄漏。
   */
  .toc {
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 6.5rem);
    overflow-y: auto;
    padding: 0.25rem 0 2rem;
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .toc-title {
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 0.6rem;
    padding: 0 0.75rem;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    border-left: 1px solid var(--border);
  }

  .toc-item a {
    display: block;
    padding: 0.22rem 0.75rem;
    border-left: 2px solid transparent;
    margin-left: -1px; /* 压住 toc-list 左线，激活时替换 */
    color: var(--muted);
    text-decoration: none;
    line-height: 1.45;
    transition: color 0.15s;
  }

  .toc-item.is-h3 a {
    padding-left: 1.5rem;
    font-size: 0.78rem;
  }

  .toc-item a:hover {
    color: var(--text);
    text-decoration: none;
  }

  .toc-item a.is-active {
    color: var(--accent);
    border-left-color: var(--accent);
    font-weight: 600;
  }
</style>
