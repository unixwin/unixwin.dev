const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Niubash',
  applicationCategory: 'DeveloperTool',
  operatingSystem: 'Windows, Linux, macOS',
  description: "AI-native bash for humans and AI agents — real bash syntax, real Unix commands, native Windows/Linux/macOS",
