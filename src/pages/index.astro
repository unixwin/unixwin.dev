---
/**
 * 首页 — 主题候选 A（terminal）· 品牌正统旗舰。
 * 结构：Hero(终端窗口三段会话轮播：安装 / Agent 接管 / 速度 + 家族横幅)
 *       → StatsBand 六格 → 产品矩阵(产品卡 + 安装命令条 + 成熟度徽章)
 *       → Why 四卡 + 性能录屏 → Install 三 tab → Agent 一瞥 → 最新动态 → 主题候选。
 * 颜色全部走 tokens.css 变量；文案已全部实写，无占位符。
 */
import BaseLayout from '../components/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import StatsBand from '../components/StatsBand.astro';
import ProductCard from '../components/ProductCard.astro';
import Section from '../components/Section.astro';
import InstallTabs from '../components/InstallTabs.astro';
import Badge from '../components/Badge.astro';
import CopyButton from '../components/CopyButton.astro';
import products from '../data/products.json';
import facts from '../data/facts.json';
import repoMeta from '../data/repo-meta.json';
import changelogs from '../data/changelogs.json';

const ordered = [...products].sort((a, b) => a.order - b.order);

// ---- StatsBand 六格：全部来自 facts.json（byteIdentical 拆成 数字 + 文案） ----
const [identicalCount, ...identicalRest] = String(facts.byteIdentical).trim().split(/\s+/);
const stats = [
  { label: 'GNU bash 套件', value: facts.bashSuites },
  { label: identicalRest.join('') || '逐字节一致', value: identicalCount },
  { label: 'Unix 命令', value: facts.commands },
  { label: 'git 启动', value: facts.gitStartup },
  { label: '一次性执行 niu -c', value: facts.oneShot },
  { label: '单文件体积', value: facts.binarySize },
];

// ---- Install：PowerShell 主线 / wpm / 其他平台（Releases） ----
const installTabs = [
  { label: 'PowerShell', code: 'irm https://unixwin.dev/install.ps1 | iex' },
  { label: 'wpm', code: 'wpm install winuxcmd' },
  { label: 'Linux / macOS', code: 'https://github.com/unixwin/niubash/releases' },
];

// ---- 产品卡增强（oxc/bun 式）：每卡下方一行安装命令条 + 成熟度徽章。
// ProductCard 是共享组件不动它，页内包一层 .product-cell 实现。----
interface InstallBar {
  cmd: string;
  badge: string;
  tone: 'accent' | 'warn';
}
const installBars: Record<string, InstallBar> = {
  niubash: { cmd: 'irm https://unixwin.dev/install.ps1 | iex', badge: 'stable', tone: 'accent' },
  winuxcmd: { cmd: 'wpm install winuxcmd', badge: 'stable', tone: 'accent' },
  rubash: { cmd: 'cargo add rubash', badge: 'beta · 嵌入 API 1.5.0', tone: 'warn' },
  'niu-git': { cmd: 'wpm install niugit', badge: 'stable', tone: 'accent' },
  wpm: { cmd: 'wpm update', badge: 'stable', tone: 'accent' },
  'oh-my-niu': { cmd: 'niu plugin add oh-my-niu', badge: 'v2 beta', tone: 'warn' },
};

// ---- 最新动态：每仓最新一个已发布版本，取第一个非空分组的第一条，截断 60 字 ----
interface ChangelogVersion {
  version: string;
  date?: string;
  unreleased?: boolean;
  sections?: Record<string, string[]>;
}
interface ChangelogRepo {
  repo: string;
  versions?: ChangelogVersion[];
}

interface NewsItem {
  productName: string;
  version: string;
  date: string;
  summary: string;
}

const productByRepo = new Map(
  ordered.map((p) => [(p.repo.split('/').pop() ?? '').toLowerCase(), p]),
);

const newsItems: NewsItem[] = [];
for (const repo of (changelogs.repos ?? []) as ChangelogRepo[]) {
  const released = (repo.versions ?? []).find(
    (v) => !v.unreleased && typeof v.date === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v.date),
  );
  if (!released) continue;
  const firstGroup = Object.entries(released.sections ?? {}).find(
    ([name, lines]) => name.trim() !== '' && Array.isArray(lines) && lines.length > 0,
  );
  const raw = ((firstGroup?.[1] ?? [])[0] ?? '').replace(/\s+/g, ' ').trim();
  newsItems.push({
    productName: productByRepo.get(repo.repo.toLowerCase())?.name ?? repo.repo,
    version: released.version,
    date: released.date ?? '',
    summary: raw.length > 60 ? `${raw.slice(0, 60)}…` : (raw || '详见更新日志。'),
  });
}
newsItems.sort((a, b) => {
  if (a.date !== b.date) return a.date < b.date ? 1 : -1;
  return a.productName.localeCompare(b.productName);
});
const latestNews = newsItems.slice(0, 4);

// ---- SEO/GEO：SoftwareApplication JSON-LD，版本号取 repo-meta.json 的 niubash latest ----
const niubashLatest = repoMeta.repos?.niubash?.latest ?? undefined;
const softwareAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Niubash',
  operatingSystem: 'Windows, Linux, macOS',
  applicationCategory: 'DeveloperTool',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  ...(niubashLatest ? { softwareVersion: niubashLatest } : {}),
};
---

<BaseLayout
  title="UNIXWIN — Niubash、WinuxCmd、Rubash：AI-native 的真·Bash 家族"
  description="UNIXWIN：AI-native 的真·Bash 家族——niubash、WinuxCmd、rubash、niu-git、wpm。真 bash 语法、真 Unix 命令、原生 Windows / Linux / macOS，无 WSL、无 MSYS。83/83 GNU 套件全过、82 套逐字节一致、~14ms git 启动、3.79MB 单文件。"
  keywords="niubash,winuxcmd,rubash,niu-git,wpm,bash for windows,git bash alternative,ai-native bash"
  jsonLdExtra={softwareAppJsonLd}
  theme="day"
  path="/"
>
  <SiteHeader />

  <main class="container">
    <!-- ============ Hero：终端窗口 · 三段会话轮播（cli.github.com 式） ============ -->
    <section class="hero" aria-label="UNIXWIN 家族开场">
      <div class="terminal">
        <div class="term-bar" aria-hidden="true">
          <span class="tdot td-r"></span>
          <span class="tdot td-y"></span>
          <span class="tdot td-g"></span>
          <span class="term-title">cmx@unixwin: ~ — 80×24</span>
        </div>
        <div class="term-body">
          <div class="term-carousel" data-term-carousel role="region" aria-label="UNIXWIN 能力演示轮播：安装 · Agent 接管 · 速度">
            <div class="term-sessions">
              <div class="session">
                <p class="sl sl-cmt"># 安装 · session 1/3</p>
                <p class="sl"><span class="p-user">PS C:\&gt;</span> irm https://unixwin.dev/install.ps1 | iex</p>
                <p class="sl"><span class="spin" aria-hidden="true">⠿</span> 拉取 install.ps1 → 解析依赖清单 …</p>
                <p class="sl"><span class="ok">✓</span> niubash 1.4.0 → ~/.unixwin/bin/niu.exe</p>
                <p class="sl"><span class="ok">✓</span> winuxcmd · niu-git · wpm · oh-my-niu 同步就绪</p>
                <p class="sl"><span class="ok">✓</span> done — 重开终端，niu 即在 PATH（176+ Unix 命令）</p>
              </div>
              <div class="session">
                <p class="sl sl-cmt"># agent 接管 · session 2/3</p>
                <p class="sl"><span class="p-user">cmx@unixwin:~$</span> claude</p>
                <p class="sl"><span class="ok">✓</span> shell: niubash (rubash engine) — $SHELL 自动识别</p>
                <p class="sl"><span class="p-agent">agent&gt;</span> niu -c 'git log --oneline -1'</p>
                <p class="sl sl-out">f0c0ffe niubash 1.4.0 — 真语法，真命令，原生三平台</p>
                <p class="sl"><span class="p-agent">agent&gt;</span> <span class="cursor" aria-hidden="true">▊</span></p>
              </div>
              <div class="session">
                <p class="sl sl-cmt"># 速度 · session 3/3</p>
                <p class="sl"><span class="p-user">cmx@unixwin:~$</span> time git --version</p>
                <p class="sl sl-out">git version 2.47.0.nii</p>
                <p class="sl"><span class="ok">✓</span> real 0m0.014s ← niu-git</p>
                <p class="sl sl-out">user 0m0.006s · sys 0m0.002s</p>
                <p class="sl sl-cmt"># Git Bash 同机对照：real 0.045s – 0.103s（3–7× 慢）</p>
              </div>
            </div>
            <div class="term-dots">
              <button class="tdot-btn" type="button" aria-label="会话 1：安装"></button>
              <button class="tdot-btn" type="button" aria-label="会话 2：Agent 接管"></button>
              <button class="tdot-btn" type="button" aria-label="会话 3：速度"></button>
            </div>
          </div>

          <h1 class="hero-wordmark">UNIXWIN</h1>
          <p class="hero-tagline">
            AI-native 的真·Bash 家族——真语法、真 Unix 命令、原生 Windows / Linux / macOS，无 WSL、无 MSYS。
          </p>
          <p class="hero-tagline-en">
            AI-native bash family — real syntax, real Unix commands, native Windows / Linux / macOS. No WSL, no MSYS.
          </p>

          <div class="hero-cta">
            <a class="cta cta-primary" href="#install">安装</a>
            <a class="cta cta-ghost" href="https://github.com/unixwin" target="_blank" rel="noopener noreferrer">
              GitHub ↗
            </a>
          </div>

          <p class="t-cmd">
            <span class="t-user">cmx@unixwin:~$</span>
            <span class="cursor" aria-hidden="true">▊</span>
          </p>
        </div>
      </div>

      <figure class="banner-fig">
        <img
          src="/assets/niubash-banner.svg"
          alt="niubash 品牌横幅：Bash, native on Windows — no WSL, no VM, no emulation layer"
          width="1200"
          height="300"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </section>

    <!-- ============ Stats ============ -->
    <div id="facts">
      <StatsBand items={stats} />
    </div>

    <!-- ============ Products ============ -->
    <Section id="products" title="产品矩阵" kicker="six projects · one family">
      <div class="product-grid">
        {ordered.map((p) => {
          const bar = installBars[p.id];
          return (
            <div class="product-cell">
              <ProductCard product={p} stars={repoMeta.repos?.[p.id]?.stars} />
              {bar && (
                <div class="cell-install">
                  <Badge tone={bar.tone}>{bar.badge}</Badge>
                  <code class="cell-cmd" title={bar.cmd}>{bar.cmd}</code>
                  <CopyButton copy={bar.cmd} />
                </div>
              )}
            </div>
          );
        })}
      </div>
    </Section>

    <!-- ============ Why ============ -->
    <Section id="why" title="为什么是 UNIXWIN" kicker="why --real --fast --native">
      <div class="why-grid">
        <article class="why-card">
          <p class="why-num">01</p>
          <h3 class="why-title">真兼容</h3>
          <p class="why-body">
            GNU Bash 上游 <strong>83 套</strong>测试套件全部通过，其中 <strong>82 套</strong>输出与 bash
            逐字节一致——唯一残差经逐字节论证是 GNU 自己的竞态。存量脚本零修改。
          </p>
          <code class="why-chip">suites 83/83 · byte-identical 82</code>
        </article>
        <article class="why-card">
          <p class="why-num">02</p>
          <h3 class="why-title">零 fork</h3>
          <p class="why-body">
            <code>( )</code> 与 <code>$( )</code> <strong>零进程创建</strong>——子壳在进程内完成，fd
            继承、共享偏移、退出码、信号处置与 GNU 行为一致。全平台同一模型，无 POSIX 模拟层。
          </p>
          <code class="why-chip">( ) $( ) → 0 processes</code>
        </article>
        <article class="why-card">
          <p class="why-num">03</p>
          <h3 class="why-title">路径方言全收</h3>
          <p class="why-body">
            <code>C:\</code>、<code>D:/</code>、<code>/d/</code>、<code>/mnt/d</code>、<code>/cygdrive/d</code>——
            <strong>四大生态</strong>的路径写法一个 shell 全收且真折叠。换 shell，不用改脚本。
          </p>
          <code class="why-chip">C:\ · /d/ · /mnt/d · /cygdrive/d</code>
        </article>
        <article class="why-card">
          <p class="why-num">04</p>
          <h3 class="why-title">无 MSYS 咒语</h3>
          <p class="why-body">
            Git Bash 会在 spawn 前启发式改写你的参数，你得学会
            <code>MSYS_NO_PATHCONV</code>；niu 没有 MSYS 运行时——argv
            <strong>逐字节原样抵达</strong>，这个词不存在，因为它不需要存在。
          </p>
          <code class="why-chip">argv verbatim</code>
        </article>
        <article class="why-card">
          <p class="why-num">05</p>
          <h3 class="why-title">AI-native</h3>
          <p class="why-body">
            从 niu 会话启动 Claude Code、Codex、Cursor，agent 按 $SHELL 约定直接用上
            niubash；<code>niu -c</code>
            单条命令、确定性输出，专为 agent 的反复调用与解析而生。
          </p>
          <code class="why-chip">niu -c 'ls | grep src'</code>
        </article>
        <article class="why-card">
          <p class="why-num">06</p>
          <h3 class="why-title">快</h3>
          <p class="why-body">
            <code>git --version</code> 约 <strong>~14ms</strong>，Git Bash 要 45–103ms；提示符直接读
            <code>.git/HEAD</code>（≤29ms），对方每条提示符给 git 交 113–362ms 的税。
          </p>
          <code class="why-chip">git ~14ms · prompt ≤29ms</code>
        </article>
      </div>

      <figure class="demo-fig">
        <img
          src="/assets/demo-gitbash.gif"
          alt="实测录屏：git --version 启动速度对比，Git Bash 45–103 毫秒，niu-git 约 14 毫秒"
          width="692"
          height="334"
          loading="lazy"
          decoding="async"
        />
        <figcaption><code>git --version</code> 实测录屏：Git Bash 45–103ms → niu-git ~14ms。</figcaption>
      </figure>
    </Section>

    <!-- ============ Install ============ -->
    <Section id="install" title="快速安装" kicker="quick start · 一行命令">
      <InstallTabs id="install" tabs={installTabs} />
      <ul class="install-notes">
        <li>
          <strong>Linux / macOS</strong>：从 GitHub Releases 下载便携包，解压即用——
          <a href="https://github.com/unixwin/niubash/releases" target="_blank" rel="noopener noreferrer">
            github.com/unixwin/niubash/releases
          </a>。
        </li>
        <li>wpm 随 WinuxCmd 内置，装好后用 <code>wpm update</code> 升级全家桶。</li>
        <li>
          需要 <Badge tone="info">Windows 10+</Badge> · 文档见
          <a href="https://unixwin.github.io/niubash/" target="_blank" rel="noopener noreferrer">
            unixwin.github.io/niubash/
          </a>。
        </li>
      </ul>
    </Section>

    <!-- ============ Agent 一瞥 ============ -->
    <Section id="agent" title="Agent 一瞥" kicker="niu × claude code">
      <div class="codeblock agent-block" role="img" aria-label="niubash 与 Claude Code 的会话演示">
        <p class="al">
          <span class="p-user">$</span> claude <span class="c-mute"># 在 niu 会话里启动，$SHELL 已指向 niubash</span>
        </p>
        <p class="al">
          <span class="c-ok">✓</span> shell: niubash (rubash engine) — 14ms git, 176+ unix commands
        </p>
        <p class="al">
          <span class="p-agent">agent&gt;</span> niu -c 'ls | grep src'
        </p>
        <p class="al al-out">src</p>
        <p class="al">
          <span class="p-agent">agent&gt;</span> niu -c 'git log --oneline -1'
        </p>
        <p class="al al-out">f0c0ffe niubash 1.4.0 — 真语法，真命令，原生三平台</p>
        <p class="al">
          <span class="p-agent">agent&gt;</span> <span class="cursor" aria-hidden="true">▊</span>
        </p>
      </div>
      <p class="agent-note">
        agent 用上 niubash 后，每一条命令都跑在真 bash
        语法上——输出确定、启动够快，长会话也不掉链子。各家 agent
        的启动方式与配置细节见
        <a href="https://unixwin.github.io/niubash/agents.html" target="_blank" rel="noopener noreferrer">探测机制文档</a>。
      </p>
    </Section>

    <!-- ============ 最新动态 ============ -->
    <Section id="news" title="最新动态" kicker="tail -f changelogs.json">
      {latestNews.length > 0 ? (
        <ul class="news-list" role="list">
          {latestNews.map((n) => (
            <li class="news-item" role="listitem">
              <p class="news-line">
                <Badge tone="accent">{n.productName}</Badge>
                <span class="news-version">{n.version}</span>
                <time class="news-date" datetime={n.date}>{n.date}</time>
              </p>
              <p class="news-summary">{n.summary}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="news-empty">更新日志尚未拉取，请运行 <code>npm run fetch:github</code>。</p>
      )}
      <p class="news-more"><a href="/changelog/">查看完整更新日志 →</a></p>
    </Section>

    <!-- ============ Theme candidates ============ -->
    <Section id="themes" title="主题候选" kicker="a / b / c — pick one">
      <div class="theme-grid">
        <a class="theme-tile is-current" href="/">
          <span class="tile-key">A</span>
          <span class="tile-name">终端 · terminal</span>
          <span class="tile-desc">等宽字体、深空底色、终端绿。当前所在页。</span>
        </a>
        <a class="theme-tile" href="/theme/clean/">
          <span class="tile-key">B</span>
          <span class="tile-name">亮色 · clean</span>
          <span class="tile-desc">白底无衬线、12px 圆角、轻阴影。</span>
        </a>
        <a class="theme-tile" href="/theme/neon/">
          <span class="tile-key">C</span>
          <span class="tile-name">霓虹 · neon</span>
          <span class="tile-desc">紫青双色、玻璃卡渐变、16px 圆角。</span>
        </a>
      </div>
    </Section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  /* ---------- Hero：终端窗口 ---------- */
  .hero {
    position: relative;
    padding: 3.5rem 0 2rem;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: -4rem 0 0;
    background:
      radial-gradient(52rem 26rem at 18% 0%, color-mix(in srgb, var(--accent) 9%, var(--bg)), var(--bg) 70%),
      radial-gradient(40rem 22rem at 88% 12%, color-mix(in srgb, var(--accent-2) 7%, var(--bg)), var(--bg) 70%);
    z-index: -1;
    pointer-events: none;
  }

  .terminal {
    background: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-elev);
  }

  .tdot {
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 50%;
  }

  .td-r {
    background: var(--danger);
  }

  .td-y {
    background: var(--warn);
  }

  .td-g {
    background: var(--accent);
  }

  .term-title {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
  }

  .term-body {
    position: relative;
    padding: 1.3rem 1.5rem 1.5rem;
  }

  /* CRT 细扫描线（1px 线 / 3px 周期）：加强到可见但克制，两层 token 色混合，不引入新颜色 */
  .term-body::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      color-mix(in srgb, var(--bg) 60%, var(--bg-code)) 0 1px,
      var(--bg-code) 1px 3px
    );
    pointer-events: none;
  }

  .term-body > * {
    position: relative;
    z-index: 1;
  }

  .t-cmd {
    margin: 0 0 0.9rem;
    font-size: 0.95rem;
  }

  .term-body > .t-cmd:last-child {
    margin: 1.3rem 0 0;
  }

  .t-user {
    color: var(--accent);
    font-weight: 700;
  }

  .t-cmd .cursor {
    color: var(--accent);
  }

  /* ---------- Hero 三段会话轮播 ---------- */
  .term-carousel {
    margin: 0 0 1.4rem;
  }

  .term-sessions {
    display: grid;
  }

  /* 无 JS 时的默认形态：三段会话纵向静态排列，全部文本可读（SEO 完整） */
  .session:not(:last-child) {
    margin-bottom: 1.15rem;
  }

  .sl {
    margin: 0 0 0.28rem;
    font-size: 0.92rem;
    white-space: pre-wrap;
    word-break: break-word;
    font-variant-numeric: tabular-nums;
  }

  .sl:last-child {
    margin-bottom: 0;
  }

  .sl-cmt {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .sl-out {
    color: var(--muted);
  }

  .spin {
    color: var(--accent-2);
    animation: blink 1.1s steps(1) infinite;
  }

  .ok {
    color: var(--accent);
    font-weight: 700;
    white-space: nowrap;
  }

  /* JS 就绪后由脚本加 .is-live：三段会话同格叠放（高度取最高者，无跳动），
     淡入淡出轮播 + 逐行打印式进场 */
  .term-carousel.is-live .session {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    visibility: hidden;
