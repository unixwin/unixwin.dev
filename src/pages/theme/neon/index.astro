---
/**
 * 主题候选 C（neon）首页 — /theme/neon/
 * 深紫霓虹 × 玻璃拟态：紫/青双色渐变、发光 hover、径向光斑。
 * 颜色全部出自 tokens 变量（唯 color-mix(var + transparent) 派生）；未覆盖任何 token。
 * 动效仅 CSS：hover 0.2s 上浮、光晕、≤8s 渐变位移；prefers-reduced-motion 时全部关闭。
 */
import BaseLayout from '../../../components/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import ThemeSwitcher from '../../../components/ThemeSwitcher.astro';
import StatsBand from '../../../components/StatsBand.astro';
import ProductCard from '../../../components/ProductCard.astro';
import Section from '../../../components/Section.astro';
import InstallTabs from '../../../components/InstallTabs.astro';
import Badge from '../../../components/Badge.astro';
import products from '../../../data/products.json';
import facts from '../../../data/facts.json';
import repoMeta from '../../../data/repo-meta.json';

const ordered = [...products].sort((a, b) => a.order - b.order);

// Hero 统计条四格：值取自 facts.json；byteIdentical("82 套逐字节一致") 拆成 值+标签 展示
const heroStats = [
  { label: 'bash 测试套件', value: facts.bashSuites },
  { label: '逐字节一致', value: '82 套' },
  { label: 'Unix 命令', value: facts.commands },
  { label: 'git 启动', value: facts.gitStartup },
];

// 三块卖点（数字均出自 facts.json：bashSuites/byteIdentical/shellColdStart/binarySize）
const features = [
  {
    index: '01',
    title: '字节级兼容',
    desc: `${facts.bashSuites} 套件跑通，${facts.byteIdentical}。旧脚本原样搬迁，零重写。`,
  },
  {
    index: '02',
    title: '为 agent 而生',
    desc: `${facts.oneShot} 一次性执行——从 niu 会话启动的 agent 经 $SHELL 直接用上 niubash。`,
  },
  {
    index: '03',
    title: `${facts.binarySize} 一个文件`,
    desc: '2,420 个单元测试护航。无依赖、无安装，复制即跑。',
  },
];

const installTabs = [
  { label: 'PowerShell', code: 'irm https://dl.caomengxuan666.com/install.ps1 | iex' },
  { label: 'wpm', code: 'wpm install winuxcmd' },
];

const releasesUrl = 'https://github.com/unixwin/niubash/releases';
const orgUrl = 'https://github.com/unixwin';
---

<BaseLayout
  title="UNIXWIN · 霓虹 neon（主题候选 C）"
  description="UNIXWIN 主题候选 C（neon）：深紫霓虹 × 玻璃拟态。AI-native 真·Bash 家族——真语法、真命令、原生三平台、无 WSL 无 MSYS。"
  theme="neon"
  path="/theme/neon/"
>
  <SiteHeader />

  <main class="container">
    <!-- 1 · Hero：光斑 + 居中 + 渐变字标 + 双 CTA + 玻璃统计条 -->
    <section class="hero" aria-label="UNIXWIN 简介">
      <div class="orb orb-a" aria-hidden="true"></div>
      <div class="orb orb-b" aria-hidden="true"></div>
      <div class="hero-core">
        <p class="hero-kicker"><Badge tone="info">AI-NATIVE · TRUE BASH</Badge></p>
        <h1 class="hero-wordmark">UNIXWIN</h1>
        <p class="hero-sub">AI-native 真·Bash 家族</p>
        <p class="hero-line">真语法 · 真命令 · 原生三平台 · 无 WSL 无 MSYS</p>
        <div class="hero-cta">
          <a class="cta cta-primary" href="#install">立即安装</a>
          <a class="cta cta-ghost" href={orgUrl} target="_blank" rel="noopener noreferrer">GitHub →</a>
        </div>
        <div class="hero-stats">
          <StatsBand items={heroStats} />
        </div>
      </div>
    </section>

    <!-- 2 · 产品六卡（3×2 玻璃卡，--card-accent 数据注入，hover 上浮+光晕） -->
    <Section id="products" title="产品矩阵" kicker="six binaries · one family">
      <div class="product-grid">
        {ordered.map((p) => (
          <ProductCard product={p} stars={repoMeta.repos?.[p.id]?.stars} />
        ))}
      </div>
    </Section>

    <!-- 3 · 三块卖点（玻璃长条卡横排） -->
    <Section id="why" title="为什么是 UNIXWIN" kicker="bytes · speed · size">
      <div class="feat-grid">
        {features.map((f) => (
          <article class="feat glass-card">
            <span class="feat-index" aria-hidden="true">{f.index}</span>
            <h3 class="feat-title">{f.title}</h3>
            <p class="feat-desc">{f.desc}</p>
          </article>
        ))}
      </div>
    </Section>

    <!-- 4 · 安装：玻璃容器 + InstallTabs（代码底 var(--bg-code)，命令渐变文字） -->
    <Section id="install" title="一行，装好。" kicker="quick start">
      <div class="install-shell glass-card">
        <InstallTabs id="install" tabs={installTabs} />
        <p class="install-note">
          需要 <Badge tone="info">Windows 10+</Badge> · 偏好手动？<a
            href={releasesUrl}
            target="_blank"
            rel="noopener noreferrer">Releases →</a>
        </p>
      </div>
    </Section>

    <!-- 5 · Agent 演示：neon 终端窗口卡 -->
    <Section id="agent" title="把 shell 交给 AI" kicker="live session">
      <div class="terminal">
        <div class="term-bar">
          <span class="dot dot-danger" aria-hidden="true"></span>
          <span class="dot dot-warn" aria-hidden="true"></span>
          <span class="dot dot-accent" aria-hidden="true"></span>
          <span class="term-title">agent — niubash</span>
        </div>
        <pre class="term-body"><code><span class="t-p">$</span> claude
<span class="t-ok">✓</span> <span class="t-m">shell → niubash · native · no WSL · no MSYS</span>
<span class="t-a">agent&gt;</span> niu -c 'for f in *.log; do gzip -k "$f"; done'
<span class="t-ok">✓</span> 12 files compressed <span class="t-m">· exit 0 · 96 ms</span>
<span class="t-a">agent&gt;</span> git status --short | wc -l
<span class="t-o">3</span> <span class="t-cursor">▊</span></code></pre>
      </div>
      <p class="term-caption">不是模拟，不是转译——AI 写下的每一行都是真 bash。</p>
    </Section>

    <!-- 6 · 底部 CTA：渐变大字 + GitHub -->
    <section class="finale" aria-label="行动号召">
      <div class="orb orb-c" aria-hidden="true"></div>
      <div class="finale-core">
        <p class="finale-line">Join the shell revolution.</p>
        <a class="cta cta-ghost" href={orgUrl} target="_blank" rel="noopener noreferrer">GitHub →</a>
      </div>
    </section>
  </main>

  <SiteFooter />
  <ThemeSwitcher current="neon" />
</BaseLayout>

<style>
  /* ---------- 通用：玻璃卡 / 发光按钮 ---------- */
  .glass-card {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    border-radius: var(--radius);
    padding: 0.7rem 1.7rem;
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    transition:
      transform 0.2s ease,
      box-shadow 0.2s ease,
      border-color 0.2s ease;
  }

  .cta:hover {
    text-decoration: none;
  }

  .cta-primary {
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    border: 1px solid transparent;
    color: var(--bg);
    box-shadow: 0 0 22px color-mix(in srgb, var(--accent) 32%, transparent);
  }

  .cta-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 38px color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .cta-ghost {
    background: var(--glass-bg);
    backdrop-filter: blur(var(--glass-blur));
    border: 1px solid var(--border);
    color: var(--text);
  }

  .cta-ghost:hover {
    transform: translateY(-2px);
    border-color: var(--accent-2);
    box-shadow: 0 0 26px color-mix(in srgb, var(--accent-2) 35%, transparent);
  }

  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    padding: 4.5rem 0 3.2rem;
  }

  .hero-core {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.55rem;
  }

  .hero-kicker {
    margin: 0;
  }

  .hero-wordmark {
    margin: 0.4rem 0 0;
    font-size: clamp(3rem, 9vw, 5.4rem);
    font-weight: 800;
    letter-spacing: 0.1em;
    line-height: 1.05;
    background: linear-gradient(100deg, var(--accent), var(--accent-2) 40%, var(--accent) 80%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: gradient-slide 8s ease-in-out infinite;
  }

  .hero-sub {
    margin: 0;
    font-size: clamp(1.15rem, 2.6vw, 1.5rem);
    font-weight: 600;
  }

  .hero-line {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
  }

  .hero-cta {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.5rem;
    flex-wrap: wrap;
  }

  .hero-stats {
    width: 100%;
    margin-top: 2.2rem;
  }

  /* 统计条 neon 化：渐变数字 + 微光描边 */
  .hero-stats :global(.stats-band) {
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
  }

  .hero-stats :global(.stat-value) {
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* ---------- 背景光斑（仅 accent / accent-2 + transparent） ---------- */
  .orb {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .orb-a {
    width: 36rem;
    height: 36rem;
    top: -14rem;
    left: -12rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent) 20%, transparent), transparent 68%);
    animation: orb-drift 8s ease-in-out infinite alternate;
  }

  .orb-b {
    width: 30rem;
    height: 30rem;
    top: 2rem;
    right: -11rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--accent-2) 16%, transparent), transparent 68%);
    animation: orb-drift 8s ease-in-out infinite alternate-reverse;
  }

  .orb-c {
    width: 32rem;
    height: 32rem;
    bottom: -16rem;
    left: calc(50% - 16rem);
    background: radial-gradient(circle, color-mix(in srgb, var(--accent-2) 14%, transparent), transparent 70%);
    animation: orb-drift 8s ease-in-out infinite alternate;
  }

  @keyframes orb-drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(2rem, 1.4rem, 0);
    }
  }

  @keyframes gradient-slide {
    0%,
    100% {
      background-position: 0% 50%;
    }
    50% {
      background-position: 100% 50%;
    }
  }

  /* ---------- 产品 3×2 玻璃卡（hover 上浮 + 双层光晕） ---------- */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
  }

  .product-grid :global(.product-card) {
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .product-grid :global(.product-card:hover) {
    transform: translateY(-6px);
    border-color: var(--card-accent, var(--accent));
    box-shadow:
      0 18px 44px color-mix(in srgb, var(--card-accent, var(--accent)) 24%, transparent),
      0 0 0 1px color-mix(in srgb, var(--card-accent, var(--accent)) 45%, transparent);
  }

  /* ---------- 三块卖点 ---------- */
  .feat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.1rem;
    align-items: stretch;
  }

  .feat {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.5rem 1.5rem 1.3rem;
    box-shadow: var(--shadow);
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .feat:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    box-shadow: 0 16px 40px color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .feat-index {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .feat-title {
    margin: 0;
    font-size: 1.25rem;
  }

  .feat-desc {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  /* ---------- 安装 ---------- */
  .install-shell {
    padding: 1.6rem 1.6rem 1.3rem;
    box-shadow: var(--shadow);
  }

  .install-shell :global(.tab-btn[aria-selected='true']) {
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    border-color: transparent;
    color: var(--bg);
    box-shadow: 0 0 18px color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .install-shell :global(.codeblock) {
    background: var(--bg-code);
    border-color: color-mix(in srgb, var(--accent) 22%, transparent);
    box-shadow: inset 0 0 28px color-mix(in srgb, var(--accent) 6%, transparent);
  }

  .install-shell :global(.codeblock code) {
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    font-weight: 600;
  }

  .install-note {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.88rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
    flex-wrap: wrap;
  }

  /* ---------- Agent 终端窗口 ---------- */
  .terminal {
    max-width: 780px;
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    border-radius: var(--radius);
    background: color-mix(in srgb, var(--bg-code) 88%, transparent);
    backdrop-filter: blur(var(--glass-blur));
    box-shadow:
      var(--shadow),
      0 0 44px color-mix(in srgb, var(--accent) 12%, transparent);
    overflow: hidden;
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.1rem;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg-elev) 55%, transparent);
  }

  .dot {
    width: 0.78rem;
    height: 0.78rem;
    border-radius: 50%;
  }

  .dot-danger {
    background: var(--danger);
    box-shadow: 0 0 10px color-mix(in srgb, var(--danger) 60%, transparent);
  }

  .dot-warn {
    background: var(--warn);
    box-shadow: 0 0 10px color-mix(in srgb, var(--warn) 60%, transparent);
  }

  .dot-accent {
    background: var(--accent);
    box-shadow: 0 0 10px color-mix(in srgb, var(--accent) 60%, transparent);
  }

  .term-title {
    margin-left: auto;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
  }

  .term-body {
    padding: 1.15rem 1.3rem 1.3rem;
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--text);
  }

  .t-p {
    color: var(--accent-2);
    font-weight: 700;
  }

  .t-a {
    color: var(--accent);
    font-weight: 700;
  }

  .t-ok {
    color: var(--accent);
  }

  .t-m {
    color: var(--muted);
  }

  .t-o {
    color: var(--text);
    font-weight: 700;
  }

  .t-cursor {
    color: var(--accent-2);
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .term-caption {
    margin: 1rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  /* ---------- 底部 CTA ---------- */
  .finale {
    position: relative;
    overflow: hidden;
    padding: 4.5rem 0 5.5rem;
  }

  .finale-core {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.6rem;
    text-align: center;
  }

  .finale-line {
    margin: 0;
    font-size: clamp(1.9rem, 5vw, 3.2rem);
    font-weight: 800;
    letter-spacing: 0.02em;
    background: linear-gradient(100deg, var(--accent-2), var(--accent) 45%, var(--accent-2) 90%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: gradient-slide 8s ease-in-out infinite;
  }

  /* ---------- 响应式 ---------- */
  @media (max-width: 940px) {
    .product-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .feat-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .product-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------- 动效关闭（prefers-reduced-motion） ---------- */
  @media (prefers-reduced-motion: reduce) {
    .hero-wordmark,
    .finale-line,
    .orb,
    .t-cursor {
      animation: none;
    }

    .cta,
    .cta-primary,
    .cta-ghost,
    .feat,
    .product-grid :global(.product-card) {
      transition: none;
    }

    .cta-primary:hover,
    .cta-ghost:hover,
    .feat:hover,
    .product-grid :global(.product-card:hover) {
      transform: none;
    }
  }
</style>
