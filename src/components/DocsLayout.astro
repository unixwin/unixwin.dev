---
/**
 * DocsLayout — 文档区布局（门户第一个带侧栏的区域）。
 *
 * 结构：BaseLayout 外壳（theme 固定 'day'，顶栏 ToggleTheme 可切 night）+ SiteHeader/SiteFooter +
 *       三栏 grid：左 Sidebar（240px sticky）/ 中 内容（max-w-prose）/ 右 暂无（占位，窄屏隐藏）。
 *
 * Props（透传给 BaseLayout）：
 *   title       string  页面 <title>（自动拼 " · UNIXWIN"）
 *   description string  页面 meta description
 *   path        string  规范化路径（如 '/docs/compatibility/'）
 *   lang        'zh' | 'en'  页面语言（可选，默认 zh，透传 BaseLayout）
 *   enPath      string  另一语言页路径（可选，透传 BaseLayout，供 hreflang 互链）
 */
import BaseLayout from './BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import Sidebar from './Sidebar.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  lang?: 'zh' | 'en';
  enPath?: string;
}

const { title, description, path, lang, enPath } = Astro.props;
---

<BaseLayout title={title} description={description} theme="day" path={path} lang={lang} enPath={enPath}>
  <SiteHeader />

  <div class="container docs-grid">
    <Sidebar />
    <main class="docs-main">
      <slot />
    </main>
    <!-- 暂无右栏：保留三栏骨架，内容后续可挂 TOC / on-this-page -->
    <div class="docs-right" aria-hidden="true"></div>
  </div>

  <SiteFooter />
</BaseLayout>

<style>
  .docs-grid {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr) 240px;
    gap: 2rem;
    align-items: start;
    min-height: 60vh;
  }

  .docs-main {
    max-width: 66ch; /* max-w-prose 口径 */
    width: 100%;
    padding: 2.5rem 0 4rem;
  }

  .docs-right {
    position: sticky;
    top: 4.5rem;
    min-height: 1px;
  }

  @media (max-width: 1240px) {
    .docs-grid {
      grid-template-columns: 240px minmax(0, 1fr);
    }

    .docs-right {
      display: none;
    }
  }

  @media (max-width: 960px) {
    .docs-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }

    .docs-main {
      padding-top: 1.5rem;
    }
  }
</style>
