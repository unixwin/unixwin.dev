import repoMeta from '../../../../data/repo-meta.json';

const meta = repoMeta.repos['oh-my-niu'];
const stars = typeof meta?.stars === 'number' ? meta.stars : null;
const latest = typeof meta?.latest === 'string' ? meta.latest : '';

const rcBootstrap = [
  '# Three lines in ~/.niubashrc: pick plugins, pick a theme, source the framework',
  "NIU_PLUGINS=(prompt-core git docker zoxide)",
  "NIU_THEME=minimal",
  'source "$NIUBASH/oh-my-niu.niu"',
].join('\n');
// Day-to-day surface as measured on niubash 1.4.4 (`niu plugin themes/doctor`
// are retired — niubash#145; theme selection IS NIU_THEME, diagnostics are the
// top-level `niu doctor`, the bundled baseline moves with `niu self-update`)
const pluginOps = [
  '# Switch themes: edit NIU_THEME, reopen the terminal, or hot-reload the session',
  'source "$NIUBASH/oh-my-niu.niu" --reload',
  '# The bundled baseline follows niubash releases',
  'niu self-update',
  '# Top-level health check (rc blocks, PATH consistency, ...)',
  'niu doctor',
].join('\n');
const mooCmd = 'niu_moo "Bash, native on Windows."   # a cowsay-style speech bubble';

const themeGroups = [
  { group: 'Oh My Zsh classics', items: 'agnoster · avit · bira · clean · fishy · lambda · robbyrussell' },
  { group: 'Powerlevel-style', items: 'p10-lean · p10-classic · p10-rainbow · p10-pure' },
  { group: 'Oh My Posh-style', items: 'dracula · catppuccin-mocha · gruvbox · spaceship · tokyonight' },
  { group: 'Official basics', items: 'default · dark · light · colorful · minimal · classic · pure · compact · cyberpunk · forest · ocean' },
];

const catalogRows = [
  { id: 'oh-my-bash', origin: 'github.com/ohmybash/oh-my-bash', note: 'bash framework: 80+ themes, plugins and aliases (MIT)' },
  { id: 'bash-it', origin: 'github.com/Bash-it/bash-it', note: 'community aliases, plugins, completions and themes (MIT)' },
  { id: 'bash-completion', origin: 'github.com/scop/bash-completion', note: 'the standard bash completion library (GPL-2.0+, fetched on demand)' },
];

const factRows = [
  { metric: 'Themes', value: '27 (27 theme-* plugin directories and 27 themes/*.toml assets, name-for-name identical)', src: 'in-repo plugins/ and themes/ counts, measured 2026-10-19' },
  { metric: 'Plugin directories', value: '50 (27 themes + 23 feature plugins)', src: 'in-repo plugins/ count, measured 2026-10-19' },
  { metric: 'Completion definitions', value: '174 TOML files', src: 'in-repo completions/ count, measured 2026-10-19' },
  { metric: 'Index pack entries', value: '22 (bundle 2.0.0, min_niubash 1.0.0)', src: 'oh-my-niu/index.toml' },
  { metric: 'Alias packs / env packages', value: '5 TOML packs · 2 official envs (git / cicd)', src: 'in-repo aliases/ · envs/ counts' },
];

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Oh My Niu',
  applicationCategory: 'DeveloperTool',
  operatingSystem: 'Windows, Linux, macOS',
  description: "Oh-My-style plugin framework for niubash: themes, plugins, completions",
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'UNIXWIN', url: 'https://unixwin.dev' },
