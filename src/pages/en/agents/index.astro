---
/**
 * /en/agents/ — English edition of the AI agent directory (card grid).
 * Data source: the same src/data/agents.json as the zh page
 * (source of truth = niubash docs/src/agents.md).
 * Grouping: ready (terminal) / vscode family / partial / blocked / unverified,
 * plus a research-pipeline section (agents.json roadmap array, unverified candidates).
 * oneLiners, mechanism labels and the universal block are hand-translated here;
 * statuses and counts come from data. Detail pages remain Chinese (noted below).
 * Icons are localized under /assets/agents/ (see THIRD_PARTY_NOTICES.md).
 */
import BaseLayout from '../../../components/BaseLayout.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import Badge from '../../../components/Badge.astro';
import CopyButton from '../../../components/CopyButton.astro';
import agentsData from '../../../data/agents.json';

// Hero numbers are derived from the data, never hardcoded: covered = array length; ready = status === 'ready'
const allAgents = agentsData.agents as any[];
const readyCount = allAgents.filter((a) => a.status === 'ready').length;

// Research pipeline (roadmap array, see agents.json _meta.roadmap): unverified candidates, not counted in the catalogue.
// Notes and Chinese vendor names are hand-translated here, keyed by name / zh string (data itself stays zh).
const roadmap = (agentsData.roadmap ?? []) as any[];
const roadmapTop10 = roadmap.filter((r) => r.tier === 'top10');
const roadmapTierGroups = [
  { key: 'watch', title: 'Other CLIs & products', desc: 'Candidate products beyond the terminal-first set' },
  { key: 'framework', title: 'Frameworks & engines', desc: 'The wiring point lives in user code; no single verifiable surface' },
  { key: 'ide', title: 'IDE & editor extensions', desc: 'Commands mostly run through the host editor terminal' },
  { key: 'cn', title: 'Chinese products', desc: 'Standalone IDEs and editor plugins' },
] as const;
const outlookLabel: Record<string, string> = {
  'ready-candidate': 'Ready-candidate',
  'needs-config': 'Needs config',
  'likely-blocked': 'Likely blocked',
  unverifiable: 'Hard to verify',
};
// Badge tone rule: ready-candidate=accent, needs-config=info, likely-blocked=muted, unverifiable=muted
const outlookTone = (o: string) => (o === 'ready-candidate' ? 'accent' : o === 'needs-config' ? 'info' : 'muted');
const vendorEn: Record<string, string> = {
  '月之暗面': 'Moonshot AI',
  '腾讯': 'Tencent',
  '心流 iFlow（阿里系）': 'iFlow (Alibaba-backed)',
  '阿里云': 'Alibaba Cloud',
  '阿里': 'Alibaba',
  '百度': 'Baidu',
  '智谱 AI': 'Zhipu AI',
  '科大讯飞': 'iFlytek',
  '非十科技': 'FittenTech',
};
const noteEn: Record<string, string> = {
  'Warp': 'A GUI terminal with a built-in agent (Agent Mode / Autopilot) — commands run in its own UI-hosted terminal, not an external shell; unlikely to be wireable.',
  'Copilot CLI': 'The standalone GitHub Copilot CLI (shipped 2025, distinct from the in-editor Copilot agent) — a POSIX-style CLI; $SHELL/config wiring unverified.',
  'Crush': "charmbracelet's multi-model TUI agent at 28.7k★ — Go, cross-platform; shell detection awaits a code read.",
  'Droid': "Factory's terminal coding agent (droid CLI), aimed at multi-model and CI use — the shell choice awaits a code read.",
  'Kimi Code CLI': "Moonshot AI's Kimi CLI coding agent at 7.9k★ — awaits a code read.",
  'CodeBuddy Code': "Tencent CodeBuddy's terminal edition (CLI coding agent with a free tier) — awaits a code read.",
  'iFlow CLI': 'Alibaba-backed free multi-model CLI agent at 5.1k★ — awaits a code read.',
  'Plandex': '15.8k★; commands run inside its own Docker sandbox — the host-shell wiring point is doubtful.',
  'SWE-agent': '20.6k★ research-grade autonomous agent, container-first execution — the host-direct mode awaits verification.',
  'Jules': "Google's cloud-executed async coding agent — commands never touch a local shell; blocked by design.",
  'Open Interpreter': '59k★ veteran project that lets LLMs run code/commands locally — the host-shell call point awaits a code read.',
  'Auggie': "Augment Code's terminal agent (Auggie CLI, closed source) — awaits verification.",
  'Codebuff': 'A terminal coding agent with parallel multi-agent runs — awaits verification.',
  'Grok Build': "xAI's coding agent product, closed source with an undisclosed execution environment — too little verifiable surface.",
  'grok-cli': 'Community Grok terminal agent at 3.5k★ — awaits a code read.',
  'Vibe CLI': "Mistral's agentic coding CLI — awaits a code read.",
  'ShellGPT': '8k★ natural-language-to-shell generator running locally — the wiring point is clear; the argument style awaits a code read.',
  'aichat': "sigoden's 9k★ all-in-one CLI: shell execution takes $SHELL — should work from a niu session; mechanism clear, machine test pending.",
  'Forge': '3k★ open-source agent CLI in Rust — awaits a code read.',
  'Tabnine Agent': 'In-IDE agent mode; commands run through the host editor terminal — follows automationProfile-style settings.',
  'Sourcegraph Cody': 'Editor extension; commands execute through the host terminal — follows the VS Code family probe / automationProfile.',
  'JetBrains AI Assistant': 'Plugin across the JetBrains IDE family — the built-in terminal shell can point at niu.exe; whether that reaches the agent awaits testing.',
  'Gemini Code Assist': 'Agent mode of the VS Code/JetBrains extension — its state does not transfer to the blocked Gemini CLI (unconditional PowerShell); awaits testing.',
  'avante.nvim': "15k★ Neovim plugin: Neovim's 'shell' option (&shell) can point at niu.exe — mechanism clear, machine test pending.",
  'codecompanion.nvim': "6.9k★ Neovim plugin: agent commands run through Neovim's 'shell' option — mechanism clear, machine test pending.",
  'gptel': 'An Emacs LLM client: tool execution spawns system shells through Emacs subprocesses — awaits verification.',
  '通义灵码 Lingma': "Alibaba Cloud's AI coding assistant (VS Code/JetBrains plugin) — commands run through the host editor terminal.",
  'Qoder': "Alibaba's agentic IDE (standalone product) — terminal detection awaits a code read / testing.",
  '文心快码 Comate': "Baidu's AI coding assistant (VS Code/JetBrains plugin) — commands run through the host editor terminal.",
  'CodeGeeX': "Zhipu AI's coding plugin (many editors) — commands run through the host editor terminal.",
  'iFlyCode': "iFlytek's AI coding assistant (VS Code/JetBrains plugin) — commands run through the host editor terminal.",
  'Fitten Code': "FittenTech's AI coding plugin (many editors) — commands run through the host editor terminal.",
  'AutoGPT': '187k★ elder of the autonomous agent frameworks — executors are assembled by user code; no single wiring point.',
  'gpt-engineer': '55k★ codegen pipeline framework — the shell is decided by user code.',
  'MetaGPT': "50k★ multi-role 'software company' framework — the shell is decided by the execution environment.",
  'CrewAI': '60k★ multi-agent orchestration framework — tool execution is assembled by the user.',
  'smol developer': 'A minimal human-in-the-loop codegen prototype — library-shaped, no fixed wiring point.',
  'AutoCodeRover': 'Research-grade autonomous bug-fixing agent (SWE-bench lineage), usually containerized — awaits verification.',
};

const groups = [
  { key: 'ready', title: 'Works out of the box (terminal)', tone: 'accent', desc: 'Wire the agent to niubash today using the methods below' },
  { key: 'vscode', title: 'VSCode family', tone: 'info', desc: 'One shared probe, one entry each for all nine: VS Code and its forks / extensions — fix it once, the whole family follows' },
  { key: 'partial', title: 'Workarounds', tone: 'warn', desc: 'Doable in some scenarios; waiting on upstream' },
  { key: 'blocked', title: 'Not supported yet', tone: 'muted', desc: 'Upstream exposes no mechanism; issues are being tracked' },
  { key: 'unverified', title: 'Not yet verified', tone: 'muted', desc: 'No per-machine test or code read yet — wire via the universal guide and report back' },
] as const;

const statusLabel: Record<string, string> = { ready: 'Ready', partial: 'Partial', blocked: 'Blocked', unverified: 'Unverified' };
const statusTone = (s: string) => (s === 'ready' ? 'accent' : s === 'partial' ? 'warn' : 'muted');

// Hand-translated one-liners, keyed by slug (data itself stays zh).
const oneLinerEn: Record<string, string> = {
  opencode:
    'Zero-config: launch it from a niu session and it just works; persist SHELL to cover every launch method.',
  'claude-code':
    'Works with no config: the installer drops a bash launcher right on the probe path; an env var can pin it explicitly.',
  codex:
    'The unixwin-maintained Codex fork ships ShellType::Niu built in — install it with npm i -g @unixwin/codex (wpm install codex works too) and it is selected automatically.',
  zed:
    'A single setting: point terminal.shell.program at niu.exe, and the agent shares that terminal.',
  goose:
    'One env var: on Windows the shell tool spawns GOOSE_SHELL and passes -c to anything that is not cmd/PowerShell — point it at niu.exe.',
  dsh:
    'One command installs the plugin bundle: enables niu-sandbox and tool-bash, disables the PowerShell row.',
  'vs-code':
    'The family anchor: one shared probe rules the VS Code lineage — the Copilot agent runs through the editor automation terminal and hits it by default.',
  windsurf:
    'VS Code lineage (Code OSS fork): the automation terminal inherits the family probe — hits the launcher once niubash is installed.',
  trae:
    'VS Code lineage fork: the automation terminal inherits the family probe — hits the launcher once niubash is installed.',
  kiro:
    "AWS's agentic IDE (Code OSS lineage): the automation terminal picks its shell via the shared family probe — hits the launcher once niubash is installed. Lineage-inferred, not machine-tested.",
  zcode:
    'The probe was verified on this very editor: the shared sequence in agents.md comes from reading a ZCode app.asar — hits it by default.',
  cline:
    'VS Code extension: commands run through the editor terminal or automation profile — the extension itself never picks a shell.',
  'roo-code':
    'VS Code extension: commands run through the editor terminal or automation profile and inherit the family probe.',
  'kilo-code':
    'VS Code extension: commands run through the editor terminal or automation profile and inherit the family probe.',
  continue:
    'VS Code extension: commands run through the editor terminal or automation profile and inherit the family probe.',
  cursor:
    'The IDE has a workaround (Legacy Terminal Tool); the Agent CLI currently hard-codes PowerShell with no way to configure it.',
  devin:
    'Launches from a niu session; finish the devin setup login in a regular terminal; TUI support is on the way.',
  'qwen-code':
    'After forking gemini-cli it grew its own MSYSTEM/TERM sniffing and Git Bash lookup — set MSYSTEM=MINGW64 (experimental) to hit the installer-placed launcher. Source-read, not machine-tested.',
  'gemini-cli':
    "The shipped code returns PowerShell on Windows unconditionally — no bash branch; two upstream proposals track this.",
  aider:
    '/run always uses PowerShell or cmd; launching from inside niu does not change its choice.',
  'amazon-q':
    'Not verified yet: no local test or code read. Wire it via the universal four-mechanism guide and report back.',
  amp:
    'Not verified yet: no local test or code read (Sourcegraph product, mostly closed source). Wire via the universal guide.',
  openhands:
    'Not verified yet: command execution usually happens inside a container/sandbox — where the host shell plugs in is still unverified.',
  junie:
    'Not verified yet: runs inside JetBrains IDEs; whether the host terminal shell setting reaches its command execution is unverified.',
};

// Hand-translated mechanism badges, keyed by the zh string in agents.json.
const mechanismEn: Record<string, string> = {
  '$SHELL 环境变量': '$SHELL env var',
  'Git 探针 / CLAUDE_CODE_GIT_BASH_PATH': 'Git probe / CLAUDE_CODE_GIT_BASH_PATH',
  '原生 Niu 探测（unixwin fork）': 'Native Niu detection (unixwin fork)',
  '显式配置 terminal.shell.program': 'Explicit terminal.shell.program',
  'GOOSE_SHELL 环境变量': 'GOOSE_SHELL env var',
  '插件 profile': 'Plugin profile',
  'VS Code 家族探针 / automationProfile': 'VS Code family probe / automationProfile',
  '探测链当前对 bash 不友好': 'Detection chain unfriendly to bash',
  '无原生集成 · niu 会话内可启动': 'No native integration · launches from a niu session',
  '无原生集成（TUI 受 niubash#455 阻塞）': 'No native integration (TUI blocked by niubash#455)',
  'MSYSTEM/TERM 嗅探 + Git Bash 路径查找（自研）': 'MSYSTEM/TERM sniffing + Git Bash lookup (Qwen-specific)',
  'MSYSTEM/TERM 嗅探 → Git Bash 查找': 'MSYSTEM/TERM sniffing → Git Bash lookup',
  '无条件 PowerShell': 'Unconditional PowerShell',
  '无 shell 选项': 'No shell option',
  '未核验': 'Unverified',
};

// Universal rule block (hand-translated from agents.json → universal).
const worksAlwaysEn =
  'Launch the agent from inside a niu session: niu exports $SHELL, and any agent that honors the POSIX convention picks it up. $SHELL is not persisted — agents started from the Start menu will not see it; configure those per their detail pages.';
const verifyCmd = agentsData.universal.verifyCmd;
const verifyTableEn = [
  { sign: 'uname -s = MSYS_NT-… (uname -a ends with x86_64 Msys)', means: 'niu (winuxcmd shim) ✓' },
  { sign: 'uname -s = MINGW64_NT-… (MSYSTEM=MINGW64)', means: 'Git Bash' },
  { sign: 'uname -s = Linux', means: 'WSL — the agent fell back to System32\\bash.exe; fix per the detail page' },
  { sign: 'uname missing, $SHELL empty', means: 'PowerShell or cmd' },
];
---

<BaseLayout
  title="AI Agent Directory: niubash for Claude Code, Codex, Cursor, the VSCode family, opencode, Zed"
  description="Switch Claude Code, Codex, Cursor, VS Code-family agents, opencode, Zed and Goose to niubash — Windows-native bash in one script, with verification and rollback."
  keywords="niubash,claude code shell,codex shell,cursor shell,vs code shell,opencode shell,zed shell,ai agent shell windows,bash for windows,git bash alternative"
  theme="day"
  path="/en/agents/"
  lang="en"
  enPath="/agents/"
>
  <SiteHeader />

  <main class="container">
    <section class="hero">
      <h1>Move your AI agent<br /><span class="hl">onto niubash</span></h1>
      <p class="sub">
        Windows is the first battleground: every command the agent runs lands on real bash syntax,
        with deterministic output and git 3–7× faster. Agents are grouped into terminal /
        VSCode family / workarounds / not supported / not yet verified; cards with a switch script
        open to a <strong>copy-paste script</strong>, verification and a rollback path.
      </p>
      <div class="hero-cta">
        <a class="cta-main" href="/en/agents/universal/">Wire up your AI agent →</a>
        <p class="cta-note"><strong>{allAgents.length}</strong> AI agents catalogued — <strong>{readyCount}</strong> work out of the box
          <span class="cta-extra"> · <a href="#roadmap">{roadmap.length} more</a> in the research pipeline</span></p>
      </div>
    </section>

    <section class="quick-cards" aria-label="Quick paths">
      <a class="quick-card" href="#ready">
        <h2>① I use Claude Code / Codex / Cursor…</h2>
        <p>Pick your agent in the directory — terminal-native and VSCode-family entries ship a switch script, verification and a rollback path.</p>
        <span class="qc-go">Browse the directory →</span>
      </a>
      <a class="quick-card" href="/en/agents/universal/">
        <h2>② My agent isn't listed</h2>
        <p>The universal wiring guide: four detection mechanisms + a three-step decision flow; any agent can be wired to niubash.</p>
        <span class="qc-go">Read the universal guide →</span>
      </a>
      <a class="quick-card" href="/en/ai/">
        <h2>③ Let the agent install it itself</h2>
        <p>The AI portal: paste the one-click install prompt and your agent installs and wires up niubash on its own.</p>
        <span class="qc-go">Open the AI portal →</span>
      </a>
    </section>

    {groups.map((g) => {
      const list = (agentsData.agents as any[]).filter((a) => a.group === g.key);
      if (!list.length) return null;
      return (
        <section class="group" id={g.key}>
          <div class="group-head">
            <h2>{g.title}</h2>
            <Badge tone={g.tone}>{list.length}</Badge>
            <span class="group-desc">{g.desc}</span>
          </div>
          <div class="card-grid">
            {list.map((a) => (
              <a class="agent-card" href={`/en/agents/${a.slug}/`}>
                <div class="card-top">
                  <span class="card-id">
                    <img class="card-icon" src={a.icon} alt="" width="20" height="20" loading="lazy" />
                    <span class="card-name">{a.name}</span>
                  </span>
                  <Badge tone={statusTone(a.status)}>
                    {statusLabel[a.status] ?? a.status}
                  </Badge>
                </div>
                <div class="card-variants">
                  {((a.variants as string[]) ?? []).map((v) => <span class="variant-chip">{v}</span>)}
                </div>
                <p class="card-line">{a.oneLiner_en ?? oneLinerEn[a.slug] ?? a.oneLiner}</p>
                <div class="card-foot">
                  <Badge tone="info">{mechanismEn[a.mechanism] ?? a.mechanism}</Badge>
                  {a.script ? <span class="has-script">one-line script ✓</span> : <span class="no-script">notes</span>}
                  <span class="go">open →</span>
                </div>
              </a>
            ))}
          </div>
        </section>
      );
    })}

    {/* Research pipeline: unverified candidates (roadmap array), placed after the "Not yet verified" group, before the principle details */}
    {roadmap.length > 0 && (
      <section class="group roadmap" id="roadmap">
        <div class="group-head">
          <h2>Research pipeline · 调研中</h2>
          <Badge tone="warn">{roadmap.length}</Badge>
          <span class="group-desc">Candidates from the ecosystem survey, none verified yet — one gets catalogued each time one is verified</span>
        </div>
        <p class="rm-scope">
          <strong>{allAgents.length}</strong> agents catalogued (<strong>{readyCount}</strong> work out of the box); another{' '}
          <strong>{roadmap.length}</strong> candidates are in the research pipeline — priority goes to CLI/TUI agents that execute a local shell.
        </p>
        <div class="top10">
          <Badge tone="accent">Top 10 · Priority</Badge>
          <ul class="top10-list">
            {roadmapTop10.map((r) => (
              <li>
                <a href={r.source} target="_blank" rel="noopener noreferrer">{r.name}</a>
                {r.stars && <span class="rm-stars">{r.stars}★</span>}
              </li>
            ))}
          </ul>
        </div>
        {roadmapTierGroups.map((g) => {
          const list = roadmap.filter((r) => r.tier === g.key);
          if (!list.length) return null;
          return (
            <div class="rm-tier">
              <h3>
                {g.title} <Badge tone="muted">{list.length}</Badge>
                <span class="rm-tier-desc">{g.desc}</span>
              </h3>
              <div class="table-wrap">
                <table class="rm-table">
                  <thead>
                    <tr><th>Name</th><th>Form</th><th>Vendor</th><th>Outlook</th><th>One-liner</th></tr>
                  </thead>
                  <tbody>
                    {list.map((r) => (
                      <tr>
                        <td class="rm-name">
                          <a href={r.source} target="_blank" rel="noopener noreferrer">{r.name} ↗</a>
                          {r.stars && <span class="rm-stars">{r.stars}★</span>}
                        </td>
                        <td class="rm-form">{r.form}</td>
                        <td class="rm-vendor">{vendorEn[r.vendor] ?? r.vendor}</td>
                        <td><Badge tone={outlookTone(r.outlook)}>{outlookLabel[r.outlook] ?? r.outlook}</Badge></td>
                        <td class="rm-note">{noteEn[r.name] ?? r.note}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          );
        })}
        <p class="rm-legend">
          Outlook legend: <strong>Ready-candidate</strong> = mechanism known (configurable shell / takes $SHELL), awaiting a machine test ·
          <strong>Needs config</strong> = probably configurable, awaiting a code read or test ·
          <strong>Likely blocked</strong> = blocked by design (cloud execution / sandbox / hard-coded shell) ·
          <strong>Hard to verify</strong> = closed source or no stable verifiable surface;
          sources are the outbound links on each row. Survey date: {agentsData._meta.roadmap.surveyDate}.
        </p>
      </section>
    )}

    <details class="principle">
      <summary>The principle: how it picks a shell ($SHELL rule + uname signature table)</summary>
      <p class="principle-plain">{worksAlwaysEn}</p>
      <div class="verify">
        <span class="v-label">Check which shell any agent is actually using:</span>
        <code>{verifyCmd}</code>
        <CopyButton copy={verifyCmd} label="Copy" />
      </div>
      <p class="principle-plain">
        In plain terms: have the agent run the verify command above and match its output against
        this table — <code>MSYS_NT</code> means it is already on niu (success); <code>MINGW64</code>
        means it fell into Git Bash; <code>Linux</code> means it fell into WSL; a missing command
        with an empty <code>$SHELL</code> means it is still on PowerShell/cmd.
      </p>
      <table class="v-table">
        <tbody>
          {verifyTableEn.map((r) => (
            <tr>
              <td><code>{r.sign}</code></td>
              <td>
                {r.means}
                {r.sign.includes('MSYS_NT') && (
                  <span class="row-note">
                    MSYS_NT is a deliberate compatibility persona (uname reports MSYS so old
                    scripts assume they are inside MSYS), not a real MSYS runtime — there is no
                    MSYS inside niu.
                  </span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </details>

    <section class="unverified">
      <p>
        Status legend: <strong>Ready</strong> = configurable in the current version ·
        <strong>Partial</strong> = workaround for some scenarios ·
        <strong>Blocked</strong> = upstream exposes no mechanism ·
        <strong>Unverified</strong> = no test or code read yet; source-read (not machine-tested) entries
        name their evidence in the detail page notes.
      </p>
      <p>Detail pages behind these cards are English translations of the Chinese source (agents.md); the Chinese editions stay one click away on every page.</p>
      <p class="src">
        Source of truth for this page:
        <a href="https://unixwin.github.io/niubash/agents.html" target="_blank" rel="noopener noreferrer">Coding agents on Windows, and the shell they run</a> (niubash repo docs/src/agents.md);
        icon provenance and licensing live in the repo's <a href="https://github.com/unixwin/unixwin.dev#readme" target="_blank" rel="noopener noreferrer">THIRD_PARTY_NOTICES.md</a>
      </p>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hero { padding: 3rem 0 1.4rem; }
  .hero h1 { font-size: clamp(1.9rem, 5vw, 2.8rem); margin: 0; line-height: 1.25; }
  .hl { background: linear-gradient(90deg, var(--accent), var(--accent-2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .sub { color: var(--muted); max-width: 46rem; margin: 0.8rem 0 0; line-height: 1.75; }
  .sub strong { color: var(--text); }

  /* Hero-level CTA: big button + real numbers (derived from agents.json: catalogued / ready counts) */
  .hero-cta { display: flex; align-items: center; gap: 1.1rem; flex-wrap: wrap; margin: 1.3rem 0 0; }
  .cta-main {
    display: inline-flex; align-items: center; min-height: 48px;
    background: var(--btn-bg); color: var(--btn-fg); border: 1px solid var(--btn-bg);
    border-radius: var(--radius); padding: 0.7rem 1.5rem;
    font-family: var(--font-mono); font-size: 0.98rem; font-weight: 600; letter-spacing: 0.02em;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .cta-main:hover {
    background: var(--btn-hover); border-color: var(--btn-hover);
    transform: translateY(-1px); text-decoration: none;
  }
  .cta-note { margin: 0; color: var(--muted); font-size: 0.92rem; }
  .cta-note strong { color: var(--text); font-family: var(--font-mono); font-variant-numeric: tabular-nums; }

  /* First-screen quick cards: directory / universal guide / AI portal */
  .quick-cards {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr));
    gap: 1rem; margin: 1.9rem 0 0.4rem;
  }
  .quick-card {
    display: flex; flex-direction: column; gap: 0.45rem;
    background: var(--bg-elev); border: 1px solid var(--border); border-left: 3px solid var(--accent);
    border-radius: var(--radius); padding: 1.05rem 1.15rem; color: var(--text); text-decoration: none;
    transition: border-color 0.15s, transform 0.15s;
  }
  .quick-card:hover { border-color: var(--accent); transform: translateY(-2px); text-decoration: none; }
  .quick-card h2 { margin: 0; font-size: 1.02rem; }
  .quick-card p { margin: 0; color: var(--muted); font-size: 0.88rem; line-height: 1.65; flex: 1; }
