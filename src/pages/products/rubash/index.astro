  version: string;
  date: string;
  summary: string;
}

const cargoAdd = 'cargo add rubash';
const buildFromSource = 'git clone https://github.com/unixwin/rubash.git && cd rubash && cargo build';
const runScript = 'target/debug/rubash path/to/script.sh';

const whyCards: Feature[] = [
  {
    title: 'Rubash 本身不是 shell 产品',
    body: '它是从零用 Rust 写的 GNU Bash 语义引擎——词法、解析、展开、执行、内建，全部进程内、headless。它自带一个供兼容性 harness 与工具链使用的参考 CLI；交互式 shell 建在引擎之上：niubash 内嵌 rubash 承担全部 bash 语义，自己拥有行编辑、提示符渲染与补全。',
  },
  {
    title: '为什么不是移植 bash',
    body: '「Windows 上的 bash」（Git Bash、MSYS2）装的是骑在 POSIX 模拟层 msys-2.0.dll 上的移植 bash，fork 模拟与路径翻译的怪癖渗进每个脚本。rubash 没有这一层：一个自包含二进制直接说 Win32；语义对齐靠黑盒差分实测，不靠搬运 GNU 代码——GPL 代码零拷贝是成文红线。',
  },
  {
    title: '兼容是台账，不是口号',
    body: '对 GNU Bash 自己的 83 套上游语料做 true-baseline 双向测量：83/83 通过、82 套逐字节一致，唯一残差（nameref 1 行）被逐字节证明是 GNU Bash 自身的 coproc 回收竞态。modernish 166/166、bash-completion 452/452、oh-my-bash 252/252 函数环境一致——全部钉成 CI 回归夹具。',
  },
  {
    title: '语义模型平台中立',
    body: '进程内子壳、fd 表语义、进程边界三层模型刻意与平台无关：同一份台账从 Windows 带到 Linux / macOS。Linux 上原生构建并运行（WSL 内实测 19/24 套逐字节一致且在收敛），macOS CI 编译绿；Android 双目标进 CI 交叉检查。',
  },
];

const features: Feature[] = [
  {
    title: '62 个真内建，全覆盖 GNU Bash 5.3',
    body: 'GNU Bash 5.3 的 61 个内建全部覆盖、无缺失，唯一扩展是 env；另有 Windows 专属 sudo 作为隐藏 host 内建不计入。三层分发（真内建 / 隐藏 fast-path / 外部命令）由仓内文档同步测试守护——改白名单不更新文档，cargo test 直接失败。',
  },
  {
    title: '零 fork 的三层执行',
    body: '（ list ）与 $( ) 从不产生进程：ShellState::clone 复制变量/别名/函数/trap/历史；真句柄 fd 表以 DuplicateHandle 共享同一内核文件对象（POSIX dup 共享 open file description 的等价物）；真进程只在真进程边界——外部命令与管道成员走 CreateProcess + os_pipe，作业控制基于 Job Objects。',
  },
  {
    title: '12 个内联文件命令 + 管道内联臂',
    body: 'pwd、printf、mkdir、touch、chmod、cp、rm、rmdir、cat、sed、mkfifo、tty 在引擎内联执行，echo | cat 这类管道一整个零 fork——subshell 与命令替换零进程创建成本，而脚本可观察的一切与 GNU Bash 行为一致。',
  },
  {
    title: '可选择的平台身份',
    body: 'Windows 默认 MSYS2 兼容 persona（uname -s → MSYS_NT-…，OSTYPE=msys——为了让生态脚本走它们测得最好的分支），RUBASH_IDENTITY=native 切到诚实原生身份（Windows_NT / OSTYPE=windows）。persona 在 --help、--identity 与 README 处处披露，永不静默。',
  },
  {
    title: '为 agent 与调试准备的工程面',
    body: '脚本级函数级 profiler（确定性插桩，非采样）已合并；DAP-first 调试器设计定稿（--debugger，11 个停点 seam 全部锚定既有 DEBUG-trap 分发点，gdb 式 CLI REPL 双前端）；引擎跑得动 bashdb 核心调试循环。',
  },
  {
    title: '跨平台 CI 硬门',
    body: 'ubuntu / macOS / Windows x64 三个真 runner 跑测试，linux-gnu、aarch64-apple-darwin、aarch64-linux-android、armv7-linux-androideabi 四目标交叉检查进同一 CI；单测 698 通过 / 0 失败。跨平台缺口有公开台账（docs/cross-platform-gap-ledger.md），不假装没有。',
  },
];

const bench: Row[] = [
  {
    a: 'GNU Bash 上游语料',
    b: '83/83 套通过，82 套逐字节一致',
    c: '唯一残差 = GNU 自身 coproc 竞态',
    src: 'rubash README:17 · 2026-10-12 全量重跑',
  },
  {
    a: 'nvm.sh 解析（重词法）',
    b: '与 GNU 差距 720x → 8x（重词法字节 −40%）',
    c: '工程进度口径：差距收敛，非「快 8x」',
    src: 'rubash PR #486（issue #281）',
  },
  {
    a: '关联数组元素写 K=5000',
    b: 'O(n²)→O(1)，单次写快 45 倍',
    c: '对 GNU 差距 445x → 9.9x',
    src: 'rubash PR #650（issue #618）',
  },
  {
    a: '索引数组覆盖写 K=5000',
    b: '快 177 倍',
    c: '对 GNU 差距 674x → 3.8x；顺带修 O(n²) tokenizer（10001 段 563ms→17.8ms）',
    src: 'rubash PR #652（issue #616）',
  },
  {
    a: '单次 spawn 成本',
    b: 'rubash 1.183 ms',
    c: 'GNU 1.121 ms——持平（Win32 CreateProcess 地板，如实展示）',
    src: 'unix-spawn-cost-20261012.md（min-of-3）',
