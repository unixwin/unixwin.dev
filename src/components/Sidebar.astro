---
/**
 * Sidebar — 文档区侧栏（门户第一个带侧栏的区域）。
 *
 * 数据源：src/data/docs-nav.json
 *   { sections: [ { label: string, items: [ { label, href, external? } ] } ] }
 *
 * - 分组标题 + 链接；`external: true` 的条目新窗口打开并带 ↗ 标记。
 * - 激活态：Astro.url.pathname 与 href 去尾部斜杠后比较（构建期静态判定，
 *   与 Astro 静态路由一致，无需客户端 JS）。
 * - 折叠：原生 <details open>，零 JS；默认展开，可点击 summary 收起。
 * - 宽 240px，sticky（top 偏移避开吸顶 SiteHeader），超高自身滚动。
 */
import nav from '../data/docs-nav.json';

interface NavItem {
  label: string;
  href: string;
  external?: boolean;
}

interface NavSection {
  label: string;
  items: NavItem[];
}

const sections = (nav as { sections: NavSection[] }).sections;

const currentPath = (Astro.url.pathname.replace(/\/+$/, '') || '/');

function isActive(href: string): boolean {
  if (/^https?:\/\//.test(href)) return false;
  const normalized = href.replace(/\/+$/, '') || '/';
  return normalized === currentPath;
}
---

<aside class="sidebar" aria-label="文档导航">
  {
    sections.map((section) => (
      <details class="side-group" open>
        <summary class="side-title">{section.label}</summary>
        <ul class="side-list">
          {section.items.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={{ 'side-link': true, 'is-active': isActive(item.href), 'is-external': item.external }}
                aria-current={isActive(item.href) ? 'page' : undefined}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {item.label}
                {item.external && (
                  <span class="ext-mark" aria-hidden="true">↗</span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </details>
    ))
  }
</aside>

<style>
  .sidebar {
    width: 240px;
    flex: 0 0 240px;
    position: sticky;
    top: 4.5rem; /* 吸顶 SiteHeader 之下 */
    align-self: start;
    max-height: calc(100vh - 5.5rem);
    overflow-y: auto;
    padding: 1.5rem 0.75rem 2rem 0;
    font-size: 0.9rem;
  }

  .side-group {
    margin-bottom: 1.1rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.9rem;
  }

  .side-group:last-child {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .side-title {
    cursor: pointer;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0 0.5rem;
    list-style: none;
    user-select: none;
  }

  .side-title::-webkit-details-marker {
    display: none;
  }

  .side-title::before {
    content: '▸';
    display: inline-block;
    margin-right: 0.4em;
    color: var(--muted);
    transition: transform 0.15s ease;
  }

  .side-group[open] > .side-title::before {
    transform: rotate(90deg);
  }

  .side-list {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }

  .side-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.32rem 0.5rem 0.32rem 1.45rem;
    border-radius: var(--radius);
    border-left: 2px solid transparent;
    color: var(--muted);
    text-decoration: none;
    line-height: 1.4;
  }

  .side-link:hover {
    color: var(--text);
    background: var(--bg-elev);
    text-decoration: none;
  }

  .side-link.is-active {
    color: var(--accent);
    border-left-color: var(--accent);
    background: var(--bg-elev);
    font-weight: 700;
  }

  .is-external .ext-mark {
    color: var(--muted);
    font-size: 0.8em;
  }

  @media (max-width: 960px) {
    .sidebar {
      position: static;
      max-height: none;
      width: 100%;
      flex-basis: 100%;
      overflow: visible;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1rem;
    }
  }
</style>
