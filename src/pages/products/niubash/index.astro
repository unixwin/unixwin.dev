---
/**
 * /products/niubash/ — niubash 产品文档页（旗舰）。
 * 事实来源：portal-dump HIGHLIGHTS.md / CARDS.md / FACTS.json（2026-10-19 总控审计）、
 * src/data/{products,repo-meta,facts,changelogs}.json、niubash 仓 README.md 与 docs/src/。
 * 每个数字括注来源；版本与 star 为 repo-meta 2026-10-19 实测值。
 */
import DocsLayout from '../../../components/DocsLayout.astro';
import CopyButton from '../../../components/CopyButton.astro';

interface Row {
  a: string;
  b: string;
  c: string;
  src: string;
}

interface Feature {
  title: string;
  body: string;
}

interface News {
  version: string;
  date: string;
  summary: string;
}

const installWin = 'irm https://unixwin.dev/install.ps1 | iex';
const installLinux = 'tar -xzf niubash-v*-linux-x86_64.tar.gz && niubash-v*-linux-x86_64/niu';
const installSource = 'git clone https://github.com/unixwin/niubash.git && cd niubash && cargo build --release';

const whyCards: Feature[] = [
  {
    title: '零 fork：三层执行模型',
    body: 'POSIX fork() 在 Win32 没有等价物，MSYS2/Cygwin 只能在 syscall 层伪造它。niu 的引擎 rubash 复刻 fork 的语义而非机制：子壳与命令替换在进程内完成，脚本可观察的一切——退出码、fd 继承、共享偏移、信号处置——与 GNU Bash 一致。命令替换类负载实测 13–62x 快于 GNU bash。',
  },
  {
    title: '无 MSYS：argv 永不改写',
    body: 'Git Bash 的 MSYS 运行时会在 spawn 前启发式改写「看起来像路径」的参数，每个老用户都被迫学会 MSYS_NO_PATHCONV 咒语——这两个环境变量的存在本身就是官方承认问题的证据。niu 没有 MSYS 运行时：参数进什么，命令就收什么，无咒语可念。',
  },
  {
    title: '四大生态的路径方言全收',
    body: 'Windows 原生（D:\\repo、D:/repo）、MSYS/Git Bash 形（/d/repo、/tmp、/usr/bin）、WSL 形（/mnt/d）、Cygwin 形（/cygdrive/d）全部接受且真折叠——既有脚本零修改。对照探针证明 Git Bash 的 /mnt/d 会静默落到安装根（假阳性地雷），而 niu 真折叠（pwd -P=/d/repo）。',
  },
  {
    title: '兼容性是测出来的，不是宣称的',
    body: '对 GNU Bash 自己的 83 套上游语料做 true-baseline 双向测量：83/83 通过、82 套逐字节一致，唯一残差被逐字节证明是 GNU Bash 自身的 coproc 回收竞态。另外全网 2686 仓 / 9701 资产每夜巡检，6336 条真实资产判定原文入仓可回放。',
  },
];

const features: Feature[] = [
  {
    title: '真·插件生态：上游 BASH 插件直接跑',
    body: 'oh-my-bash、bash-it、bash-completion、bash-preexec 这些真实世界的 BASH 资产，源码一行不改就在 niu 里原生运行——没有 MSYS、没有 Cygwin、没有 WSL。bash-completion 3796 行完整 source rc=0 曾是发布阻塞，如今是端到端门禁的一环。',
  },
  {
    title: '为 agent 而设的旗标面',
    body: 'niu --encoded-command <base64> 给 agent/CI 一条免引号通道（RFC 4648 载荷走与 -c 完全相同的一次性路径，可选 v1: 前缀防 MSYS 路径改写）；niu --cwd-state <file> 让链式一次性调用共享目录记忆——表现为同一个 shell，不加旗标字节级零变化。',
  },
  {
    title: 'AI agent 接入：$SHELL 即机制',
    body: 'niu 导出 $SHELL，遵循 POSIX 约定的 agent（如 opencode）从 niu 会话启动即用、零配置；安装器还在探针路径布放 bash 启动器命中 Claude Code 的第一探针。每个 agent 的接入方式与验证命令见站内 Agent 目录。',
  },
  {
    title: '内联命令与编译进壳的补全',
    body: 'pwd、printf、cat、sed、mkdir、touch、chmod、cp、rm 等 12 个高频文件命令在引擎内联执行，echo | cat 全程零进程；178 个 WinuxCmd applet 的真实旗标补全编译进 shell，零插件即有 git/tar/curl/docker/kubectl 等常用命令的静态补全层。',
  },
  {
    title: 'wpm 联动：命令即包',
    body: 'Winux 包管理器 wpm 随 WinuxCmd 内建，rg / fd / bat / jq / node 等 Unix 工具一条 wpm install 到位；Windows 发行包预装 gawk、niu-git、ripgrep、fd，bash-it 插件依赖的 awk 开箱即用。',
  },
  {
    title: 'git 感知的快速提示符',
    body: '默认提示符读 .git/HEAD 文件（微秒级）渲染分支与脏标记，不再像 Git Bash 那样每条提示符 spawn git 子进程（实测 113–362ms）；仓库外连 stat 都省掉。视觉对齐 Git Bash 骨架，但明确不做 MINGW64 身份段。',
  },
  {
    title: '输入管线做到字节级',
    body: '多行粘贴自动误执行 186 次 → 0，257 行载荷 300s 超时 → 4.6s；ConPTY 粘贴丢字符、typeahead 吃键、控制台 read 三面（-t 门饿死 / conhost 预煮劈半行 / ICRNL）逐项与 GNU 行为对齐，每项带双向差分证据。',
  },
  {
    title: '跨平台到 CI 腿：三个发布平台，六个发布目标',
    body: 'Windows x64/ARM64、Linux x86_64/aarch64、macOS aarch64/x86_64 六个目标已发布且每次发布冒烟四查（--version、-c 执行、经原生 coreutils 的管道、离线插件栈）才允许上传；Android 双目标是 incubating 的 NDK 构建腿（zip 只随 CI workflow 产出、不入发布档、无运行时冒烟），OpenHarmony 仅 CI 编译检查。各平台的诚实状态矩阵见平台支持文档。',
  },
];

const bench: Row[] = [
  {
    a: '一次性执行 niu -c true',
    b: '26.3 ms（优化前 105.6 ms，一次性快路径六连 PR）',
    c: 'Git Bash 71 ms',
    src: 'GITBASH-KILLER 面 6 · niubash PR #267–#272',
  },
  {
    a: '提示符 git 段',
    b: '读 .git/HEAD ≤29 ms',
    c: '每条提示符 spawn git 113–362 ms',
    src: 'GITBASH-KILLER 面 3（真仓 min-of-20）',
  },
  {
    a: '安装体积',
    b: 'niu ≈16 MB，零 DLL',
    c: 'Git Bash 440 MB + 20 MB msys-2.0.dll',
    src: 'GITBASH-KILLER 面 4（装机位实测）',
  },
  {
    a: '多行粘贴',
    b: '自动误执行 186 次 → 0；257 行 300s 超时 → 4.6s',
    c: '—',
    src: 'niubash PR #252/#288 · paste_multiline_bench.py',
  },
  {
    a: 'workspace 单测',
    b: '1026 通过 / 0 失败',
    c: '—',
    src: 'CI run 39191023176（FACTS.json）',
  },
