/**
 * /products/rubash/ — rubash 产品文档页（面向嵌入者）。
 * 事实来源：rubash 仓 README.md / docs/builtins.md / docs/design/1.5.0-workspace-and-engine-api.md、
 * portal-dump HIGHLIGHTS.md / CARDS.md / FACTS.json（2026-10-19）、src/data/{products,repo-meta,changelogs}.json、
 * crates.io 实测（rubash / niubash / niubash-runtime 均 1.4.0）。
 * 口径纪律：nvm 720x→8x 是「与 GNU 差距收敛」的工程进度口径，不是「快 8x」。
 */
import DocsLayout from '../../../components/DocsLayout.astro';
import CopyButton from '../../../components/CopyButton.astro';

