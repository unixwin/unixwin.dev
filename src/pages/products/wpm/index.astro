 * wpm-source/docs/index-schema.md（index.json 与 --json 契约）、wpm-source/index.json（sources 四源）、
 * WinuxCmd/DOCS/en/wpm_guide.md（命令族、布局、防投毒、代理）、HIGHLIGHTS.md #13、
 * src/data/{repo-meta,products,changelogs}.json（构建期数据；changelog 用 WinuxCmd 仓，
 * wpm 随 winuxcmd.exe 发布、无独立版本）。
 */
import DocsLayout from '../../../components/DocsLayout.astro';
