  },
  {
    title: '--json 契约',
    body: '查询类子命令输出带 schema:1 版本字段的纯 JSON（list/search/installed/info/index status/links list/outdated/categories），供 GUI/TUI 与 agent 消费。',
  },
  {
    title: '四源镜像与回退',
    body: '内置 github-raw / jsdelivr / release-pinned / official-cn 四源按优先级自动回退；中国区 official-cn 经 gh.caomengxuan666.com 的 nginx 缓存代理，GitHub 源保底。',
  },
  {
    title: '防投毒两道锁',
    body: '索引文件内声明的 sources 永不并入候选（防被攻破的镜像持久注入下载位）；wpm index update 记录 last_index_sha256，非首选源送来内容不同的索引时告警。',
  },
  {
    title: '自更新与回滚',
    body: 'wpm update winuxcmd 异步换镜像（等待占用进程退出后替换并重建全部链接）；.wpm\\backup\\ 自动保留最新两份回滚，wpm clean backup 回收。',
  },
];

// —— 深入：索引结构与内置源 ——
interface SourceRow {
  name: string;
  region: string;
  priority: string;
  note: string;
}
const sources: SourceRow[] = [
  { name: 'official-github-raw', region: 'global', priority: '10', note: 'canonical：raw.githubusercontent.com 上的 index.json' },
  { name: 'official-jsdelivr', region: 'global', priority: '15', note: 'CDN 镜像：cdn.jsdelivr.net/gh/unixwin/wpm-source@main' },
  { name: 'official-github-release', region: 'global', priority: '20', note: '发布档钉版：releases/latest/download/wpm-index.json' },
  { name: 'official-cn', region: 'cn', priority: '30', note: 'gh.caomengxuan666.com 的 nginx 缓存代理；构件 URL 走代理、GitHub 源兜底' },
];

interface FactRow {
  metric: string;
  value: string;
  src: string;
}
const factRows: FactRow[] = [
  { metric: '官方索引规模', value: '281 包（wpm-source index.json，version official-2026.10.17）', src: 'wpm-source/index.json packages[] 实测计数 2026-10-19' },
  { metric: 'shim 分发跳数', value: '12.1 ms（winuxcmd-shim.exe 转发器，此前硬链接 winuxcmd.exe 需 24.5 ms）', src: 'WinuxCmd CHANGELOG 1.1.14 实测' },
  { metric: '占用文件升级', value: '28 个 fsmonitor--daemon 进程持有载荷时强制升级成功、包完整', src: 'WinuxCmd CHANGELOG 1.1.13 实机验证' },
  { metric: '回滚副本治理', value: '自动保留最新两份并修剪（单机曾积累 61.8 MB）', src: 'WinuxCmd CHANGELOG 1.1.14' },
  { metric: '缓存键', value: '<pkg>-<version>-<sha8>（下载先验 + 缓存复用双校验）', src: 'WinuxCmd#1154/#1157（HIGHLIGHTS #13）' },
];

// —— 更新动态：wpm 无独立版本，随 winuxcmd.exe 发布 ——
interface ChangelogVersion {
  version: string;
  date?: string;
  unreleased?: boolean;
}
interface ChangelogRepo {
  repo: string;
