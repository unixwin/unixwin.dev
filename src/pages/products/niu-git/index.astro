const verifyGit = 'git --version';
const migrate1 = 'wpm update winuxcmd';
const migrate2 = 'wpm install niugit --force';
const migrateBoth = `${migrate1}\n${migrate2}`;

const whyCards: Feature[] = [
  {
    title: '快是结构性的，不是调优',
    body: 'Git Bash 的 git 跑在 MSYS2 运行时里（从 cmd / PowerShell 还要再过一道 cmd\\git.exe launcher），每次调用都付一遍 POSIX 运行时初始化，在 Git Bash 提示符里还要再付一次 fork。niu-git 的 usr\\bin\\git.exe 就是 git 本体：一次 CreateProcess，无 MSYS DLL、进程树里无 bash 无 perl。',
  },
  {
    title: '无 MSYS、无 OpenSSL、无捆绑脚本运行时',
    body: 'MSVC + CMake 构建 git-for-windows 真实 C 源码；TLS 只走 schannel（Windows 证书库），不捆 OpenSSL；zlib / iconv 静态链接进 git.exe（没有 zlib1.dll / iconv-2.dll）；shell 脚本部分（hooks、git bisect、git mergetool）由 PATH 上的 niubash sh 承担——不捆 bash，也不捆 perl。',
  },
  {
    title: '参数保真：引号纪律与消息字面字节',
    body: 'commit -m 载荷、D:\\dir\\ 路径规格、CJK 与多行消息逐字节存活——引号规则按 Win32 文档行为对齐、零启发式，差分套件 49/49 钉死。POSIX 形路径参数（/d/repo/...）经存在性检查回退转换接受；消息载荷永不改写——消息就是字面字节。',
  },
  {
    title: '边界诚实：不带的说清楚',
    body: 'perl 命令（send-email、svn、cvs*）不提供而不是运行时才失败；git-gui / gitk（Tcl/Tk）不随发；git grep -P（PCRE2）没有——用 WinuxCmd 的 grep -P。git --version 携带 2.56.0.windows.2.niugit 分布标记，bug 报告能同时定位发行版与上游基线。',
  },
];

const features: Feature[] = [
  {
    title: '真 git C 源码，MSVC 原生构建',
    body: '不是重写也不是模拟：上游 git-for-windows 的 C 源码 + 仓内三枚补丁（#1 schannel 容忍 stale http.sslBackend；#2 POSIX 形路径参数 + 消息守卫；#3 system prefix 自定位），源码永不入仓，CI 拉上游 tarball 打补丁。',
  },
  {
    title: '~14 ms 启动',
    body: 'wpm flat 布局实测 git --version 13.7 ms 均值 / 11.5 ms 最小值，git status 22.6 ms 均值——对照 Git Bash 侧 45–103 ms。v2.55.0.5 起根入口 launcher 退役：patch #3 让裸 git.exe 自己找到 payload，无包装 hop、无 winuxcmd 分发跳转。',
  },
  {
    title: 'schannel TLS 与凭据不越权',
    body: 'TLS 走 Windows 证书库；你自配的任何凭据 helper（host 级 credential.<url>.helper、Git Credential Manager、gh auth git-credential）照常生效。系统 gitconfig 刻意不设默认 helper（git 按 system→global→local 顺序咨询，系统默认会跑在你自选的 helper 之前）；自带 172 KB 的 wincred 小助手读 Windows 凭据管理器里现成的条目。',
  },
  {
    title: '与 niubash sh 的分工',
    body: 'git 的 shell 脚本部分——hooks、git bisect、git mergetool、git filter-branch、git submodule、git request-pull——跑在 niubash 提供的 sh 上（wpm 索引条目明文 niu-git 接受 POSIX 形 /d/... 参数）。git 二进制管 C 的事，shell 的事交给真正的 shell。',
  },
  {
    title: '上游测试基线在案',
    body: '对 CMake 构建跑上游 t/ 套件（t0*、t1[0-4]* 子集）：curated subset 2861 ok / 14 例 # TODO known breakage / 0 硬失败；t0001-init 102/103（唯一失败是 includeIf.onbranch 重初始化边缘例）。',
  },
  {
    title: '随 niubash 一起到货',
    body: 'niubash 1.4.0 的 Windows 发行包经 wpm 预装 niu-git（同批 gawk、ripgrep、fd；ARM64 安装同样预装 niu-git / ripgrep / fd，仅 gawk 限 x64）——装完 niubash，PATH 上的 git 就是原生 git。',
  },
];

const speed: SpeedRow[] = [
  { who: 'niu-git（flat 布局）', version: '13.7 ms 均值 / 11.5 ms 最小', status: '22.6 ms 均值 / 17.4 ms 最小', best: true },
  { who: 'Git for Windows mingw64\\bin\\git.exe', version: '51.3 ms 均值', status: '30.6 ms 均值' },
  { who: 'Git for Windows cmd\\git.exe（PATH 常规入口）', version: '45.3 ms 均值', status: '50.1 ms 均值' },
