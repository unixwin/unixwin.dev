    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.76em;
  }

  /* —— 为什么：3 卡 —— */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    margin: 1.2rem 0;
  }

  .why-card {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-elev);
    padding: 0.95rem 1.1rem;
  }

