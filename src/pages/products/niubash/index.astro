const news: News[] = [
  {
    version: '1.4.0',
    date: '2026-10-10',
    summary:
      'Git Bash 兼容默认提示符（读 .git/HEAD，不 spawn git）、--encoded-command 与 --cwd-state、vi 模式端到端、agent skill bundle、发布包预装 gawk/niu-git/ripgrep/fd。',
  },
  {
    version: '1.3.4',
    date: '2026-10-05',
    summary:
      '主题选择在 source 与新终端下存活；多行主题光标落位修复；178/178 WinuxCmd applet 补全内嵌；金色用户旅程成为发布门禁。',
  },
  {
    version: '1.3.3',
    date: '2026-10-04',
    summary:
      'PROMPT_COMMAND 探针吃首键修复（typeahead guard）；tr 管道选项修复；解析吞吐 +13%（nvm GNU 比例 18.0x → 15.6x）。',
