const t = (s: string): string => T[s] ?? s;
---

<BaseLayout
  title="Benchmarks: niubash vs Git Bash / WSL / GNU bash — the measured Git Bash alternative"
  description="niubash benchmark results: git startup 3–7x, one-shot execution 2.7x and the prompt git segment 4–12x faster than Git Bash — the Git Bash alternative, measured; 8/8 workloads ahead of GNU bash and WSL on the same Windows machine. Every number carries an artifact or PR anchor; wins and losses both shown."
  keywords="niubash benchmark,git bash alternative,vs git bash,gnu bash,wsl,bash benchmark,windows bash performance,bash for windows"
  theme="day"
  path="/en/benchmarks/"
  lang="en"
  enPath="/benchmarks/"
>
  <SiteHeader />

  <main class="container">
    <section class="hero">
      <h1>Let the numbers speak<span class="cursor">▊</span></h1>
      <div class="badges">
        <Badge tone="accent">git startup 3–7x vs Git Bash</Badge>
        <Badge tone="accent">prompt git segment 4–12x</Badge>
        <Badge tone="accent">8/8 ahead on Windows</Badge>
        <Badge tone="info">27x lighter · zero DLLs</Badge>
      </div>
      <p class="sub">Every number carries an artifact or PR anchor (noted row by row); claims we haven't measured don't get printed on this page.</p>
    </section>

    <section class="sec">
      <h2>Startup · latency · size</h2>
      <div class="tbl-wrap">
        <table>
          <thead><tr><th>Metric</th><th>niubash / rubash</th><th>Baseline</th><th>Ratio</th><th>Source</th></tr></thead>
          <tbody>
            {(bench.latency as any[]).map((r) => (
              <tr>
                <td>{t(r.metric)}</td>
                <td class="us">{t(r.us)}</td>
                <td>{t(r.them)}</td>
                <td>{r.badge ? <Badge tone="accent">{r.badge}</Badge> : '—'}</td>
                <td class="src">{t(r.source)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="sec">
      <h2>{t(h.title)}</h2>
      <p class="sec-desc">
        {h.provenance.date} · rubash {t(h.provenance.rubash)} · method: {t(h.provenance.method)}.
        Source: <code>{h.provenance.source}</code>
      </p>
      <div class="tbl-wrap">
        <table>
          <thead><tr><th>Workload</th><th style="width:24%">rubash vs Git Bash</th><th>rubash</th><th>Git Bash</th></tr></thead>
          <tbody>
            {(h.rows as any[]).map((r) => (
              <tr>
                <td>{t(r.workload)}</td>
                <td>
                  <span class="bar bar-us" style={`width:${bar(r.rubash)}`}></span>
                  <span class="bar bar-them" style={`width:${bar(r.gitbash)}`}></span>
                </td>
                <td class="num us">{r.rubash.toLocaleString()} ms</td>
                <td class="num">{r.gitbash.toLocaleString()} ms</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="foot-note">{t(h.note)}</p>
    </section>

    {android && (
      <section class="sec">
        <h2>
          {t(android.title)} <span class="vs">niu vs GNU bash 5.3.20 (aarch64)</span>
          <Badge tone="warn">post-fix re-run pending</Badge>
        </h2>
        <p class="sec-desc">
          {android.provenance.date} · {t(android.provenance.device)} · {t(android.provenance.versions)}.
          Method: {t(android.provenance.method)}.
          Source: <code>{t(android.provenance.source)}</code>
        </p>
        <div class="tbl-wrap">
          <table>
            <thead><tr><th>Workload (v1.4.0 snapshot)</th><th>GNU bash</th><th>niu</th><th>Verdict</th></tr></thead>
            <tbody>
              {android.slower.map((r: any) => (
                <tr>
                  <td>{t(r.workload)}</td>
                  <td class="num">{r.bash}</td>
                  <td class="num">{r.niu}</td>
                  <td class="loss">{t(r.ratio)}</td>
                </tr>
              ))}
              {android.faster.map((r: any) => (
                <tr>
                  <td>{t(r.workload)}</td>
                  <td class="num">{r.bash}</td>
                  <td class="num us">{r.niu}</td>
                  <td class="win">{t(r.ratio)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <ul class="foot-note" style="list-style:disc;padding-left:1.2rem;">
          <li>{t(android.statusNote)}</li>
          {android.postFix.map((p: any) => <li><strong>{t(p.item)}:</strong> {t(p.detail)} (<code>{t(p.source)}</code>)</li>)}
        </ul>
      </section>
    )}

    {forkRows.length > 0 && (
      <section class="sec">
        <h2>
          Fork / subshell deep dive <span class="vs">rubash engine vs GNU bash 5.3.20</span>
          {fs.status === 'placeholder' && <Badge tone="warn">placeholder · pending TSV</Badge>}
        </h2>
        <p class="sec-desc">
          {fs.provenance.date} · rubash {fs.provenance.rubash} / niu {fs.provenance.niu} · method: {t(fs.provenance.method)}.
          {fs.status === 'placeholder' && <em>{t(fs.statusNote)}</em>}
        </p>
        <div class="tbl-wrap">
          <table>
            <thead><tr><th>Workload</th><th style="width:22%">bash → rubash</th><th>GNU bash</th><th>rubash</th><th>niu</th><th>Ratio</th></tr></thead>
            <tbody>
              {forkOnly.map((r) => (
                <tr>
                  <td>{t(r.workload)}</td>
                  <td>
                    <span class="bar bar-them" style={`width:${rowBar(r.bashMs, r.bashMs)}`}></span>
                    <span class="bar bar-us" style={`width:${rowBar(r.rubashMs, r.bashMs)}`}></span>
                  </td>
                  <td class="num">{r.bashMs.toLocaleString()} ms</td>
                  <td class="num us">{r.rubashMs.toLocaleString()} ms</td>
                  <td class="num">{r.niuMs.toLocaleString()} ms</td>
                  <td><Badge tone={parseFloat(r.ratioVsBash) >= 10 ? 'accent' : 'muted'}>{r.ratioVsBash}</Badge></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {inlineOnly.length > 0 && (
          <>
            <p class="sec-desc" style="margin-top:1rem">
              Workloads that also include inline-coreutils gains (listed separately, not counted
              toward the fork record):
              {inlineOnly.map((r) => `${t(r.workload)} ${r.ratioVsBash} (${r.bashMs.toLocaleString()}→${r.rubashMs.toLocaleString()} ms)`).join('; ')}.
            </p>
          </>
        )}
        <ul class="foot-note" style="list-style:disc;padding-left:1.2rem;">
          {fs.analysis.map((a: string) => <li>{t(a)}</li>)}
        </ul>
      </section>
    )}

    <section class="sec">
      <h2>Engineering numbers <span class="vs">before → after, each with a PR anchor</span></h2>
      <div class="tbl-wrap">
        <table>
          <thead><tr><th>Item</th><th>Number</th><th>Source</th></tr></thead>
          <tbody>
            {(bench.engineering as any[]).map((r) => (
              <tr>
                <td>{t(r.item)}</td>
                <td class="us">{t(r.detail)}</td>
                <td class="src">{t(r.source)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="sec methodology">
      <h2>Methodology &amp; sources</h2>
      <ul>
        <li>Environment: {t((bench._meta as any).env)}; raw artifacts checked into <code>data/bench/</code> (15 files, incl. BENCH-README.md with the environment and method notes)</li>
        <li>Discipline: nothing unmeasured gets written down; ties and losses are listed too (single-spawn parity = the real exec floor; the cross-OS WSL reference has been removed from the main table)</li>
        <li>Source of truth: FACTS.json (portal-dump branch, 2026-10-19) — where the README disagrees, FACTS wins</li>
      </ul>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

