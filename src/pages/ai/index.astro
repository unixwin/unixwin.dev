---
/**
 * /ai/ — 给 AI 看的门户（theme A · terminal）。
 * 双读者：人类用户（把提示词粘给自己的 agent）+ AI agent（直接读本页装好 niubash）。
 * 纯 markdown 机器版在 /agents.md（src/pages/agents.md.ts），两处提示词保持一致。
 * 事实来源：niubash 仓库 docs/src/agents.md（四机制/验证签名/陷阱）、
 * docs/src/advanced-usage.md「AI Agent Skill Bundle」（skill install 旗标）、
 * skills/niubash/SKILL.md（skill 内容摘要）。
 */
import BaseLayout from '../../components/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Section from '../../components/Section.astro';
import Badge from '../../components/Badge.astro';
import CopyButton from '../../components/CopyButton.astro';
import FaqSection from '../../components/FaqSection.astro';
import { faqByIds, faqJsonLd } from '../../data/faq';

const pageFaq = faqByIds(['switch-agent', 'no-wsl-msys', 'naming', 'free-platforms', 'perf']);

// ---- 一键安装提示词（主 CTA，与 src/pages/agents.md.ts 保持逐字一致） ----
const installPrompt = [
  '请把这台 Windows 机器上你（AI agent）执行命令所用的 shell 换成 niubash——Windows 原生的 bash 实现，无 WSL、无 MSYS。按顺序执行并汇报：',
  '',
  '1. 安装 niubash（首选 winget：`winget install --id Unixwin.Niubash --source winget`；或 PowerShell 中执行）：',
  '   irm https://unixwin.dev/install.ps1 | iex',
  '2. 把你自己的执行 shell 指到 niu：读 https://unixwin.github.io/niubash/agents.html 的',
  '   「The four mechanisms」一节，判断你属于哪种探测机制（1 = $SHELL 环境变量；',
  '   2 = agent 自身的显式配置；3 = Git for Windows 探针 C:\\Program Files\\Git\\bin\\bash.exe；',
  '   4 = 裸名查找或默认 PowerShell），再按文档中你的条目接线：机制 1 持久化 SHELL',
  '   指向 niu.exe 或从 niu 会话启动；机制 2 把 shell 配置写成 niu.exe；机制 3 确认',
  '   安装器放置的 bash.exe 存在即可；机制 4 按文档该 agent 小节的建议处理。',
  '3. 验证：重开你的会话后执行 echo "SHELL=$SHELL"; uname -s。',
  '   成功判据：uname -s 以 MSYS_NT- 开头，且 $SHELL 指向 niu.exe。',
  '   输出 Linux = 落到 WSL，输出 MINGW64_NT- = Git Bash，均算失败，回第 2 步换机制。',
  '4. 回滚：把第 2 步改动过的配置与环境变量还原即可——niubash 不替换系统组件、不动',
  '   System32；niu doctor 可自检安装健康度。',
  '',
  '完成后汇报：所用机制、改动清单、第 3 步原始输出。',
].join('\n');

// ---- 让 agent 自己写接入的指令模板（复制后粘给 agent） ----
const agentTemplate = [
  '请你（AI agent）为自己生成并应用 niubash 接入配置。先备份、再改动，逐步执行：',
  '',
  '1. 读文档 https://unixwin.github.io/niubash/agents.html（niubash 仓库 docs/src/agents.md），',
  '   重点：「The four mechanisms」表 + 「Agent reference」中你的条目。',
  '2. 自查机制：对照四机制表判断你读哪种机制选 shell——$SHELL 环境变量 / 自身显式',
  '   配置（配置文件或 CLI 旗标）/ Git for Windows 探针（硬编码 C:\\Program Files\\Git',
  '   路径或从 PATH 上的 git 推导）/ 裸名查找（PATH、ComSpec）或默认 PowerShell。',
  '   拿不准先跑 echo "SHELL=$SHELL"; uname -s 看现状再对照。',
  '3. 生成配置：按机制写最小改动——机制 1：把 SHELL=<niubash 路径>\\niu.exe 持久化到',
  '   用户环境；机制 2：写你配置中的 shell 字段；机制 3：确认探针路径 bash.exe 已由',
  '   安装器放置，或设对应环境变量；机制 4：按文档该 agent 小节建议（automationProfile、',
  '   插件，或确认上游暂不支持）。每碰一个文件前先备份。',
  '4. 验证：重启会话执行 echo "SHELL=$SHELL"; uname -s，期望 uname -s 以 MSYS_NT-',
  '   开头；连续两轮不过即停，不要继续试错。',
  '5. 回滚：恢复全部备份，报告失败在哪一步与文档原文依据。',
  '',
  '汇报格式：机制编号 → 改动清单（文件/变量/命令）→ 验证输出原文 → 是否回滚及原因。',
].join('\n');

// ---- 官方 skill 安装命令（旗标核对：advanced-usage.md L157–162 / skill.rs L30–32） ----
const skillCommands = [
  'niu skill install --target claude            # → ~/.claude/skills/niubash/',
  'niu skill install --target zcode             # → ~/.zcode/skills/niubash/',
  'niu skill install --target cursor            # → ~/.cursor/skills/niubash/',
  'niu skill install --target all               # claude + zcode + cursor 一次装齐',
  'niu skill install --target C:/agents/skills  # 通用目录：装到 <dir>/niubash/',
  'niu skill status                             # 逐目标核对（逐字节比对 + sha256）',
].join('\n');

const verifyCmd = 'echo "SHELL=$SHELL"; uname -s; uname -a';

// ---- wpm 速览命令块（轻量区块：三五行说明 + 一个命令块足矣） ----
const wpmCmds = [
  'wpm                                # 内置包管理器，输入 wpm 即见 help',
  'wpm list                           # 看有哪些包',
  'wpm install ripgrep fd jq gawk     # 装趁手的工具',
].join('\n');

// ---- 四机制速查（来源：docs/src/agents.md「The four mechanisms」） ----
const mechanisms = [
  { no: '1', name: '$SHELL（POSIX 约定）', reads: '环境变量', covered: '是' },
  { no: '2', name: 'agent 显式配置', reads: '配置文件 / CLI 旗标', covered: '不适用，设一次即可' },
  { no: '3', name: 'Git for Windows 探针', reads: '硬编码路径，或从 git 位置推导', covered: '否' },
  { no: '4', name: '裸名 / shell 表 / 默认 PowerShell', reads: 'PATH、ComSpec、PATHEXT', covered: '部分' },
];

const verifyTable = [
  { sign: 'uname -s = MSYS_NT-…（uname -a 结尾 x86_64 Msys）', means: 'niu（winuxcmd shim）——目标状态' },
  { sign: 'uname -s = MINGW64_NT-…（MSYSTEM=MINGW64）', means: 'Git Bash' },
  { sign: 'uname -s = Linux', means: 'WSL——回落到了 System32\\bash.exe，按机制修' },
  { sign: 'uname 不存在、$SHELL 为空', means: 'PowerShell 或 cmd' },
];

// ---- 机器可读入口（四卡） ----
const machineEntries = [
  {
    href: 'https://unixwin.dev/llms.txt',
    name: '/llms.txt',
    tone: 'accent' as const,
    desc: '站点索引（llmstxt 规范）：Quick Start、六产品一句话、文档入口。',
    tag: 'text/plain',
  },
  {
    href: 'https://unixwin.dev/agents.md',
    name: '/agents.md',
    tone: 'accent' as const,
    desc: '本页的纯 markdown 机器版：安装提示词、skill 命令、四机制表、验证与陷阱。',
    tag: 'text/markdown',
  },
  {
    href: 'https://github.com/unixwin/unixwin.dev/tree/main/data/bench',
    name: 'data/bench/',
    tone: 'info' as const,
    desc: '基准产物原样入库 15 份（BENCH-README、gnu.tsv、results*.tsv、startup.tsv…）。',
    tag: 'tsv / md',
  },
  {
    href: 'https://github.com/unixwin',
    name: 'github.com/unixwin',
    tone: 'info' as const,
    desc: 'GitHub 组织：niubash、rubash、winuxcmd、unixwin.dev 等全部源码仓库。',
    tag: 'source',
  },
];

// ---- SKILL.md 摘要三卡 ----
const skillSummary = [
  {
    title: '做什么',
    lines: [
      '告诉 agent：当前会话就是 Niubash——直接跑 bash 语法，不要嵌套 pwsh / wsl / bash 包一层。',
      '核心规则：先探测再使用（command -v、niu doctor、wpm installed）；缺 Unix 命令用 wpm install。',
      '能力面：77 个 shell 内建（GNU bash 5.3 全表）、180 个 winuxcmd applet、launcher 动词与插件系统。',
      '附带 niu vs cmd vs powershell vs WSL 决策表，与 MSYS 路径/argv 逐字节原样等契约要点。',
    ],
  },
  {
    title: '包含哪些参考',
    lines: [
      'references/quickref.md — 命令总表：launcher / plugin 动词、内建全表、applet 清单（生成物）。',
      'references/paths.md — 路径契约与 MSYS 对照：C:/ 原生路径、/tmp 是真 Windows 临时目录。',
      'references/prompt-plugins.md — rc 契约、主题系统、oh-my-niu 插件包。',
      'references/wpm.md — 包管理：发现、安装、links 修复、索引流程。',
    ],
  },
  {
    title: '装到哪',
    lines: [
      'niu skill install --target claude → ~/.claude/skills/niubash/（默认目标，不带旗标同效）。',
      'zcode / cursor 各自落到 ~/.zcode/skills 与 ~/.cursor/skills 下的 niubash/。',
      '--target <目录> 为通用逃生口：装到 <目录>/niubash/，任何技能目录结构的 host 都能吃。',
      'niu skill status 逐目标核对版本；niu doctor 报 advisory「agent skill」行。',
    ],
  },
];
---

<BaseLayout
  title="给 AI 的门户：为 AI Agent 安装 niubash"
  description="给 AI 的 UNIXWIN 门户：粘贴即装的 niubash 安装提示词、官方 skill、wpm 速览与机器可读入口，支持 Claude Code、Codex、Cursor 等 24 个 AI agent。"
  keywords="install niubash for ai agents,niubash,winuxcmd,rubash,niu-git,wpm,ai agent shell,bash for windows,git bash alternative,claude code,codex,cursor,vs code,opencode,zed"
  theme="day"
  path="/ai/"
  jsonLdExtra={[
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: '首页', item: 'https://unixwin.dev/' },
        { '@type': 'ListItem', position: 2, name: '给 AI 的门户', item: 'https://unixwin.dev/ai/' },
      ],
    },
    faqJsonLd(pageFaq, 'zh'),
  ]}
>
  <SiteHeader />

  <main class="container">
    <!-- ============ a) Hero：双读者声明 + 机器版入口 ============ -->
    <section class="hero" aria-label="给 AI 的门户">
      <div class="hero-top">
        <p class="crumb">unixwin.dev/ai</p>
        <a class="md-link" href="/agents.md" title="本页的纯 markdown 机器版">
          [ view as markdown ]
        </a>
      </div>
      <h1>给 AI 的门户</h1>
      <p class="sub">
        本页同时服务两类读者：<strong>人类用户</strong>——把下面的提示词复制、粘给你自己的
        AI agent，它就会替你装好 niubash 并接线；<strong>AI agent</strong>——如果你正在直接读这页，
        按顺序执行「一键安装提示词」即可，验证输出 <code>MSYS_NT-</code> 开头就算完成。
        机器版在 <a href="/agents.md">/agents.md</a>（Content-Type text/markdown）。
      </p>
      <div class="hero-cta">
        <a class="cta-main" href="#install-prompt">让 AI 接入 niubash →</a>
        <p class="cta-note">已适配 <strong>24</strong> 个 AI agent——<strong>15</strong> 个开箱即用（<a href="/agents/">接入目录</a>）</p>
      </div>
    </section>

    <!-- ============ 醒目提示条：我们更新非常快 ============ -->
    <aside class="fast-updates" role="note" aria-label="我们更新非常快">
      <p class="fu-title">我们更新非常快</p>
      <p class="fu-body">
        性能与兼容性<strong>每天都在提升</strong>——本页数字只是快照。最新版本与变更看
        <a href="/changelog/">/changelog/</a> 与 GitHub Releases（<a
          href="https://github.com/unixwin/niubash/releases"
          target="_blank"
          rel="noopener noreferrer">github.com/unixwin/niubash/releases</a>）；
        机器可读入口 <a href="/llms.txt">/llms.txt</a>。
      </p>
    </aside>

    <!-- ============ b) 一键安装提示词（主 CTA） ============ -->
    <Section id="install-prompt" title="一键安装提示词" kicker="paste me into any agent">
      <p class="lead">
        下面这段是自包含的：任何 agent 收到它，就知道怎么装 niubash、怎么判断自己的探测机制、
        怎么接线、怎么验证、失败怎么回滚。复制后整段粘进你的 agent 会话即可。
      </p>
      <div class="codebox is-cta">
        <div class="code-head">
          <span class="code-lang">prompt · zh-CN</span>
          <span class="big-copy">
            <CopyButton copy={installPrompt} label="复制整段提示词" />
          </span>
        </div>
        <pre><code>{installPrompt}</code></pre>
      </div>
      <div class="verify-strip">
        <span class="v-label">成功长这样：</span>
        <code class="v-ok">SHELL=C:\Users\me\AppData\Local\Programs\Niubash\niu.exe</code>
        <code class="v-ok">MSYS_NT-10.0-26100 WORKSTATION 3.1.x x86_64 Msys</code>
        <span class="v-hint">Linux = WSL 回落、MINGW64_NT- = Git Bash，均需回机制排查。</span>
      </div>
    </Section>

    <!-- ============ b2) 装点趁手的工具（wpm） ============ -->
    <Section id="wpm" title="装点趁手的工具（wpm）" kicker="the built-in package manager">
      <p class="lead">
        niubash 内置 <code>wpm</code> 包管理器（随 WinuxCmd 而来）——缺什么 Unix
        命令，不出 shell 直接装。输入 <code>wpm</code> 即见 help；常用就两条：
        <code>wpm list</code> 看包、<code>{'wpm install <pkg>'}</code> 装包。
      </p>
      <div class="codebox">
        <div class="code-head">
          <span class="code-lang">bash</span>
          <CopyButton copy={wpmCmds} />
        </div>
        <pre><code>{wpmCmds}</code></pre>
      </div>
    </Section>

    <!-- ============ c) 官方 SKILL 展示 ============ -->
    <Section id="skill" title="官方 SKILL：让 agent 懂 niubash" kicker="niu skill install">
      <p class="lead">
        装完 shell，再把官方 skill 装进 agent 的技能目录——它会告诉 agent
        「会话已经是 Niubash」、路径怎么写、哪些坑不要踩。旗标来自
        niubash 文档 advanced-usage.md「AI Agent Skill Bundle」：具名目标
        <code>claude</code> / <code>zcode</code> / <code>cursor</code>、聚合 <code>all</code>、
        以及任意的通用目录。
      </p>
      <div class="codebox">
        <div class="code-head">
          <span class="code-lang">bash</span>
          <CopyButton copy={skillCommands} />
        </div>
        <pre><code>{skillCommands}</code></pre>
      </div>
      <div class="skill-grid">
        {skillSummary.map((s) => (
          <article class="skill-card">
            <h3>{s.title}</h3>
            <ul>
              {s.lines.map((line) => <li>{line}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </Section>

    <!-- ============ c2) 写一个属于你自己的 SKILL ============ -->
    <Section id="own-skill" title="写一个属于你自己的 SKILL" kicker="distill your own workflow">
      <p class="lead">
        官方 SKILL 讲的是通则；每个 agent 的接线方式、常用命令与坑都不一样——
        最好的文档是你为自己总结的那份。按四步走：
      </p>
      <ol class="steps">
        <li>
          先读 <a href="https://unixwin.github.io/niubash/agents.html" target="_blank" rel="noopener noreferrer">agents.html</a>
          与本页，弄清四机制与验证判据。
        </li>
        <li>
          实际用起来：完成安装与验证，<code>wpm</code> 装一两个趁手工具，
          再跑一段你自己的常用脚本。
        </li>
        <li>
          参考官方 SKILL（<code>niu skill install</code> 装的那份）的结构，
          <strong>自己总结一份适用于自身工作流的 SKILL</strong>——因地制宜：
          记录你自己的接线机制、常用命令、踩过的坑、验证方法。
        </li>
        <li>
          存到你自己的 skills 目录；愿意的话把成果提 PR 回馈
          <a href="https://github.com/unixwin/unixwin.dev" target="_blank" rel="noopener noreferrer">github.com/unixwin/unixwin.dev</a>。
        </li>
      </ol>
    </Section>

    <!-- ============ d) 让 agent 自己写接入 ============ -->
    <Section id="agent-template" title="让 agent 自己写接入" kicker="teach the agent to fish">
      <p class="lead">
        与其替每家 agent 抄配置，不如把方法教给它：先读四机制表，自查自己读哪种机制，
        生成对应的最小配置，跑验证，失败按备份回滚。下面这段指令模板复制后粘给 agent 即可。
      </p>
      <div class="codebox">
        <div class="code-head">
          <span class="code-lang">instruction · zh-CN</span>
          <span class="big-copy">
            <CopyButton copy={agentTemplate} label="复制指令模板" />
          </span>
        </div>
        <pre><code>{agentTemplate}</code></pre>
      </div>
      <div class="mech-wrap">
        <p class="mech-title">模板里让它对照的「四机制」速查（事实来源：agents.md）：</p>
        <table class="mech-table">
          <thead>
            <tr><th>#</th><th>机制</th><th>读什么</th><th>从 niu 会话启动即可覆盖</th></tr>
          </thead>
          <tbody>
            {mechanisms.map((m) => (
              <tr>
                <td>{m.no}</td><td>{m.name}</td><td>{m.reads}</td><td>{m.covered}</td>
              </tr>
            ))}
          </tbody>
        </table>
        <div class="verify-inline">
          <span class="v-label">验证命令：</span>
          <code>{verifyCmd}</code>
          <CopyButton copy={verifyCmd} />
          <table class="v-table">
            <tbody>
              {verifyTable.map((r) => (
                <tr><td><code>{r.sign}</code></td><td>{r.means}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </Section>

    <!-- ============ e) 机器可读入口清单 ============ -->
    <Section id="machine-entries" title="机器可读入口" kicker="for agents only">
      <div class="entry-grid">
        {machineEntries.map((e) => (
          <a class="entry-card" href={e.href} target="_blank" rel="noopener noreferrer">
            <div class="entry-top">
              <span class="entry-name">{e.name}</span>
              <Badge tone={e.tone}>{e.tag}</Badge>
            </div>
            <p class="entry-desc">{e.desc}</p>
            <span class="entry-go">打开 →</span>
          </a>
        ))}
      </div>
      <p class="hl-line">
        <strong>亮点速览：</strong>零 fork（<code>( )</code> 与 <code>$( )</code> 不建进程）·
        四方言路径（<code>C:\</code> / <code>/d/</code> / <code>/mnt/d</code> / <code>/cygdrive/d</code> 全收）·
        GNU 套件 83/83 全过 · git 启动 ~14ms · 3.79MB 单文件——
        数字细节见 <a href="/benchmarks/">/benchmarks/</a> 与 <a href="/docs/">/docs/</a>。
      </p>
    </Section>

    <!-- ============ f) 来源与免责 ============ -->
    <section class="footnote" aria-label="来源与免责">
      <p>
        <strong>事实来源：</strong>本页与 <a href="/agents.md">/agents.md</a>
        的机制、验证签名与陷阱均整理自 niubash 仓库
        <a href="https://unixwin.github.io/niubash/agents.html" target="_blank" rel="noopener noreferrer">
          docs/src/agents.md</a>（2026-10-16 校准：niu 1.4.0 / niu-git 2.55.0.5 / Git for Windows
        2.50.1）。各 agent 的探测机制互不相同且随版本变动，事实以该文档为准。
      </p>
      <p>
        <strong>免责：</strong>部分 agent（Cursor CLI、Gemini CLI、Aider 等）上游暂未开放
        shell 选择，目前无法接入——完整支持矩阵与逐家换壳脚本见
        <a href="/agents/">/agents/ 目录</a>。
      </p>
    </section>

    <FaqSection items={pageFaq} lang="zh" />
  </main>

  <SiteFooter />
</BaseLayout>

<style>
