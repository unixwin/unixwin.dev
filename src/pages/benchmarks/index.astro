---
/**
 * /benchmarks/ — 基准页（2026-10-19 校准版）。
 * 原则：有产物/PR 锚才写；输赢都展示；WSL 仅参考列。
 * 数据源：src/data/benchmarks.json；产物原样入库 data/bench/。
 */
import BaseLayout from '../../components/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Badge from '../../components/Badge.astro';
import bench from '../../data/benchmarks.json';

const h = bench.headToHead as any;
const fs = (bench._meta as any).forkSuite;
const forkRows = (fs?.rows ?? []) as any[];
const forkOnly = forkRows.filter((r) => r.tag === 'fork');
const inlineOnly = forkRows.filter((r) => r.tag === 'inline');
const maxMs = Math.max(...(h.rows as any[]).map((r) => r.gitbash));
const bar = (ms: number) => `${Math.max(2, Math.round((ms / maxMs) * 100))}%`;
const rowBar = (ms: number, base: number) => `${Math.max(2, Math.round((ms / base) * 100))}%`;
---

<BaseLayout
  title="niubash 基准：vs Git Bash / WSL / GNU bash（Git Bash alternative 实测）"
  description="niubash 基准测试（benchmark）：git 启动 3–7x、一次性执行 2.7x、提示符 git 段 4–12x 快于 Git Bash——Git Bash alternative 的实测对照；Windows 同场 8 项负载全部领先 GNU bash 与 WSL。每个数字带产物或 PR 锚，输赢都展示。"
  keywords="niubash benchmark,git bash alternative,vs git bash,gnu bash,wsl,bash benchmark,windows bash performance,bash for windows"
  theme="day"
  path="/benchmarks/"
>
  <SiteHeader />

  <main class="container">
    <section class="hero">
      <h1>数字说话<span class="cursor">▊</span></h1>
      <div class="badges">
        <Badge tone="accent">git 启动 3–7x vs Git Bash</Badge>
        <Badge tone="accent">提示符 git 段 4–12x</Badge>
        <Badge tone="accent">Windows 同场 8/8 领先</Badge>
        <Badge tone="info">体积 27x 轻量 · 零 DLL</Badge>
      </div>
      <p class="sub">每个数字都有产物或 PR 锚（逐条标注）；未实测的宣称不上这页。</p>
    </section>

    <section class="sec">
      <h2>启动 · 延迟 · 体积</h2>
      <div class="tbl-wrap">
        <table>
          <thead><tr><th>指标</th><th>niubash / rubash</th><th>对照</th><th>倍数</th><th>来源</th></tr></thead>
          <tbody>
            {(bench.latency as any[]).map((r) => (
              <tr>
                <td>{r.metric}</td>
                <td class="us">{r.us}</td>
                <td>{r.them}</td>
                <td>{r.badge ? <Badge tone="accent">{r.badge}</Badge> : '—'}</td>
                <td class="src">{r.source}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="sec">
      <h2>{h.title}</h2>
      <p class="sec-desc">
        {h.provenance.date} · rubash {h.provenance.rubash} · 方法：{h.provenance.method}。
        来源：<code>{h.provenance.source}</code>
      </p>
      <div class="tbl-wrap">
        <table>
          <thead><tr><th>负载</th><th style="width:24%">rubash vs Git Bash</th><th>rubash</th><th>Git Bash</th></tr></thead>
          <tbody>
            {(h.rows as any[]).map((r) => (
              <tr>
                <td>{r.workload}</td>
                <td>
                  <span class="bar bar-us" style={`width:${bar(r.rubash)}`}></span>
                  <span class="bar bar-them" style={`width:${bar(r.gitbash)}`}></span>
                </td>
                <td class="num us">{r.rubash.toLocaleString()} ms</td>
                <td class="num">{r.gitbash.toLocaleString()} ms</td>
                
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="foot-note">{h.note}</p>
    </section>

    {forkRows.length > 0 && (
      <section class="sec">
        <h2>
          fork / 子壳专项 <span class="vs">rubash 引擎 vs GNU bash 5.3.20</span>
          {fs.status === 'placeholder' && <Badge tone="warn">占位 · 待 TSV 转正</Badge>}
        </h2>
        <p class="sec-desc">
          {fs.provenance.date} · rubash {fs.provenance.rubash} / niu {fs.provenance.niu} · 方法：{fs.provenance.method}。
          {fs.status === 'placeholder' && <em>{fs.statusNote}</em>}
        </p>
        <div class="tbl-wrap">
          <table>
            <thead><tr><th>负载</th><th style="width:22%">bash → rubash</th><th>GNU bash</th><th>rubash</th><th>niu</th><th>倍数</th></tr></thead>
            <tbody>
              {forkOnly.map((r) => (
                <tr>
                  <td>{r.workload}</td>
                  <td>
                    <span class="bar bar-them" style={`width:${rowBar(r.bashMs, r.bashMs)}`}></span>
                    <span class="bar bar-us" style={`width:${rowBar(r.rubashMs, r.bashMs)}`}></span>
                  </td>
                  <td class="num">{r.bashMs.toLocaleString()} ms</td>
                  <td class="num us">{r.rubashMs.toLocaleString()} ms</td>
                  <td class="num">{r.niuMs.toLocaleString()} ms</td>
                  <td><Badge tone={parseFloat(r.ratioVsBash) >= 10 ? 'accent' : 'muted'}>{r.ratioVsBash}</Badge></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {inlineOnly.length > 0 && (
          <>
            <p class="sec-desc" style="margin-top:1rem">
              含内联 coreutils 收益的负载（单列，不计入 fork 战绩）：
              {inlineOnly.map((r) => `${r.workload} ${r.ratioVsBash}（${r.bashMs.toLocaleString()}→${r.rubashMs.toLocaleString()} ms）`).join('；')}。
            </p>
          </>
        )}
        <ul class="foot-note" style="list-style:disc;padding-left:1.2rem;">
          {fs.analysis.map((a: string) => <li>{a}</li>)}
        </ul>
      </section>
    )}

    <section class="sec">
      <h2>工程数字 <span class="vs">优化前 → 后，均带 PR 锚</span></h2>
      <div class="tbl-wrap">
        <table>
          <thead><tr><th>项</th><th>数字</th><th>来源</th></tr></thead>
          <tbody>
            {(bench.engineering as any[]).map((r) => (
              <tr>
                <td>{r.item}</td>
                <td class="us">{r.detail}</td>
                <td class="src">{r.source}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="sec methodology">
      <h2>方法论与来源</h2>
      <ul>
        <li>环境：{(bench._meta as any).env}；产物原样入库 <code>data/bench/</code>（15 份，含 BENCH-README.md 的环境与方法清单）</li>
        <li>纪律：未实测不写；持平与落后维度照列（单次 spawn 持平 = 真实 exec 地板；WSL 跨系统参考已移出主表）</li>
        <li>口径权威：FACTS.json（portal-dump 分支，2026-10-19）——README 与其冲突处以 FACTS 为准</li>
      </ul>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  .hero { padding: 3rem 0 1.2rem; }
  .hero h1 { font-size: clamp(2rem, 5.5vw, 3rem); margin: 0 0 1rem; }
  .badges { display: flex; gap: 0.55rem; flex-wrap: wrap; }
  .sub { color: var(--muted); margin: 0.9rem 0 0; }
  .cursor { color: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .sec { margin: 2.4rem 0; }
  .sec h2 { font-size: 1.2rem; margin: 0 0 0.5rem; }
  .vs { color: var(--muted); font-size: 0.85rem; font-weight: 400; margin-left: 0.5rem; }
  .sec-desc { color: var(--muted); font-size: 0.9rem; line-height: 1.7; margin: 0 0 0.9rem; }
  .sec-desc code { color: var(--accent-2); }

  .tbl-wrap { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
  th { text-align: left; color: var(--muted); font-weight: 600; border-bottom: 2px solid var(--border); padding: 0.5rem 0.6rem; white-space: nowrap; }
  td { border-bottom: 1px solid var(--border); padding: 0.55rem 0.6rem; vertical-align: middle; }
  td.num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  td.us { color: var(--accent); font-weight: 600; }
  td.wsl { color: var(--muted); }
  td.src { color: var(--muted); font-size: 0.8rem; max-width: 18rem; }

  .bar { display: block; height: 0.5rem; border-radius: 2px; margin: 2px 0; }
  .bar-us { background: var(--accent); }
  .bar-them { background: var(--muted); opacity: 0.55; }

  .foot-note { color: var(--muted); font-size: 0.85rem; margin: 0.8rem 0 0; line-height: 1.7; }
  .methodology ul { padding-left: 1.2rem; color: var(--muted); line-height: 1.85; font-size: 0.9rem; }
  .methodology code { color: var(--accent-2); }
</style>
