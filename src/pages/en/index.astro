---
/**
 * /en/ — English home (day/night). Mirrors src/pages/index.astro (Mintlify-style
 * visual recast): two-column Hero (copy + floating terminal carousel)
 * → stats row (header + /en/benchmarks/ link) → 3-column product cards
 * → Why 3×2 icon cards + speed recording → Install tabs → Agent glimpse
 * → Latest news.
 * All colors via tokens.css; product cards are inlined here (English labels)
 * because the shared ProductCard renders Chinese link text.
 * News data imports the same changelogs.json; summaries are quoted in the
 * original Chinese (noted inline) until per-release English blurbs exist.
 */
import BaseLayout from '../../components/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import Section from '../../components/Section.astro';
import InstallTabs from '../../components/InstallTabs.astro';
import Badge from '../../components/Badge.astro';
import CopyButton from '../../components/CopyButton.astro';
import products from '../../data/products.json';
import facts from '../../data/facts.json';
import repoMeta from '../../data/repo-meta.json';
import changelogs from '../../data/changelogs.json';

const ordered = [...products].sort((a, b) => a.order - b.order);

// ---- Stats: same facts.json numbers, English labels ----
const [identicalCount, ...identicalRest] = String(facts.byteIdentical).trim().split(/\s+/);
const stats = [
  { label: 'GNU bash suites', value: facts.bashSuites },
  { label: identicalRest.join('') ? 'suites byte-identical' : 'byte-identical', value: identicalCount },
  { label: 'Unix commands', value: facts.commands },
  { label: 'git startup', value: facts.gitStartup },
  { label: 'one-shot niu -c', value: facts.oneShot },
  { label: 'single binary', value: facts.binarySize },
];

// ---- Install: PowerShell primary / wpm / other platforms (Releases) ----
const installTabs = [
  { label: 'PowerShell', code: 'irm https://unixwin.dev/install.ps1 | iex' },
  {
    label: 'Linux',
    code: 'curl -fsSL -o niubash.tar.gz https://github.com/unixwin/niubash/releases/download/v1.4.0/niubash-v1.4.0-linux-x86_64.tar.gz && tar xzf niubash.tar.gz',
  },
  {
    label: 'macOS',
    code: 'curl -fsSL -o niubash.tar.gz https://github.com/unixwin/niubash/releases/download/v1.4.0/niubash-v1.4.0-macos-x86_64.tar.gz && tar xzf niubash.tar.gz',
  },
];

// ---- Per-card install command bar + maturity badge (same as zh home) ----
interface InstallBar {
  cmd?: string;
  note?: string;
  badge: string;
  tone: 'accent' | 'warn';
}
const installBars: Record<string, InstallBar> = {
  niubash: { cmd: 'irm https://unixwin.dev/install.ps1 | iex', badge: 'stable', tone: 'accent' },
  winuxcmd: { note: 'Preinstalled with niubash on Windows · non-niubash users: Releases', badge: 'stable', tone: 'accent' },
  rubash: { cmd: 'cargo add rubash', badge: 'beta · embeddable', tone: 'warn' },
  'niu-git': { cmd: 'git --version', badge: 'preinstalled', tone: 'accent' },
  wpm: { cmd: 'wpm install ripgrep', badge: 'built-in', tone: 'accent' },
  'oh-my-niu': { cmd: 'niu plugin list', badge: 'bundled', tone: 'accent' },
};

// ---- Latest news: newest released version per repo, first line of first
//      non-empty section, truncated at 60 chars. Summaries stay in the
//      original Chinese (flagged below) — numbers/versions/dates are shared. ----
interface ChangelogVersion {
  version: string;
  date?: string;
  unreleased?: boolean;
  sections?: Record<string, string[]>;
}
interface ChangelogRepo {
  repo: string;
  versions?: ChangelogVersion[];
}

interface NewsItem {
  productName: string;
  version: string;
  date: string;
  summary: string;
}

const productByRepo = new Map(
  ordered.map((p) => [(p.repo.split('/').pop() ?? '').toLowerCase(), p]),
);

const newsItems: NewsItem[] = [];
for (const repo of (changelogs.repos ?? []) as ChangelogRepo[]) {
  const released = (repo.versions ?? []).find(
    (v) => !v.unreleased && typeof v.date === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(v.date),
  );
  if (!released) continue;
  const firstGroup = Object.entries(released.sections ?? {}).find(
    ([name, lines]) => name.trim() !== '' && Array.isArray(lines) && lines.length > 0,
  );
  const raw = ((firstGroup?.[1] ?? [])[0] ?? '').replace(/\s+/g, ' ').trim();
  newsItems.push({
    productName: productByRepo.get(repo.repo.toLowerCase())?.name ?? repo.repo,
    version: released.version,
    date: released.date ?? '',
    summary: raw.length > 60 ? `${raw.slice(0, 60)}…` : (raw || 'See the changelog for details.'),
  });
}
newsItems.sort((a, b) => {
  if (a.date !== b.date) return a.date < b.date ? 1 : -1;
  return a.productName.localeCompare(b.productName);
});
const latestNews = newsItems.slice(0, 4);

// ---- SEO/GEO: SoftwareApplication JSON-LD; version comes from repo-meta.json (niubash latest) ----
const niubashLatest = repoMeta.repos?.niubash?.latest ?? undefined;
const softwareAppJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Niubash',
  operatingSystem: 'Windows, Linux, macOS',
  applicationCategory: 'DeveloperTool',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  ...(niubashLatest ? { softwareVersion: niubashLatest } : {}),
};
---

<BaseLayout
  title="UNIXWIN — Niubash, WinuxCmd, Rubash: the AI-native bash family"
  description="UNIXWIN: the AI-native bash family — niubash, WinuxCmd, rubash, niu-git and wpm. Real bash syntax, real Unix commands, native on Windows / Linux / macOS. No WSL, no MSYS. 83/83 GNU suites passing, 82 byte-identical, ~14 ms git startup, a 3.79 MB single binary."
  keywords="niubash,winuxcmd,rubash,niu-git,wpm,bash for windows,git bash alternative,ai-native bash"
  jsonLdExtra={softwareAppJsonLd}
  theme="day"
  path="/en/"
  lang="en"
  enPath="/"
>
  <SiteHeader />

  <main class="container">
    <!-- ============ Hero: two columns (copy / floating terminal) ============ -->
    <section class="hero" aria-label="UNIXWIN family intro">
      <div class="hero-grid">
        <div class="hero-copy">
          <h1 class="hero-wordmark">UNIXWIN</h1>
          <p class="hero-tagline">
            An AI-native family of real Bash — real syntax, real Unix commands, native on
            Windows / Linux / macOS. No WSL, no MSYS.
          </p>
          <p class="hero-tagline-en">
            AI-native 的真·Bash 家族——真语法、真 Unix 命令、原生 Windows / Linux / macOS，无 WSL、无 MSYS。
          </p>

          <div class="hero-cta">
            <a class="cta cta-primary" href="#install">Install</a>
            <a class="cta cta-ghost" href="https://github.com/unixwin" target="_blank" rel="noopener noreferrer">
              GitHub ↗
            </a>
          </div>
          <p class="hero-trust">83/83 GNU suites · 82 byte-identical · 176+ Unix commands · ~14 ms git startup</p>
        </div>

        <div class="hero-term">
          <div class="terminal">
            <div class="term-bar" aria-hidden="true">
              <span class="tdot td-r"></span>
              <span class="tdot td-y"></span>
              <span class="tdot td-g"></span>
              <span class="term-title">cmx@unixwin: ~ — 80×24</span>
            </div>
            <div class="term-body">
              <div class="term-carousel" data-term-carousel role="region" aria-label="UNIXWIN capability carousel: install · agent takeover · speed">
                <div class="term-sessions">
                  <div class="session">
                    <p class="sl sl-cmt"># install · session 1/3</p>
                    <p class="sl"><span class="p-user">PS C:\&gt;</span> irm https://unixwin.dev/install.ps1 | iex</p>
                    <p class="sl"><span class="spin" aria-hidden="true">⠿</span> downloading niubash-win-x64-setup.exe …</p>
                    <p class="sl"><span class="ok">✓</span> Niubash 1.4.0 installed</p>
                    <p class="sl"><span class="p-user">PS C:\&gt;</span> niu --version</p>
                    <p class="sl sl-out">Niubash 1.4.0 — bash-compatible shell for Windows</p>
                  </div>
                  <div class="session">
                    <p class="sl sl-cmt"># agent takeover · session 2/3</p>
                    <p class="sl"><span class="p-user">cmx@unixwin:~$</span> claude</p>
                    <p class="sl"><span class="ok">✓</span> shell: niubash (rubash engine) — $SHELL auto-detected</p>
                    <p class="sl"><span class="p-agent">agent&gt;</span> niu -c 'git log --oneline -1'</p>
                    <p class="sl sl-out">f0c0ffe niubash 1.4.0 — real syntax, real commands, native on three platforms</p>
                    <p class="sl"><span class="p-agent">agent&gt;</span> <span class="cursor" aria-hidden="true">▊</span></p>
                  </div>
                  <div class="session">
                    <p class="sl sl-cmt"># speed · session 3/3</p>
                    <p class="sl"><span class="p-user">cmx@unixwin:~$</span> time git --version</p>
                    <p class="sl sl-out">git version 2.56.0.windows.2.niugit</p>
                    <p class="sl"><span class="ok">✓</span> real 0m0.014s ← niu-git</p>
                    <p class="sl sl-out">user 0m0.006s · sys 0m0.002s</p>
                    <p class="sl sl-cmt"># Git Bash on the same machine: real 0.045s – 0.103s (3–7× slower)</p>
                  </div>
                </div>
                <div class="term-dots">
                  <button class="tdot-btn" type="button" aria-label="Session 1: install"></button>
                  <button class="tdot-btn" type="button" aria-label="Session 2: agent takeover"></button>
                  <button class="tdot-btn" type="button" aria-label="Session 3: speed"></button>
                </div>
              </div>

              <p class="t-cmd">
                <span class="t-user">cmx@unixwin:~$</span>
                <span class="cursor" aria-hidden="true">▊</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ Stats: header + one row of big-number cards ============ -->
    <div id="facts">
      <div class="stats-head">
        <h2 class="stats-title">Measured numbers · all with sources</h2>
        <a class="stats-link" href="/en/benchmarks/">Benchmarks →</a>
      </div>
      <div class="stats-row" role="list" aria-label="Project data">
        {stats.map((s) => (
          <div class="stat" role="listitem">
            <span class="stat-value">{s.value}</span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- ============ Products: 3-column large cards ============ -->
    <Section id="products" title="Product Matrix" kicker="six projects · one family">
      <div class="product-grid">
        {ordered.map((p) => {
          const bar = installBars[p.id];
          const shownStars = repoMeta.repos?.[p.id]?.stars ?? p.stars;
          return (
            <div class="product-cell">
              {/* Inlined product card (English labels); markup mirrors ProductCard.astro */}
              <a class="cell-docs" href={`/products/${p.id}/`}>Docs →</a>
              <article class="product-card" id={p.id} style={`--card-accent: ${p.accent};`}>
                <header class="card-head">
                  <span class="card-bar" aria-hidden="true"></span>
                  <h3 class="card-name">{p.name}</h3>
                  <Badge tone="muted">{p.lang}</Badge>
                </header>
                <p class="card-tagline">{p.tagline_en}</p>
                <p class="card-tagline-en">{p.tagline_zh}</p>
                <footer class="card-foot">
                  <code class="card-cmd" title="CLI entry">$ {p.cmd}</code>
                  <span class="card-stars" title="GitHub Stars">★ {shownStars}</span>
                  <a class="card-repo" href={`https://${p.repo}`} target="_blank" rel="noopener noreferrer">repo ↗</a>
                </footer>
              </article>
              {bar && (
                <div class="cell-install">
                  <Badge tone={bar.tone}>{bar.badge}</Badge>
                  {bar.cmd && <code class="cell-cmd" title={bar.cmd}>{bar.cmd}</code>}
                  {bar.cmd && <CopyButton copy={bar.cmd} label="copy" />}
                  {bar.note && <span class="cell-note">{bar.note}</span>}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </Section>

    <!-- ============ Why: 3×2 icon cards ============ -->
    <Section id="why" title="Why UNIXWIN" kicker="why --real --fast --native">
      <div class="why-grid">
        <article class="why-card">
          <span class="why-num" aria-hidden="true">01</span>
          <span class="why-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3l7 2.7v5.6c0 4.2-2.9 7.2-7 8.7-4.1-1.5-7-4.5-7-8.7V5.7L12 3z" />
              <path d="M9.2 11.9l2 2 3.6-3.7" />
            </svg>
          </span>
          <h3 class="why-title">Truly compatible</h3>
          <p class="why-body">
            All <strong>83</strong> upstream GNU Bash test suites pass, and <strong>82</strong> of
            them produce byte-identical output — the one remaining delta was proven byte-for-byte
            to be a race in GNU's own code. Existing scripts run unmodified.
          </p>
          <code class="why-chip">suites 83/83 · byte-identical 82</code>
        </article>
        <article class="why-card">
          <span class="why-num" aria-hidden="true">02</span>
          <span class="why-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M13 2L4.6 13.4h6.2L9.8 22l8.6-11.4h-6.2L13 2z" />
            </svg>
          </span>
          <h3 class="why-title">Zero fork</h3>
          <p class="why-body">
            <code>( )</code> and <code>$( )</code> create <strong>zero processes</strong> —
            subshells complete in-process, with fd inheritance, shared offsets, exit codes and
            signal disposition matching GNU. One model on every platform, no POSIX emulation layer.
          </p>
          <code class="why-chip">( ) $( ) → 0 processes</code>
        </article>
        <article class="why-card">
          <span class="why-num" aria-hidden="true">03</span>
          <span class="why-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 5.4L3.6 7.3v11.3L9 16.7l6 1.9 5.4-1.9V5.4L15 7.3 9 5.4z" />
              <path d="M9 5.4v11.3" />
              <path d="M15 7.3v11.3" />
            </svg>
          </span>
          <h3 class="why-title">Every path dialect</h3>
          <p class="why-body">
            <code>C:\</code>, <code>D:/</code>, <code>/d/</code>, <code>/mnt/d</code>,
            <code>/cygdrive/d</code> — one shell accepts the path notations of <strong>four
            ecosystems</strong> and genuinely folds them together. Switch shells without
            rewriting your scripts.
          </p>
          <code class="why-chip">C:\ · /d/ · /mnt/d · /cygdrive/d</code>
        </article>
        <article class="why-card">
          <span class="why-num" aria-hidden="true">04</span>
          <span class="why-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10 11h-4a3 3 0 0 1 0-6h1a3 3 0 0 1 3 3v3a7 7 0 0 1-7 7" />
              <path d="M21 11h-4a3 3 0 0 1 0-6h1a3 3 0 0 1 3 3v3a7 7 0 0 1-7 7" />
            </svg>
          </span>
          <h3 class="why-title">No MSYS incantations</h3>
          <p class="why-body">
            Git Bash heuristically rewrites your arguments before spawn, so you end up learning
            <code>MSYS_NO_PATHCONV</code>. niu ships no MSYS runtime — argv <strong>arrives
            byte-for-byte as typed</strong>. That variable doesn't exist here because it doesn't
            need to.
          </p>
          <code class="why-chip">argv verbatim</code>
        </article>
        <article class="why-card">
          <span class="why-num" aria-hidden="true">05</span>
          <span class="why-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="9" width="14" height="9.5" rx="2.2" />
              <path d="M12 9V5.6" />
              <circle cx="12" cy="4.2" r="1.3" />
              <path d="M9.4 13.2v.7" />
              <path d="M14.6 13.2v.7" />
              <path d="M9.2 16.3h5.6" />
              <path d="M5 12.2H3.2" />
              <path d="M20.8 12.2H19" />
            </svg>
          </span>
          <h3 class="why-title">AI-native</h3>
          <p class="why-body">
            Launch Claude Code, Codex or Cursor from a niu session and the agent picks up niubash
            through the <code>$SHELL</code> convention; <code>niu -c</code> runs a single command
            with deterministic output, built for agents' repeated calls and parsing.
          </p>
          <code class="why-chip">niu -c 'ls | grep src'</code>
        </article>
        <article class="why-card">
          <span class="why-num" aria-hidden="true">06</span>
          <span class="why-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5.2 17.6a8.6 8.6 0 1 1 13.6 0" />
              <path d="M12 13.6l3.4-3.4" />
              <circle cx="12" cy="13.6" r="1.2" />
            </svg>
          </span>
          <h3 class="why-title">Fast</h3>
          <p class="why-body">
            <code>git --version</code> in about <strong>~14 ms</strong> where Git Bash needs
            45–103 ms; the prompt reads <code>.git/HEAD</code> directly (≤29 ms) while the other
            shell pays a 113–362 ms git tax on every single prompt.
          </p>
          <code class="why-chip">git ~14ms · prompt ≤29ms</code>
        </article>
      </div>

      <figure class="demo-fig">
        <img
          src="/assets/demo-gitbash.gif"
          alt="Recorded run: Git Bash's MSYS runtime rewrites arguments and breaks cd, cmd /c and git grep -n in turn"
          width="692"
          height="334"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          Recorded in Git Bash: <code>cd</code>, <code>cmd /c</code> and <code>git grep -n</code>
          break one after another as the MSYS runtime rewrites their arguments — niu has no MSYS
          layer; argv arrives byte-for-byte, so this class of failure does not exist (see the
          "no MSYS incantations" card).
        </figcaption>
      </figure>
    </Section>

    <!-- ============ Install ============ -->
    <Section id="install" title="Quick Install" kicker="quick start · one line">
      <InstallTabs id="install" tabs={installTabs} />
      <ul class="install-notes">
        <li>
          <strong>Linux / macOS</strong>: grab the portable bundle from GitHub Releases and unpack
          it (pick the aarch64 asset on ARM machines); the Windows installer bundles WinuxCmd
          (wpm included) plus niu-git / ripgrep / fd / gawk —
           (gawk is x64-only; ARM64 installs ship niugit, ripgrep and fd). <a href="https://github.com/unixwin/niubash/releases" target="_blank" rel="noopener noreferrer">
            github.com/unixwin/niubash/releases
          </a>.
        </li>
        <li>wpm ships inside WinuxCmd (type <code>wpm</code> for help); install packages like <code>wpm install ripgrep</code>, self-upgrade with <code>wpm update winuxcmd</code>.</li>
        <li>
          Installs with <Badge tone="info">no admin rights</Badge>; PATH and a Windows Terminal profile are set up for you · docs at
          <a href="https://unixwin.github.io/niubash/" target="_blank" rel="noopener noreferrer">
            unixwin.github.io/niubash/
          </a>.
        </li>
      </ul>
    </Section>

    <!-- ============ Agent glimpse ============ -->
    <Section id="agent" title="The Agent Story, at a Glance" kicker="niu × claude code">
      <div class="codeblock agent-block" role="img" aria-label="niubash and Claude Code session demo">
        <p class="al">
          <span class="p-user">$</span> claude <span class="c-mute"># launched from a niu session; $SHELL already points at niubash</span>
        </p>
        <p class="al">
          <span class="c-ok">✓</span> shell: niubash (rubash engine) — 14ms git, 176+ unix commands
        </p>
        <p class="al">
          <span class="p-agent">agent&gt;</span> niu -c 'ls | grep src'
        </p>
        <p class="al al-out">src</p>
        <p class="al">
          <span class="p-agent">agent&gt;</span> niu -c 'git log --oneline -1'
        </p>
        <p class="al al-out">f0c0ffe niubash 1.4.0 — real syntax, real commands, native on three platforms</p>
        <p class="al">
          <span class="p-agent">agent&gt;</span> <span class="cursor" aria-hidden="true">▊</span>
        </p>
      </div>
      <p class="agent-note">
        Once your agent runs on niubash, every command executes with real bash syntax —
        deterministic output, fast startup, nothing falling over in long sessions. How each agent
        is launched and wired is covered in the
        <a href="https://unixwin.github.io/niubash/agents.html" target="_blank" rel="noopener noreferrer">detection-mechanism docs</a>.
      </p>
    </Section>

    <!-- ============ Latest news ============ -->
    <Section id="news" title="Latest News" kicker="tail -f changelogs.json">
      {latestNews.length > 0 ? (
        <ul class="news-list" role="list">
          {latestNews.map((n) => (
            <li class="news-item" role="listitem">
              <p class="news-line">
                <Badge tone="accent">{n.productName}</Badge>
                <span class="news-version">{n.version}</span>
                <time class="news-date" datetime={n.date}>{n.date}</time>
              </p>
              <p class="news-summary">{n.summary}</p>
            </li>
          ))}
        </ul>
      ) : (
        <p class="news-empty">Changelogs haven't been fetched yet — run <code>npm run fetch:github</code>.</p>
      )}
      <p class="news-src-note">Release notes are quoted from the original Chinese changelogs.</p>
      <p class="news-more"><a href="/en/changelog/">Full changelog →</a></p>
    </Section>
  </main>

  <SiteFooter />
</BaseLayout>

<style>
  /* ---------- Page backdrop: faint accent radial at the very top of body ---------- */
  :global(body) {
    background:
      radial-gradient(56rem 26rem at 50% -8%, color-mix(in srgb, var(--accent) 4%, var(--bg)), var(--bg) 72%),
      var(--bg);
    background-repeat: no-repeat;
  }

  /* ---------- Hero: two columns + fine grid confined to this section ---------- */
  .hero {
    position: relative;
    padding: 3.6rem 0 0.5rem;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: -4rem 0 0;
    background:
      radial-gradient(52rem 26rem at 16% 0%, color-mix(in srgb, var(--accent) 8%, var(--bg)), var(--bg) 70%),
      radial-gradient(40rem 22rem at 90% 10%, color-mix(in srgb, var(--accent-2) 6%, var(--bg)), var(--bg) 70%);
    z-index: -1;
    pointer-events: none;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(0deg, color-mix(in srgb, var(--text) 4%, transparent) 0 1px, transparent 1px 30px),
      repeating-linear-gradient(90deg, color-mix(in srgb, var(--text) 4%, transparent) 0 1px, transparent 1px 30px);
    -webkit-mask-image: radial-gradient(58rem 30rem at 62% 6%, var(--text), transparent 72%);
    mask-image: radial-gradient(58rem 30rem at 62% 6%, var(--text), transparent 72%);
    z-index: -1;
    pointer-events: none;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: 3.5rem;
    align-items: center;
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-wordmark {
    font-family: var(--font-mono);
    font-size: clamp(2.7rem, 5.2vw, 3.4rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: 0.06em;
    margin: 0 0 1.1rem;
    background: linear-gradient(92deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-tagline {
    font-size: 1.18rem;
    line-height: 1.65;
    margin: 0 0 0.5rem;
    max-width: 34em;
  }

  .hero-tagline-en {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.6;
    margin: 0;
    max-width: 34em;
  }

  .hero-cta {
    display: flex;
    gap: 0.9rem;
    margin: 1.7rem 0 0;
    flex-wrap: wrap;
  }

  .hero-trust {
    margin: 1.15rem 0 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
  }

  /* ---------- CTA system: primary solid / secondary outline, 44px tall ---------- */
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    border-radius: var(--radius);
    padding: 0.65rem 1.6rem;
    font-family: var(--font-mono);
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-decoration: none;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease,
      box-shadow 0.2s ease, transform 0.2s ease;
  }

  .cta:hover {
    text-decoration: none;
  }

  .cta-primary {
    background: var(--accent);
    color: var(--bg);
    border: 1px solid var(--accent);
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--accent) 30%, transparent),
      0 8px 20px -8px color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .cta-primary::before {
    content: '$ ';
    opacity: 0.85;
  }

  .cta-primary:hover {
    background: color-mix(in srgb, var(--accent) 92%, var(--text));
    border-color: color-mix(in srgb, var(--accent) 92%, var(--text));
    transform: translateY(-1px);
  }

  .cta-ghost {
    color: var(--text);
    border: 1px solid var(--border);
    background: transparent;
  }

  .cta-ghost:hover {
    background: var(--bg-elev);
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-1px);
  }

  /* ---------- Terminal window: floating shadow, full column width ---------- */
  .hero-term {
    min-width: 0;
  }

  .terminal {
    background: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--text) 6%, transparent),
      0 16px 32px -12px color-mix(in srgb, var(--text) 12%, transparent),
      0 32px 80px -24px color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.9rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-elev);
  }

  .tdot {
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 50%;
  }

  .td-r {
    background: var(--danger);
  }

  .td-y {
    background: var(--warn);
  }

  .td-g {
    background: var(--accent);
  }

  .term-title {
    margin-left: auto;
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
  }

  .term-body {
    position: relative;
    padding: 1.3rem 1.5rem 1.5rem;
  }

  /* CRT scanlines (1px line / 3px period), both layers mixed from tokens */
  .term-body::after {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      to bottom,
      color-mix(in srgb, var(--bg) 60%, var(--bg-code)) 0 1px,
      var(--bg-code) 1px 3px
    );
    pointer-events: none;
  }

  .term-body > * {
    position: relative;
    z-index: 1;
  }

  .t-cmd {
    margin: 0 0 0.9rem;
    font-size: 0.95rem;
  }

  .term-body > .t-cmd:last-child {
    margin: 1.3rem 0 0;
  }

  .t-user {
    color: var(--accent);
    font-weight: 700;
  }

  .t-cmd .cursor {
    color: var(--accent);
  }

  /* ---------- Hero 3-session carousel ---------- */
  .term-carousel {
    margin: 0 0 1.4rem;
  }

  .term-sessions {
    display: grid;
  }

  /* No-JS fallback: sessions stack vertically, all text readable (full SEO) */
  .session:not(:last-child) {
    margin-bottom: 1.15rem;
  }

  .sl {
    margin: 0 0 0.28rem;
    font-size: 0.92rem;
    white-space: pre-wrap;
    word-break: break-word;
    font-variant-numeric: tabular-nums;
  }

  .sl:last-child {
    margin-bottom: 0;
  }

  .sl-cmt {
    color: var(--muted);
    font-size: 0.78rem;
  }

  .sl-out {
    color: var(--muted);
  }

  .spin {
    color: var(--accent-2);
    animation: blink 1.1s steps(1) infinite;
  }

  .ok {
    color: var(--accent);
    font-weight: 700;
    white-space: nowrap;
  }

  /* JS adds .is-live: sessions stacked in one grid cell, fade carousel + print-in */
  .term-carousel.is-live .session {
    grid-area: 1 / 1;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0s linear 0.4s;
  }

  .term-carousel.is-live .session.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.4s ease;
  }

  .term-carousel.is-live .session.is-active .sl {
    animation: print-in 0.32s ease-out both;
  }

  .term-carousel.is-live .session.is-active .sl:nth-child(1) { animation-delay: 0.05s; }
  .term-carousel.is-live .session.is-active .sl:nth-child(2) { animation-delay: 0.17s; }
  .term-carousel.is-live .session.is-active .sl:nth-child(3) { animation-delay: 0.31s; }
  .term-carousel.is-live .session.is-active .sl:nth-child(4) { animation-delay: 0.47s; }
  .term-carousel.is-live .session.is-active .sl:nth-child(5) { animation-delay: 0.63s; }
  .term-carousel.is-live .session.is-active .sl:nth-child(6) { animation-delay: 0.79s; }

  @keyframes print-in {
    from {
      opacity: 0;
      transform: translateY(0.28em);
    }
  }

  /* Dot indicators: hidden without JS (nothing to switch) */
  .term-dots {
    display: none;
  }

  .term-carousel.is-live .term-dots {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin: 0.95rem 0 0;
  }

  .tdot-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.15rem;
    height: 1.15rem;
    padding: 0;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 50%;
    cursor: pointer;
  }

  .tdot-btn::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--border);
    transition: background 0.2s, box-shadow 0.2s;
  }

  .tdot-btn:hover::before {
    background: var(--muted);
  }

  .tdot-btn:focus-visible {
    border-color: var(--accent);
    outline: none;
  }

  .tdot-btn.is-on::before {
    background: var(--accent);
    box-shadow: 0 0 0.45rem color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .cursor {
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* ---------- Section rhythm: 4.5rem between sections; kicker/title recast ---------- */
  main.container > :global(.section) {
    margin: 4.5rem 0;
  }

  main.container > :global(.section) :global(.kicker) {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.7rem;
  }

  main.container > :global(.section) :global(.kicker)::before {
    content: '';
    display: inline-block;
    width: 1.5rem;
    height: 2px;
    border-radius: 1px;
    background: linear-gradient(90deg, var(--accent), var(--accent-2));
    flex-shrink: 0;
  }

  main.container > :global(.section) :global(.section-title) {
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin: 0 0 1.4rem;
  }

  main.container > :global(.section) :global(.section-title)::after {
    display: none;
  }

  /* ---------- Stats: header + one row of big-number cards ---------- */
  #facts {
    scroll-margin-top: 5rem;
    margin: 4.5rem 0;
  }

  .stats-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 0 0 1.3rem;
  }

  .stats-title {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
  }

  .stats-link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
  }

  .stats-row {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.15rem 1.2rem;
    transition: border-color 0.2s ease;
  }

  .stat:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }

  .stat-value {
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
    color: var(--accent);
    line-height: 1.1;
    letter-spacing: -0.01em;
    font-variant-numeric: tabular-nums;
  }

  .stat-label {
    color: var(--muted);
    font-size: 0.8rem;
    line-height: 1.4;
  }

  /* ---------- Products: 3-column large cards (≥1200px), cell is the card ---------- */
  .product-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 310px), 1fr));
    gap: 1.4rem;
  }

  .product-cell {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.45rem 1.45rem 1.3rem;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .product-cell:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: 0 12px 28px -14px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  /* Inlined ProductCard (English labels) rendered transparent inside the cell */
  .product-cell > .product-card {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    background: transparent;
    border: none;
    box-shadow: none;
    padding: 0;
  }

  .card-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .card-bar {
    width: 6px;
    align-self: stretch;
    border-radius: 3px;
    background: var(--card-accent, var(--accent));
  }

  .card-name {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 1.15rem;
    font-weight: 700;
  }

  .card-tagline {
    margin: 0;
    color: var(--text);
    font-size: 0.95rem;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    line-height: 1.5;
    min-height: 3em;
  }

  .card-tagline-en {
    margin: 0;
    color: var(--muted);
    font-size: 0.82rem;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
    overflow: hidden;
  }

  .card-foot {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
  }

  .card-cmd {
    background: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 0.66);
    padding: 0.12rem 0.6rem;
    color: var(--card-accent, var(--accent));
  }

  .card-stars {
    color: var(--warn);
    font-family: var(--font-mono);
  }

  .card-repo {
    margin-left: auto;
    color: var(--link);
  }

  .cell-note {
    color: var(--muted);
    font-size: 0.8rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .cell-docs {
    align-self: flex-start;
    font-size: 0.82rem;
    color: var(--link);
    text-decoration: none;
    margin-top: 0.15rem;
  }

  .cell-docs:hover {
    text-decoration: underline;
  }

  .cell-install {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.15rem;
    background: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: calc(var(--radius) * 0.8);
    padding: 0.45rem 0.5rem 0.45rem 0.7rem;
  }

  .cell-install :global(.badge) {
    flex-shrink: 0;
  }

  .cell-cmd {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text);
    font-size: 0.8rem;
  }

  .cell-install :global(.copy-btn) {
    flex-shrink: 0;
    padding: 0.08rem 0.5rem;
    font-size: 0.72rem;
  }

  /* ---------- Why: 3×2 icon cards ---------- */
  .why-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 270px), 1fr));
    gap: 1.4rem;
  }

  .why-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem 1.5rem 1.35rem;
    transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .why-card:hover {
    transform: translateY(-3px);
    border-color: var(--accent);
    box-shadow: 0 10px 24px -14px color-mix(in srgb, var(--accent) 30%, transparent);
  }

  .why-num {
    position: absolute;
    top: 1.1rem;
    right: 1.25rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1;
    color: color-mix(in srgb, var(--text) 7%, transparent);
    pointer-events: none;
  }

  .why-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 46px;
    height: 46px;
    margin-bottom: 0.4rem;
    border-radius: calc(var(--radius) * 0.85);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 22%, transparent);
  }

  .why-icon svg {
    width: 26px;
    height: 26px;
  }

  .why-title {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 700;
  }

  .why-body {
    margin: 0;
    color: var(--text);
    font-size: 0.9rem;
    line-height: 1.65;
    flex: 1;
  }

  .why-body strong {
    color: var(--accent);
    font-weight: 700;
  }

  .why-chip {
    align-self: flex-start;
    margin-top: 0.35rem;
    background: var(--bg-code);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    color: var(--accent);
    font-size: 0.75rem;
    white-space: nowrap;
    max-width: 100%;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .demo-fig {
    margin: 2rem 0 0;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.2rem 1.2rem 1rem;
    text-align: center;
    box-shadow: var(--shadow);
  }

  .demo-fig img {
    display: inline-block;
    width: 100%;
    max-width: 692px;
    height: auto;
    border-radius: calc(var(--radius) * 0.8);
  }

  .demo-fig figcaption {
    margin-top: 0.7rem;
    color: var(--muted);
    font-size: 0.85rem;
  }

  /* ---------- Install ---------- */
  .install-notes {
    list-style: none;
    margin: 1.1rem 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .install-notes strong {
    color: var(--text);
  }

  /* ---------- Agent glimpse ---------- */
  .agent-block {
    font-size: 0.92rem;
    line-height: 1.7;
  }

  .al {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }

  .al-out {
    color: var(--muted);
  }

  .p-user {
    color: var(--accent);
    font-weight: 700;
  }

  .p-agent {
    color: var(--accent-2);
    font-weight: 700;
  }

  .c-ok {
    color: var(--accent);
    font-weight: 700;
  }

  .c-mute {
    color: var(--muted);
  }

  .agent-block .cursor {
    color: var(--accent-2);
  }

  .agent-note {
    margin: 0.9rem 0 0;
    color: var(--muted);
    font-size: 0.9rem;
  }

  /* ---------- Latest news ---------- */
  .news-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .news-item {
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.95rem 1.2rem;
    transition: border-color 0.2s ease;
  }

  .news-item:hover {
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
  }

  .news-line {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    flex-wrap: wrap;
  }

  .news-version {
    color: var(--accent-2);
    font-family: var(--font-mono);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .news-date {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-variant-numeric: tabular-nums;
  }

  .news-summary {
    margin: 0.4rem 0 0;
    color: var(--text);
    font-size: 0.9rem;
  }

  .news-empty {
    color: var(--muted);
  }

  .news-src-note {
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .news-more {
    margin: 1rem 0 0;
    font-size: 0.9rem;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 960px) {
    .hero {
      padding-top: 2.8rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2.4rem;
    }
  }

  @media (min-width: 1200px) {
    .product-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .why-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 680px) {
    .stats-row {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1120px) {
    .stats-row {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  @media (max-width: 640px) {
    .term-body {
      padding: 1.05rem 1rem 1.25rem;
    }

    .sl {
      font-size: 0.85rem;
    }

    .sl-cmt {
      font-size: 0.72rem;
    }

    .cell-install {
      gap: 0.4rem;
      padding: 0.4rem 0.36rem 0.4rem 0.55rem;
    }

    .why-num {
      font-size: 1.6rem;
      top: 1.2rem;
    }
  }

  /* ---------- prefers-reduced-motion ---------- */
  @media (prefers-reduced-motion: reduce) {
    .cursor,
    .spin {
      animation: none;
    }

    .cta,
    .stat,
    .why-card,
    .product-cell,
    .news-item {
      transition: none;
    }

    .cta:hover,
    .why-card:hover,
    .product-cell:hover {
      transform: none;
    }

    .term-carousel.is-live .session,
    .term-carousel.is-live .session.is-active {
      transition: none;
    }

    .term-carousel.is-live .session.is-active .sl {
      animation: none;
    }

    .tdot-btn::before {
      transition: none;
    }
  }
</style>

<script>
  // Hero terminal carousel (minimal vanilla JS), mirroring the zh home page:
  // .is-live enables same-cell stacking + timed switching; without JS the three
  // sessions stay stacked and fully readable. Reduced motion: manual dots only.
  const root = document.querySelector<HTMLElement>('[data-term-carousel]');
  if (root) {
    const sessions = Array.from(root.querySelectorAll<HTMLElement>('.session'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.tdot-btn'));
    if (sessions.length > 1 && dots.length === sessions.length) {
      const DWELL_MS = 6000;
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let index = 0;
      let timer: number | undefined;

      const stop = (): void => {
        if (timer !== undefined) {
          window.clearInterval(timer);
          timer = undefined;
        }
      };

      const show = (next: number): void => {
        index = ((next % sessions.length) + sessions.length) % sessions.length;
        sessions.forEach((session, i) => session.classList.toggle('is-active', i === index));
        dots.forEach((dot, i) => {
          dot.classList.toggle('is-on', i === index);
          if (i === index) dot.setAttribute('aria-current', 'true');
          else dot.removeAttribute('aria-current');
        });
      };

      const play = (): void => {
        stop();
        if (!reducedMotion) timer = window.setInterval(() => show(index + 1), DWELL_MS);
      };

      dots.forEach((dot, i) => dot.addEventListener('click', () => { show(i); play(); }));
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', play);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', stop);

      root.classList.add('is-live');
      show(0);
      play();
    }
  }
</script>
