  .term-carousel.is-live .session.is-active .sl:nth-child(2) { animation-delay: 0.17s; }
  .term-carousel.is-live .session.is-active .sl:nth-child(3) { animation-delay: 0.31s; }
  .term-carousel.is-live .session.is-active .sl:nth-child(4) { animation-delay: 0.47s; }
