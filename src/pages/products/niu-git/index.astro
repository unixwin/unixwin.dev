];

const bench: Row[] = [
  {
    a: 'git --version',
    b: '13.7 ms 均值 / 11.5 ms 最小（约 ~14 ms）',
    c: 'Git Bash 45–103 ms',
    src: 'niu-git README Speed 表（2026-10 实测）',
  },
  {
    a: 'git status --porcelain',
    b: '22.6 ms 均值 / 17.4 ms 最小',
    c: 'GfW cmd\\git.exe 50.1 ms 均值',
    src: '同上',
  },
  {
    a: '安装体积',
    b: 'bundle 29 MB / zip 33 MB',
    c: 'MinGit zip 37 MB',
    src: 'niu-git README Status 节',
  },
  {
    a: '上游 t/ 套件（curated subset）',
    b: '2861 ok / 0 硬失败',
    c: '14 例 # TODO known breakage',
    src: 'niu-git README Test 节',
  },
  {
    a: 'launcher 引号差分',
    b: '49/49 通过',
    c: '—',
