const updateSelf = 'wpm update winuxcmd';
const firstRun = [
  '# Open a fresh terminal (so PATH takes effect), then:',
  'winuxcmd --version          # confirm the active binary and version',
  'ls --help                   # the GNU help surface of any command',
  'winuxcmd --list-all         # flat list of all 176 commands (bare winuxcmd groups coreutils-style)',
  'wpm index update            # refresh the package index (wpm is built in; see /en/products/wpm/)',
].join('\n');

const categories = [
  { cat: 'GNU Coreutils', count: '83', cmds: 'cp mv rm ln mkdir touch · cat head tail sort uniq cut tr wc · ls dir vdir · base64 md5sum sha256sum cksum · date seq expr env …' },
  { cat: 'findutils / grep / sed', count: '3', cmds: 'find (88 options), grep (49 options, PCRE2), sed (17 options, in-place -i)' },
  { cat: 'BSD tools', count: '15', cmds: 'cal column hexdump logger tree less more strings rev watch tput …' },
  { cat: 'Process management', count: '13', cmds: 'ps top kill killall pgrep pkill pidof pldd free uptime renice stdbuf timeout' },
  { cat: 'Cygwin / MSYS2 bridge', count: '14', cmds: 'cygpath dos2unix unix2dos d2u u2d … (migration-era spelling compatibility)' },
  { cat: 'System information', count: '16', cmds: 'hostname id who pinky stty locale getconf getfacl ldd lsof file man …' },
  { cat: 'First-party extensions', count: '10+', cmds: 'wpm (package manager) mpicalc regtool mkpasswd mkgroup mkfifo mknod clear reset tzset' },
];

const factRows = [
  { metric: 'Single-file size', value: '3.79 MB (carrying 176 commands / 1,924 options; statically linked, zero dependencies)', src: 'WinuxCmd README.md:74' },
  { metric: 'Cold start', value: '~19 ms', src: 'WinuxCmd README.md:74' },
  { metric: 'PGO gains', value: 'sort −18% · nl −17% (x64 release builds, trained on real workloads)', src: 'WinuxCmd README.md:74 · scripts/build-pgo.ps1' },
  { metric: 'Quality gates', value: '178-case differential 93% (165 pass / 13 platform deltas named on record) · 2,420 unit tests 99.6%', src: 'README.md · tests/differential/baseline.json' },
  { metric: 'Workload contrasts', value: 'cat 100 MB 0.8 s · sort 1M lines 2.1 s · grep 100 MB 1.2 s · find 10K files 0.3 s (~10–15% behind GNU/WSL2)', src: 'README.md Benchmarks (Win11 · i7-13700K · 32 GB · NVMe)' },
];

const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'WinuxCmd',
  applicationCategory: 'DeveloperTool',
  operatingSystem: 'Windows, Linux, macOS',
  description: "Native Windows implementation of Unix commands — 176 commands in one ~3.79 MB binary",
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
