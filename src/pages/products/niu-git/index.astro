const news: News[] = [
  {
    version: 'v2.56.0.1',
    date: '—',
    summary:
      '最新 tag：上游基线推进到 git 2.56.0.windows.2，git --version 携带 2.56.0.windows.2.niugit 分布标记（repo-meta 2026-10-19 实测；无 release 页，tag 即版本）。',
  },
  {
    version: 'v2.55.0.5',
    date: '—',
    summary:
      'dispatcher 退役：patch #3 自定位让真 mingw64/bin/git.exe 直映 usr\\bin\\git.exe，wpm flat 实测 git --version 13.7 ms 均值、git status 22.6 ms；wpm/niugit.json 即此版索引条目（sha256/size 与本地构建对齐）。',
  },
  {
    version: 'v2.55.0.windows.2',
    date: '—',
    summary:
      'Phase 0 PoC 定稿：MSVC + CMake + vcpkg 构建 git-for-windows v2.55.0.windows.2，zlib/iconv 静态链接，bundle 29 MB；init/add/commit/log/status、schannel https clone、经 PATH 上 sh 执行 hooks 全部验证。',
