}
const whyCards: WhyCard[] = [
  {
    tag: '内建',
    title: '不是外挂程序',
    body: 'wpm 以 C++ 实现并编译进 winuxcmd.exe 本体——没有 Node.js、Python 或 .NET 运行时依赖；装了 WinuxCmd，就有 wpm。',
  },
  {
