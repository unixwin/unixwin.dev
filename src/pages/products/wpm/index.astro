// —— 安装与首跑命令 ——
const installWinuxNote = 'wpm 随 winuxcmd.exe 内建——装好 WinuxCmd（或 niubash）即有，无需单独安装';
const quickStart = [
  'wpm index update                 # 刷新官方索引',
  'wpm install ripgrep fd jq        # 一次装多个包（rg / fd / jq 上 PATH）',
  'wpm installed                    # 本机已装清单',
  'wpm info ripgrep --json          # 完整包记录（机器可读）',
].join('\n');
const cnMirror = 'wpm source use official-cn';

// —— 为什么：4 卡 ——
interface WhyCard {
