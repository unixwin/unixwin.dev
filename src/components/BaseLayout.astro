---
/**
 * BaseLayout — 全站页面外壳。
 *
 * Props:
 *   title       string  页面 <title>（会自动拼接 " · UNIXWIN"）
 *   description string  页面 meta description
 *   theme       'day' | 'night'   写入 <html data-theme>（默认 day）
 *   path        string  规范化路径（如 '/'、'/changelog/'），用于 canonical/hreflang
 *   lang        'zh' | 'en'  页面语言（默认 zh；写 <html lang> 与 og:locale）
 *   enPath      string  另一语言页路径：zh 页传对应 en 路径、en 页传回 zh 路径，
 *                       用于 hreflang 互链。缺省时按 src/i18n/lang.ts 的配对
 *                       清单自动推断（zh 页在清单内且未传 enPath 的行为一致）。
 *   keywords    string  逗号分隔的 SEO/GEO 关键字 → 输出 <meta name="keywords">。
 *                       （可选；缺省不输出该 meta，保持既有页面行为不变。）
 *   jsonLdExtra object | object[]  页面对象（如 SoftwareApplication、BreadcrumbList、
 *                       FAQPage）→ 多个时包成 @graph，作为第二个
 *                       <script type="application/ld+json"> 与现有 Organization
 *                       JSON-LD 并列输出。（可选；缺省只输出 Organization。）
 *   ogImage     string  本页 OG/Twitter 图 URL（可选；缺省 /og-image.png；
 *                       产品页传 /og/<id>.png，issue #18）。
 *   noindex     boolean true 时不输出 canonical/hreflang，改输出
 *                       <meta name="robots" content="noindex">（404 页用，issue #16）。
 *
 * 亮/暗（day/night）：<head> 顶部跑一段 is:inline 防 FOUC
 * 脚本（改编自 astrowind ApplyColorMode，MIT，见 THIRD_PARTY_NOTICES.md）——
 * localStorage('unixwin-theme') 优先，其次 prefers-color-scheme，把 SSR 输出的
 * data-theme 纠正为用户实际选择的亮/暗后再首绘。静态站全页刷新，无需监听。
 *
 * hreflang：有配对时 zh-CN → zh 路径、en → en 路径、x-default → zh 路径；
 * 无配对页（如 /changelog/）三条回落 canonical（保持原行为）。
 * 自动跳转：仅「zh 页且存在对应 en 页」引入 src/i18n/auto-redirect.astro
 * （每会话一次按 navigator.language 跳 /en/，sessionStorage.niu-lang-override 优先）。
 *
 * 示例：
 *   <BaseLayout title="首页" description="AI-native bash" theme="day" path="/">
 *     <p>内容</p>
 *   </BaseLayout>
 */
import '../styles/tokens.css';
import '../styles/global.css';
import { resolveLangPair } from '../i18n/lang';
import AutoRedirect from '../i18n/auto-redirect.astro';

interface Props {
  title: string;
  description: string;
  theme?: 'day' | 'night';
  path?: string;
  lang?: 'zh' | 'en';
  enPath?: string;
  keywords?: string;
  jsonLdExtra?: object | object[];
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description,
  theme = 'day',
  path = '/',
  lang = 'zh',
  enPath,
  keywords,
  jsonLdExtra,
  ogImage: ogImageProp,
  noindex = false,
} = Astro.props;

const SITE = 'https://unixwin.dev';
const fullTitle = title.includes('UNIXWIN') ? title : `${title} · UNIXWIN`;
const canonical = new URL(path, SITE).href;
const ogImage = ogImageProp ? (ogImageProp.startsWith('http') ? ogImageProp : `${SITE}${ogImageProp}`) : `${SITE}/og-image.png`;
// 多个结构化对象包成 @graph（Google 推荐的多节点容器的等价物）
const jsonLdExtraGraph =
  Array.isArray(jsonLdExtra) && jsonLdExtra.length > 1
    ? { '@context': 'https://schema.org', '@graph': jsonLdExtra }
    : Array.isArray(jsonLdExtra)
      ? jsonLdExtra[0]
      : jsonLdExtra;

// ---- i18n 配对：zh-CN/en/x-default 三条 hreflang + 是否自动跳转 ----
const pair = resolveLangPair(path, lang, enPath);
const zhUrl = new URL(pair.zhPath, SITE).href;
const enUrl = pair.enPath ? new URL(pair.enPath, SITE).href : canonical;
const htmlLang = pair.lang === 'en' ? 'en' : 'zh-CN';
const ogLocale = pair.lang === 'en' ? 'en_US' : 'zh_CN';
// AutoRedirect 仅「zh 页且存在 en 页」时于 <head> 内条件渲染
const needsAutoRedirect = pair.lang === 'zh' && Boolean(pair.enPath) && !noindex;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'UNIXWIN',
  url: SITE,
  logo: `${SITE}/favicon.svg`,
  description: 'AI-native bash family — real bash syntax, real Unix commands, native Windows/Linux/macOS.',
  sameAs: ['https://github.com/unixwin'],
};
---

<!doctype html>
<html lang={htmlLang} data-theme={theme}>
  <head>
    {/* 防 FOUC：改编自 astrowind ApplyColorMode.astro（MIT, © 2023 onWidget，见 THIRD_PARTY_NOTICES.md）。
        必须 is:inline 且置于 head 首位——首绘前把 day/night 页的 data-theme 纠正为
        用户选择（localStorage 优先，其次 prefers-color-scheme）。静态站无客户端路由，
        无需 after-swap 监听。 */}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var pageTheme = root.getAttribute('data-theme');
        if (pageTheme !== 'day' && pageTheme !== 'night') return;
        var saved = null;
        try {
          saved = localStorage.getItem('unixwin-theme');
        } catch (e) {
          /* 隐私模式等 localStorage 不可用：回落系统偏好 */
        }
        var theme =
          saved === 'day' || saved === 'night'
            ? saved
            : window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'night'
              : 'day';
        if (theme !== pageTheme) root.setAttribute('data-theme', theme);
      })();
    </script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    <meta name="generator" content={Astro.generator} />
    {/* Bing Webmaster 验证（issue #9；站点级公开验证串，非机密） */}
    <meta name="msvalidate.01" content="EE5280E1E3008B57B4EE4FF45EC7AA0F" />
    {/* Cloudflare Web Analytics 手动 snippet（issue #21：自动注入被缓存规则干扰，
        手动安装最稳；免 cookie，/privacy/ 页已披露） */}
    <script
      type="module"
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "95e665bd60104278a91f0575552fab85"}'
    ></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {/* Preload 主展示字体（Fraunces latin wght，67KB）：global.css 的 @font-face
        带 font-display: swap，浏览器要等 CSS 解析完才会发起字体请求——preload
        让字体请求与 CSS 并行，消除 swap 前的衬线回落闪烁（FOUT）。
        crossorigin 必须带（字体即使同源也走 CORS 模式，缺了会二次下载）。
        Astro 会把 tokens.css/global.css 打包后的 <link rel=stylesheet> 注入在
        显式 head 内容之后，因此本行天然位于样式表 link 之前。 */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href="/fonts/fraunces-latin-wght-normal.woff2"
    />
    {noindex ? (
      <meta name="robots" content="noindex" />
    ) : (
      <>
        <link rel="canonical" href={canonical} />

        <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={zhUrl} />
      </>
    )}

    {needsAutoRedirect && pair.enPath && <AutoRedirect enPath={pair.enPath} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="UNIXWIN" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={ogLocale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {jsonLdExtraGraph && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLdExtraGraph)} />
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
